<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-f" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="WorkOrderSystem.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    
    <HeadOutlet/>
</head>
<body>
    @* ✨ 4. 讓 Routes (你的頁面) 變為互動式 ✨ *@
    <Routes/> @* --- 你所有的 Script 標籤 (保持不變) --- *@
    <script src="https://unpkg.com/@@panzoom/panzoom@4.5.1/dist/panzoom.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.0/fabric.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.0.0/dist/signature_pad.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
    <script src="/js/ChartJsBlazorInterop.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
    <script src="_framework/blazor.server.js" autostart="false"></script>

    <script>
        Blazor.start({
            reconnectionOptions: {
                // 設定重連次數為極大值 (例如 10 萬次)
                // 若每 2 秒重連一次，100,000 次大約可以持續重連 2 天以上
                maxRetries: 100000,
                // 每次重連的間隔時間 (毫秒)
                retryIntervalMilliseconds: 2000,
            }
        }).then(() => {
            // 覆寫重連失敗的最終處理器
            Blazor.defaultReconnectionHandler._reconnectionFailed = function () {
                // 萬一真的超過 12 小時導致伺服器已經把資料清了，不要卡在灰底白字畫面
                // 直接強制重新整理頁面，讓使用者重新載入最新狀態
                window.location.reload();
            };
        });
    </script>

    <script src="js/kanban.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document.body.classList.add("blazor-hydrated");
        });
    </script>

</body>
</html>