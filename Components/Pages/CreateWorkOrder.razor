        public string Phone { get; set; } = "";
    }
    private List<ContactHistoryItem> historyContactItems = new();

    private bool isReadingContactInfo = false;
    private string? contactInfoMessage = null;

    private bool isLoadingData = true;
    private bool showRevokeModal = false;
    private string revokeReason = "";
    private string? revokeError;
    private bool isRevoking = false;

    private class PreviewPhoto
