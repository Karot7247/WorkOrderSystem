@page "/workorders/create"
@page "/workorders/edit/{WorkOrderId:int}"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using WorkOrderSystem.Data
@using WorkOrderSystem.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Web
@using WorkOrderSystem.Components.Shared
@using WorkOrderSystem.Services
@using System.Net
@using System.Net.Http.Json
@using System.IO

@attribute [Authorize]

@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider _authenticationStateProvider
@inject NavigationManager _navigationManager
@inject IWebHostEnvironment _webHostEnvironment
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject IQuotationFileService QuotationFileSvc
@inject ILogger<CreateWorkOrder> _logger
@inject HttpClient Http

<PageTitle>@(WorkOrderId == 0 ? "新增派工申請" : "編輯派工申請")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(WorkOrderId == 0 ? "新增派工申請" : "編輯派工申請")</h3>
    @if (WorkOrderId > 0)
    {
        <button type="button" class="btn btn-outline-danger" @onclick="() => showRevokeModal = true">
            <i class="bi bi-x-circle"></i> 撤銷工單
        </button>
    }
</div>

<p>請詳細填寫您需要協助的事項。</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (isLoadingData)
{
    <p><em>正在載入資料...</em></p>
}
else
{
    @if (WorkOrderId == 0)
    {
        <div class="card border-info mb-4 shadow-sm bg-light">
            <div class="card-header bg-info bg-opacity-25 text-dark fw-bold">
                <i class="bi bi-magic text-primary"></i> 透過報價單快速建立工單
            </div>
            <div class="card-body py-3">
                <div class="row g-2">
                    <div class="col-md-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white">年度</span>
                            <select class="form-select" value="@importYear" @onchange="OnImportYearChangedAsync" disabled="@isLoadingImportQuotations">
                                @foreach (var y in quotationYearOptions)
                                {
                                    <option value="@y">@y (@(y - 1911))</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-funnel"></i></span>
                            <input type="text" class="form-control" placeholder="過濾報價單 (輸入客戶/案名)"
                                   @bind="importKeyword" @bind:event="oninput" @onkeyup="FilterImportQuotations" disabled="@isLoadingImportQuotations" />
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="input-group input-group-sm">
                            <select class="form-select" @bind="selectedImportQuotation" disabled="@isLoadingImportQuotations">
                                @if (isLoadingImportQuotations)
                                {
                                    <option value="">載入中...</option>
                                }
                                else
                                {
                                    <option value="">-- 請選擇報價單 --</option>
                                    @if (filteredImportQuotations != null)
                                    {
                                        foreach (var q in filteredImportQuotations)
                                        {
                                            <option value="@q.Value">@q.DisplayText</option>
                                        }
                                    }
                                }
                            </select>
                            <button class="btn btn-primary" type="button" @onclick="ApplyImportDataAsync" disabled="@(string.IsNullOrEmpty(selectedImportQuotation) || isImportingData)">
                                @if (isImportingData)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <span>匯入資料</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>

                @if (isLoadingImportQuotations)
                {
                    <div class="text-secondary small mt-2"><span class="spinner-border spinner-border-sm me-1"></span> 正在從伺服器讀取本年度報價單...</div>
                }
                @if (!string.IsNullOrEmpty(importMessage))
                {
                    <div class="text-success fw-bold small mt-2"><i class="bi bi-check-circle"></i> @importMessage</div>
                }
            </div>
        </div>
    }

    <EditForm Model="workOrder" OnValidSubmit="HandleSubmit" FormName="@(WorkOrderId == 0 ? "CreateWorkOrder" : "EditWorkOrder")">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="title" class="form-label">標題 (將作為照片資料夾名稱)</label>
            <InputText id="title" class="form-control" @bind-Value="workOrder.Title" />
            <ValidationMessage For="@(() => workOrder.Title)" />
        </div>

        <div class="mb-3">
            <label for="customerName" class="form-label">客戶名稱 (將作為照片資料夾名稱)</label>
            <InputText id="customerName" class="form-control" @bind-Value="workOrder.CustomerName" @onblur="LoadQuotationOptionsAsync" />
            <ValidationMessage For="@(() => workOrder.CustomerName)" />
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label for="source" class="form-label">客源分類 (可選)</label>
                <InputSelect id="source" class="form-select" @bind-Value="workOrder.Source">
                    <option value="">-- 請選擇 --</option>
                    <option value="原有客戶">原有客戶</option>
                    <option value="網站">網站</option>
                    <option value="客戶介紹">客戶介紹</option>
                </InputSelect>
            </div>
            <div class="col-md-6">
                <label for="address" class="form-label">地址 (可選)</label>
                <div class="input-group">
                    <InputText id="address" class="form-control" @bind-Value="workOrder.Address" />
                    @if (!string.IsNullOrEmpty(workOrder.Address))
                    {
                        <a class="btn btn-outline-secondary" href="https://www.google.com/maps/search/?api=1&query={WebUtility.UrlEncode(workOrder.Address)}" target="_blank" title="在 Google 地圖上開啟">
                            <i class="bi bi-geo-alt-fill"></i>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label for="woContactNameInput" class="form-label">聯絡人 (可選)</label>
                <InputText id="woContactNameInput"
                           class="form-control"
                           name="ignore_autofill_name"
                           Value="@workOrder.ContactPerson"
                           ValueChanged="@((string s) => OnContactPersonChanged(s))"
                           ValueExpression="@(() => workOrder.ContactPerson)"
                           list="contactPersonList"
                           autocomplete="nope"
                           placeholder="輸入或選擇歷史聯絡人" />

                <datalist id="contactPersonList">
                    @foreach (var item in historyContactItems)
                    {
                        <option value="@item.Name">歷史資料 | 電話: @item.Phone</option>
                    }
                </datalist>
            </div>
            <div class="col-md-6">
                <label for="woContactPhoneInput" class="form-label">聯絡電話 (可選)</label>
                <InputText id="woContactPhoneInput"
                           class="form-control"
                           name="ignore_autofill_phone"
                           @bind-Value="workOrder.ContactPhone"
                           autocomplete="nope" />
            </div>
        </div>

        <div class="mb-3">
            <label for="workOrderType" class="form-label">案件類型</label>
            <InputSelect id="workOrderType" class="form-select" @bind-Value="workOrder.WorkOrderType">
                <option value="">-- 請選擇 --</option>
                <option value="維修">維修</option>
                <option value="施工">施工</option>
                <option value="報價">請求報價</option>
            </InputSelect>
            <ValidationMessage For="@(() => workOrder.WorkOrderType)" />
        </div>

        @* --- 關聯報價單區塊 --- *@
        <div class="mb-3">
            <label class="form-label">關聯報價單 (可選)</label>
            <div class="row">
                <div class="col-md-6 mb-2 mb-md-0">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="filterCustomerCheck"
                                   checked="@filterQuotationsByCustomer"
                                   @onchange="OnFilterCustomerChangedAsync"
                                   disabled="@isLoadingQuotations" />
                            <label class="form-check-label" for="filterCustomerCheck">
                                僅顯示客戶 '@(workOrder.CustomerName ?? "...")'
                            </label>
                        </div>

                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text bg-white border-end-0">年度</span>
                            <select class="form-select border-start-0" value="@selectedQuotationYear" @onchange="OnQuotationYearChanged" disabled="@isLoadingQuotations">
                                @foreach (var y in quotationYearOptions)
                                {
                                    <option value="@y">@y (@(y - 1911))</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (string.IsNullOrWhiteSpace(workOrder.CustomerName) && filterQuotationsByCustomer)
                    {
                        <small class="text-warning d-block mb-2">(請先填寫客戶名稱)</small>
                    }
                </div>
                <div class="col-md-6">
                    <div class="input-group">
                        <InputSelect id="quotationSelect" class="form-select"
                                     Value="@workOrder.RelatedQuotationFileName"
                                     ValueChanged="@((string s) => OnQuotationSelectedAsync(s))"
                                     ValueExpression="@(() => workOrder.RelatedQuotationFileName)"
                                     disabled="@(isLoadingQuotations)">
                            <option value="">-- 無 --</option>
                            @if (isLoadingQuotations)
                            {
                                <option disabled>讀取中...</option>
                            }
                            else if (availableQuotations != null)
                            {
                                @foreach (var quote in availableQuotations)
                                {
                                    <option value="@quote.Value">@quote.DisplayText</option>
                                }
                            }
                        </InputSelect>

                        <button class="btn btn-outline-secondary" type="button"
                                @onclick="PreviewSelectedQuotationAsync"
                                disabled="@(isLoadingQuotations || isPreviewingQuotation || string.IsNullOrWhiteSpace(workOrder.RelatedQuotationFileName))"
                                title="預覽目前選中的報價單 (PDF)">
                            @if (isPreviewingQuotation)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="bi bi-eye"></i>
                            }
                        </button>
                    </div>

                    @if (isReadingContactInfo)
                    {
                        <div class="text-info small mt-1 ms-1">
                            <span class="spinner-border spinner-border-sm"></span> 正在從報價單讀取聯絡資訊...
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(contactInfoMessage))
                    {
                        <div class="text-success small mt-1 ms-1">
                            <i class="bi bi-magic"></i> @contactInfoMessage
                        </div>
                    }

                    @if (isLoadingQuotations)
                    {
                        <div class="spinner-border spinner-border-sm text-secondary ms-2"></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(quotationLoadError))
                    {
                        <div class="text-danger mt-1"><small>@quotationLoadError</small></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(previewError))
                    {
                        <small class="text-danger mt-1">@previewError</small>
                    }
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">
                詳細說明 <span class="text-danger fw-bold ms-1">*必填</span>
            </label>
            <InputTextArea id="description" class="form-control" @bind-Value="workOrder.Description" rows="5" placeholder="請填寫詳細說明或匯入工程名稱..." />
            <ValidationMessage For="@(() => workOrder.Description)" />
        </div>

        @* 附件區塊 *@
        <div class="mb-3 border p-3 rounded bg-light">
            <label class="form-label fw-bold"><i class="bi bi-paperclip"></i> 上傳附件 (支援照片、PDF、Word等一般檔案)</label>
            <div>
                <InputFile OnChange="HandleFileSelected" capture="environment" class="d-none" id="cameraInput" accept="image/*" disabled="@isProcessingPhotos" />
                <InputFile OnChange="HandleFileSelected" multiple class="d-none" id="galleryInput" disabled="@isProcessingPhotos" />

                <button type="button" class="btn btn-secondary me-2" onclick="document.getElementById('cameraInput').click()" disabled="@isProcessingPhotos">
                    <i class="bi bi-camera-fill"></i> 拍照
                </button>
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('galleryInput').click()" disabled="@isProcessingPhotos">
                    <i class="bi bi-folder-plus"></i> 選擇檔案
                </button>

                @if (isProcessingPhotos)
                {
                    <div class="d-inline-block ms-2" style="vertical-align: middle;">
                        <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                        <span class="text-muted ms-1">檔案處理中... (@filesProcessed / @totalFilesToProcess)</span>
                    </div>
                }
            </div>

            @if (previewPhotos.Any())
            {
                <div class="mt-3 d-flex flex-wrap" style="gap: 15px;">
                    @foreach (var photo in previewPhotos)
                    {
                        <div class="position-relative border rounded shadow-sm bg-white" style="width: 140px; height: 140px;">
                            @if (photo.IsImage)
                            {
                                <img src="@photo.Base64Data" class="img-thumbnail w-100 h-100 border-0" style="object-fit: cover; border-radius: 6px;" />
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 px-2 text-center text-secondary">
                                    <i class="bi bi-file-earmark-text-fill" style="font-size: 3rem;"></i>
                                    <span class="small text-truncate w-100 mt-2" title="@photo.FileName">@photo.FileName</span>
                                </div>
                            }
                            <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 rounded-circle"
                                    aria-label="移除附件" @onclick="() => RemovePhoto(photo.Id)">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        @* ✨ 核心修改：所有人都能看到指派區塊，但一般人只能指派給自己 ✨ *@
        <hr />
        <h4>@(isManager || isSupervisor ? "直接指派" : "指派給自己")</h4>
        <div class="mb-3 border p-3 rounded">
            <div style="max-height: 250px; overflow-y: auto;">
                <p class="form-label fw-bold">@(isManager || isSupervisor ? "選擇工程師 (可複選)" : "是否由您親自處理此工單？")</p>
                <InputRadioGroup @bind-Value="primaryEngineerId">
                    @foreach (var engineer in engineers)
                    {
                        var isSelected = selectedEngineers.GetValueOrDefault(engineer.Id);
                        <div class="d-flex align-items-center mb-2">
                            <div class="form-check flex-grow-1">
                                <input type="checkbox" class="form-check-input" id="@($"assign-{engineer.Id}")"
                                       checked="@isSelected"
                                       @onchange="@((ChangeEventArgs __e) => { 
                                           bool isChecked = (bool)(__e.Value ?? false);
                                           selectedEngineers[engineer.Id] = isChecked; 
                                           // 若只有一位工程師被勾選，自動將其設為主要負責人
                                           if (isChecked && engineers.Count == 1) { primaryEngineerId = engineer.Id; }
                                           if (!isChecked && primaryEngineerId == engineer.Id) { primaryEngineerId = null; }
                                           StateHasChanged(); 
                                       })" />
                                <label for="@($"assign-{engineer.Id}")" class="form-check-label">
                                    @engineer.FullName @(engineer.Id == currentUser?.Id && engineers.Count > 1 ? "(自己)" : "")
                                </label>
                            </div>
                            
                            @* 只有當選單裡有超過1位工程師時，才需要顯示「設為主要」的單選框 *@
                            <div class="form-check ms-3" style="@(engineers.Count == 1 ? "display:none;" : "")">
                                <InputRadio id="@($"primary-{engineer.Id}")" Value="@engineer.Id" class="form-check-input" disabled="@(!isSelected)" />
                                <label for="@($"primary-{engineer.Id}")" class="form-check-label"><small>設為主要</small></label>
                            </div>
                        </div>
                    }
                </InputRadioGroup>
            </div>
            
            @* 給一般使用者的提示 *@
            @if (!isManager && !isSupervisor)
            {
                <small class="text-muted mt-2 d-block"><i class="bi bi-info-circle"></i> 一般權限僅能將工單指派給自己。如需分派給其他工程師，請由管理者或主管操作。</small>
            }
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary flex-grow-1" disabled="@isProcessingPhotos">
                @(WorkOrderId == 0 ? "提交申請" : "儲存變更")
            </button>
        </div>
    </EditForm>
}

<PdfPreviewModal IsVisible="isPdfModalVisible"
                 Base64Data="@pdfPreviewBase64Data"
                 FileName="@pdfPreviewFileName"
                 OnClose="() => isPdfModalVisible = false" />

@if (showRevokeModal)
{
    <div class="modal fade show" tabindex="-1" role="dialog" style="display: block; background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill"></i> 撤銷工單確認</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showRevokeModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="fw-bold">您確定要撤銷此工單嗎？</p>
                    <p class="text-muted small">撤銷後工單狀態將變更為「已取消」，此操作無法復原。</p>

                    <div class="mb-3">
                        <label class="form-label fw-bold required">撤銷原因 (必填)：</label>
                        <textarea class="form-control" @bind="revokeReason" rows="3" placeholder="請輸入撤銷原因..."></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(revokeError))
                    {
                        <div class="alert alert-danger py-2">@revokeError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => showRevokeModal = false">取消</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmRevokeAsync" disabled="@isRevoking">
                        @if (isRevoking)
                        {
                             <span class="spinner-border spinner-border-sm"></span> <span> 處理中...</span>
                        }
                        else
                        {
                            <span>確認撤銷</span>
                        }
                    </button>
                </div>
             </div>
        </div>
    </div>
}


@code {
    [Parameter]
    public int WorkOrderId { get; set; }

    private WorkOrder workOrder = new() { Source = "原有客戶", WorkOrderType = "維修" };
    private string? errorMessage;
    private bool isManager = false;
    private bool isSupervisor = false;
    private List<AppUser> engineers = new();
    private Dictionary<string, bool> selectedEngineers = new();
    private string? primaryEngineerId;
    private AppUser? currentUser;

    private List<PreviewPhoto> previewPhotos = new();
    private bool isProcessingPhotos = false;
    private int totalFilesToProcess = 0;
    private int filesProcessed = 0;
    private const int MaxAllowedFiles = 100;

    private int importYear = DateTime.Now.Year;
    private string importKeyword = "";
    private string? selectedImportQuotation;
    private List<QuotationSelectItem>? allImportQuotationsForYear; 
    private List<QuotationSelectItem>? filteredImportQuotations;
    private bool isLoadingImportQuotations = false;
    private bool isImportingData = false;
    private string? importMessage = null;

    private async Task OnImportYearChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int y))
        {
            importYear = y;
            await LoadImportQuotationsAsync();
        }
    }

    private async Task LoadImportQuotationsAsync()
    {
        isLoadingImportQuotations = true;
        importMessage = null;
        selectedImportQuotation = "";
        StateHasChanged();

        await Task.Yield(); 

        try
        {
            int? targetRocYear = importYear - 1911;
            allImportQuotationsForYear = await QuotationFileSvc.ListQuotationsAsync(filterByCustomer: false, customerName: null, year: targetRocYear);
            FilterImportQuotations(); 
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "載入年度報價單失敗");
        }
        finally
        {
            isLoadingImportQuotations = false;
            StateHasChanged();
        }
    }

    private void FilterImportQuotations()
    {
        if (allImportQuotationsForYear == null)
        {
            filteredImportQuotations = new List<QuotationSelectItem>();
            return;
        }

        if (string.IsNullOrWhiteSpace(importKeyword))
        {
            filteredImportQuotations = allImportQuotationsForYear;
        }
        else
        {
            var kw = importKeyword.Trim();
            filteredImportQuotations = allImportQuotationsForYear
                .Where(q => q.DisplayText.Contains(kw, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        if (!string.IsNullOrEmpty(selectedImportQuotation) && !filteredImportQuotations.Any(q => q.Value == selectedImportQuotation))
        {
            selectedImportQuotation = "";
        }
    }

    private async Task ApplyImportDataAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedImportQuotation)) return;
        isImportingData = true;
        importMessage = null;
        StateHasChanged();

        try
        {
            var info = await QuotationFileSvc.GetContactInfoFromExcelAsync(selectedImportQuotation);
            if (!string.IsNullOrWhiteSpace(info.CustomerName)) workOrder.CustomerName = info.CustomerName;
            if (!string.IsNullOrWhiteSpace(info.ContactPerson)) workOrder.ContactPerson = info.ContactPerson;
            if (!string.IsNullOrWhiteSpace(info.ContactPhone)) workOrder.ContactPhone = info.ContactPhone;
            
            var fileNameWithoutExt = Path.GetFileNameWithoutExtension(selectedImportQuotation);
            string projectName = fileNameWithoutExt; 

            var parts = fileNameWithoutExt.Split(new[] { '-', '_' }, 3, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 3)
            {
                projectName = parts[2].Trim();
            }
            else if (parts.Length == 2)
            {
                projectName = parts[1].Trim();
            }

            if (string.IsNullOrWhiteSpace(workOrder.Title))
            {
                workOrder.Title = projectName;
            }

            if (string.IsNullOrWhiteSpace(workOrder.Description))
            {
                workOrder.Description = projectName;
            }
            else if (!workOrder.Description.Contains(projectName))
            {
                workOrder.Description = projectName + "\n\n" + workOrder.Description;
            }

            workOrder.RelatedQuotationFileName = selectedImportQuotation;
            selectedQuotationYear = importYear; 

            importMessage = "資料匯入成功！請確認下方欄位。";
            await LoadQuotationOptionsAsync();
        }
        catch (Exception ex)
        {
            importMessage = $"匯入失敗: {ex.Message}";
        }
        finally
        {
            isImportingData = false;
            StateHasChanged();
        }
    }

    private List<QuotationSelectItem>? availableQuotations;
    private bool filterQuotationsByCustomer = true;
    private bool isLoadingQuotations = false;
    private string? quotationLoadError = null;
    private bool isPreviewingQuotation = false;
    private string? previewError = null;
    private bool isPdfModalVisible = false;
    private string? pdfPreviewBase64Data = null;
    private string? pdfPreviewFileName = null;

    private int selectedQuotationYear;
    private List<int> quotationYearOptions = new();
    private class ContactHistoryItem
    {
