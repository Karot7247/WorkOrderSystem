    private async Task ShowPdfPreviewModalAsync(string? fileNameWithoutExtension)
    {
        if (string.IsNullOrWhiteSpace(fileNameWithoutExtension))
        {
            previewError = "請先選擇一個報價單。";
            return;
        }

        isPreviewingQuotation = true;
        previewError = null;
        pdfPreviewBase64Data = null;
        pdfPreviewFileName = null;
        StateHasChanged();

        try
        {
            string encodedFileName = HttpUtility.UrlEncode(fileNameWithoutExtension);
            string relativeUrl = $"/api/download/preview/quotation.pdf?fileName={encodedFileName}";
            string absoluteApiUrl = _navigationManager.ToAbsoluteUri(relativeUrl).ToString();

            _logger.LogInformation("準備呼叫 API 獲取 PDF Base64: {Url}", absoluteApiUrl);

            var response = await Http.GetAsync(absoluteApiUrl);
            if (response.IsSuccessStatusCode)
            {
                var pdfResponse = await response.Content.ReadFromJsonAsync<PdfPreviewResponse?>();
                if (pdfResponse != null && !string.IsNullOrEmpty(pdfResponse.Base64Data))
                {
                    _logger.LogInformation("成功獲取 Base64 資料 for {FileName}", pdfResponse.FileName);
                    pdfPreviewBase64Data = pdfResponse.Base64Data;
                    pdfPreviewFileName = pdfResponse.FileName;
                    isPdfModalVisible = true;
                }
                else
                {
                    previewError = pdfResponse?.ErrorMessage ?? "API 返回成功但資料為空。";
                    _logger.LogWarning("API 返回 200 OK 但 JSON 資料為空或無效: {Error}", previewError);
                }
            }
            else
            {
                PdfPreviewResponse? errorResponse = null;
                try { errorResponse = await response.Content.ReadFromJsonAsync<PdfPreviewResponse?>(); }
                catch (Exception jsonEx) { _logger.LogError(jsonEx, "無法解析失敗回應的 JSON Body。"); }
                previewError = errorResponse?.ErrorMessage ?? $"API 請求失敗，狀態碼: {response.StatusCode}";
                _logger.LogWarning("API 請求失敗: {StatusCode}, 訊息: {Error}", response.StatusCode, previewError);
            }
        }
        catch (HttpRequestException httpEx)
        {
            _logger.LogError(httpEx, "ShowPdfPreviewModalAsync: 呼叫 API 時發生 HttpRequestException for {FileName}", fileNameWithoutExtension);
            previewError = $"網路請求錯誤: {httpEx.Message}";
        }
        catch (Exception ex)
        {
            previewError = $"準備預覽時發生未預期錯誤: {ex.Message}";
            _logger.LogError(ex, "ShowPdfPreviewModalAsync error for {FileName}", fileNameWithoutExtension);
        }
        finally
        {
            isPreviewingQuotation = false;
            StateHasChanged();
        }
    }

    public class PdfPreviewResponse
    {
        public string? Base64Data { get; set; }
        public string? FileName { get; set; }
        public string? ErrorMessage { get; set; }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        IReadOnlyList<IBrowserFile> selectedFiles;

        if (e.FileCount > MaxAllowedFiles)
        {
            errorMessage = $"您一次最多只能選取 {MaxAllowedFiles} 個檔案。系統將只處理前 {MaxAllowedFiles} 個。";
            selectedFiles = e.GetMultipleFiles(MaxAllowedFiles);
        }
        else
        {
            selectedFiles = e.GetMultipleFiles(MaxAllowedFiles);
        }

        isProcessingPhotos = true;
        totalFilesToProcess = selectedFiles.Count;
        filesProcessed = 0;
        await InvokeAsync(StateHasChanged);

        foreach (var file in selectedFiles)
        {
            try
            {
                // ✨ 圖片/文件雙軌處理邏輯 ✨
                bool isImage = file.ContentType.StartsWith("image/") && file.ContentType != "image/svg+xml";
                byte[] buffer;
                string base64;

                if (isImage)
                {
                    // 👉 圖片：進行壓縮
                    var resizedImageFile = await file.RequestImageFileAsync("image/jpeg", 1280, 1280);
                    using var ms = new MemoryStream();
                    await resizedImageFile.OpenReadStream(15 * 1024 * 1024).CopyToAsync(ms);
                    buffer = ms.ToArray();
                    base64 = $"data:image/jpeg;base64,{Convert.ToBase64String(buffer)}";
                }
                else
                {
                    // 👉 文件：不壓縮，允許最大 20MB
                    using var ms = new MemoryStream();
                    await file.OpenReadStream(20 * 1024 * 1024).CopyToAsync(ms); 
                    buffer = ms.ToArray();
                    base64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
                }

                previewPhotos.Add(new PreviewPhoto 
                { 
                    FileName = file.Name, 
                    Base64Data = base64,
                    IsImage = isImage,
                    ContentType = file.ContentType
                });
            }
            catch (Exception ex)
            {
                errorMessage = $"處理 '{file.Name}' 錯誤: {ex.Message}";
                _logger.LogError(ex, "處理檔案 '{FileName}' 時發生錯誤", file.Name);
            }
            finally
            {
                filesProcessed++;
                await InvokeAsync(StateHasChanged);
            }
        }
        isProcessingPhotos = false;
    }

    private void RemovePhoto(string photoId) { var photoToRemove = previewPhotos.FirstOrDefault(p => p.Id == photoId);
        if (photoToRemove != null) { previewPhotos.Remove(photoToRemove); } }
    private string SanitizeFolderName(string name) { if (string.IsNullOrWhiteSpace(name)) return "Uncategorized";
        string invalidChars = new string(Path.GetInvalidFileNameChars()) + new string(Path.GetInvalidPathChars()); foreach (char c in invalidChars) { name = name.Replace(c, '_');
        } return name.Trim(); }

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(workOrder.Description))
        {
            errorMessage = "「詳細說明」為必填欄位，請確實填寫。";
            await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
            return;
        }

        var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId) || currentUser == null)
        {
            errorMessage = "錯誤：無法驗證您的使用者身份。";
            return;
        }

        bool isNewWorkOrder = (WorkOrderId == 0);
        string redirectUrl = "/myrequests";
        using (var scope = ScopeFactory.CreateScope())
        {
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var lineNotifyService = scope.ServiceProvider.GetRequiredService<LineNotifyService>();

            try
            {
                WorkOrder entityToSave;
                bool assignmentChanged = false;
                bool contentChanged = false;
                List<AppUser> engineersToNotifyOnChange = new List<AppUser>();
                List<AppUser> engineersToNotifyOnAssign = new List<AppUser>();
                
                if (isNewWorkOrder)
                {
                    entityToSave = workOrder;
                    entityToSave.RequesterId = userId;
                    entityToSave.CreatedAt = DateTime.Now;
                    context.WorkOrders.Add(entityToSave);
                    contentChanged = true;
                }
                else 
                {
                    entityToSave = await context.WorkOrders
                      .Include(wo => wo.Assignments)
                      .FirstOrDefaultAsync(wo => wo.Id == WorkOrderId);

                    if (entityToSave == null) { errorMessage = "找不到要更新的工單"; return; }

                    contentChanged = entityToSave.Title != workOrder.Title ||
                  entityToSave.CustomerName != workOrder.CustomerName ||
                  entityToSave.Description != workOrder.Description ||
                  entityToSave.Address != workOrder.Address ||
                  entityToSave.ContactPerson != workOrder.ContactPerson ||
                  entityToSave.ContactPhone != workOrder.ContactPhone ||
                  entityToSave.WorkOrderType != workOrder.WorkOrderType ||
                  entityToSave.Source != workOrder.Source ||
                  entityToSave.RelatedQuotationFileName != workOrder.RelatedQuotationFileName;
                    
                    entityToSave.Title = workOrder.Title;
                    entityToSave.CustomerName = workOrder.CustomerName;
                    entityToSave.ContactPerson = workOrder.ContactPerson;
                    entityToSave.ContactPhone = workOrder.ContactPhone;
                    entityToSave.WorkOrderType = workOrder.WorkOrderType;
                    entityToSave.Description = workOrder.Description;
                    entityToSave.Source = workOrder.Source;
                    entityToSave.Address = workOrder.Address;
                    entityToSave.RelatedQuotationFileName = workOrder.RelatedQuotationFileName;
                }

                entityToSave.UpdatedAt = DateTime.Now;
                
                // ✨ 解除所有權限的身分檢查，讓一般使用者的指派也能進入這段邏輯 ✨
                var selectedIds = selectedEngineers.Where(kv => kv.Value).Select(kv => kv.Key).ToList();
                
                if (selectedIds.Any())
                {
                    if (string.IsNullOrEmpty(primaryEngineerId)) 
                    { 
                        if (selectedIds.Count == 1) { primaryEngineerId = selectedIds.First(); }
                        else { errorMessage = "請指定主要負責人。"; StateHasChanged(); return; }
                    }
                    if (!selectedIds.Contains(primaryEngineerId)) 
                    { 
                        errorMessage = "主要負責人必須在已選工程師中。"; StateHasChanged(); return; 
                    }
                }

                if (!isNewWorkOrder)
                {
                    var existingAssignments = entityToSave.Assignments.ToList();
                    var existingAssignedIds = existingAssignments.Select(a => a.UserId).ToHashSet();
                    var newAssignedIds = selectedIds.ToHashSet();
                    assignmentChanged = !existingAssignedIds.SetEquals(newAssignedIds);
                    
                    if (!assignmentChanged) { 
                        var existingPrimaryId = existingAssignments.FirstOrDefault(a => a.IsPrimary)?.UserId; 
                        assignmentChanged = existingPrimaryId != primaryEngineerId; 
                    }

                    if (assignmentChanged)
                    {
                        var newEngineerIds = newAssignedIds.Where(id => !existingAssignedIds.Contains(id)).ToList();
                        engineersToNotifyOnAssign = await context.Users.Where(u => newEngineerIds.Contains(u.Id)).ToListAsync();
                        
                        if (contentChanged) { 
                            var allAffectedIds = existingAssignedIds.Union(newAssignedIds); 
                            engineersToNotifyOnChange = await context.Users.Where(u => allAffectedIds.Contains(u.Id)).ToListAsync(); 
                        }
                        
                        context.WorkOrderAssignees.RemoveRange(existingAssignments);
                        entityToSave.Assignments.Clear();
                        foreach (var engineerId in selectedIds) { 
                            entityToSave.Assignments.Add(new WorkOrderAssignee { UserId = engineerId, IsPrimary = (engineerId == primaryEngineerId) }); 
                        }
                    }
                    else if (contentChanged && entityToSave.Status == "處理中")
                    {
                        engineersToNotifyOnChange = await context.WorkOrderAssignees
                                       .Where(a => a.WorkOrderId == entityToSave.Id)
                                       .Select(a => a.User)
                                       .Where(u => u != null)
                                       .ToListAsync();
                    }
                }
                else
                {
                    assignmentChanged = selectedIds.Any();
                    foreach (var engineerId in selectedIds) { 
                        entityToSave.Assignments.Add(new WorkOrderAssignee { UserId = engineerId, IsPrimary = (engineerId == primaryEngineerId) }); 
                    }
                    if (assignmentChanged) { 
                        engineersToNotifyOnAssign = await context.Users.Where(u => selectedIds.Contains(u.Id)).ToListAsync(); 
                    }
                }

                if (assignmentChanged && selectedIds.Any() && entityToSave.Status != "處理中") { 
                    entityToSave.Status = "處理中"; 
                    entityToSave.AssignmentDate = DateTime.Now; 
                }
                else if (assignmentChanged && !selectedIds.Any() && entityToSave.Status == "處理中") { 
                    entityToSave.Status = "待指派"; 
                    entityToSave.AssignmentDate = null; 
                }

                if (isNewWorkOrder && !selectedIds.Any()) { entityToSave.Status = "待指派"; }

                if (isNewWorkOrder || contentChanged || assignmentChanged)
                {
                    var logAction = isNewWorkOrder ? "建立工單" : "編輯工單";
                    entityToSave.Logs.Add(new WorkOrderLog
                        {
                            OperatorId = userId,
                            Action = logAction,
                            Timestamp = DateTime.Now
                        });
                }

                await context.SaveChangesAsync();
                workOrder.Id = entityToSave.Id;

                if (previewPhotos.Any())
                {
                    var uploadsRoot = Configuration["FileStorageSettings:UploadsRootPath"];
                    if (string.IsNullOrEmpty(uploadsRoot))
                    {
                        _logger.LogError("FileStorageSettings:UploadsRootPath 未在 appsettings.json 中設定。");
                        errorMessage = "嚴重錯誤：檔案儲存路徑(NAS)設定遺失，無法上傳照片。";
                        return;
                    }

                    var customerFolderName = SanitizeFolderName(entityToSave.CustomerName);
                    var titleFolderName = SanitizeFolderName(entityToSave.Title);
                    var targetDirectory = Path.Combine(uploadsRoot, customerFolderName, titleFolderName, "申請附件");

                    Directory.CreateDirectory(targetDirectory);
                    foreach (var photo in previewPhotos)
                    {
                        try
                        {
                            // ✨ 保留原始副檔名，如果是非圖片的附件就不會被強迫變成 .jpg ✨
                            var ext = Path.GetExtension(photo.FileName);
                            if (string.IsNullOrEmpty(ext) && photo.IsImage) ext = ".jpg";
                            var uniqueFileName = $"{Guid.NewGuid()}{ext}";
                            var savePath = Path.Combine(targetDirectory, uniqueFileName);

                            byte[] photoBytes;
                            try
                            {
                                var base64Data = photo.Base64Data.Substring(photo.Base64Data.IndexOf(',') + 1);
                                photoBytes = Convert.FromBase64String(base64Data);
                            }
                            catch (Exception ex)
                            {
                                _logger.LogError(ex, "Base64 轉換失敗 for photo {FileName}", photo.FileName);
                                continue;
                            }

                            await File.WriteAllBytesAsync(savePath, photoBytes);
                            var dbPath = $"/uploads/{customerFolderName}/{titleFolderName}/申請附件/{uniqueFileName}".Replace('\\', '/');
                            context.WorkOrderPhotos.Add(new WorkOrderPhoto { WorkOrderId = workOrder.Id, FilePath = dbPath, Category = "申請附件" });
                        }
                        catch (Exception ex)
                        {
                            _logger.LogError(ex, "儲存檔案 '{FileName}' 至 NAS 失敗", photo.FileName);
                            errorMessage = $"派工單已儲存/更新，但上傳檔案 '{photo.FileName}' 失敗：{ex.Message}";
                        }
                    }
                    await context.SaveChangesAsync();
                    previewPhotos.Clear();
                }

                var baseUrl = Configuration["ApplicationSettings:BaseUrl"];
                var workOrderUrl = $"{baseUrl}/workorders/details/{entityToSave.Id}?openExternalBrowser=1";
                if (isNewWorkOrder && entityToSave.Status == "待指派") { try { var admins = await userManager.Users.Where(u => (u.IsManager || u.IsSupervisor) && !string.IsNullOrEmpty(u.LineUserId)).ToListAsync();
                if (admins.Any()) { var requesterName = currentUser?.FullName ?? "N/A"; var mapsUrl = !string.IsNullOrWhiteSpace(entityToSave.Address) ? $"https://www.google.com/maps/search/?api=1&query={System.Net.WebUtility.UrlEncode(entityToSave.Address)}" : "未提供";
                var message = $"【新派工申請通知】\n申請人：{requesterName}\n客戶：{entityToSave.CustomerName}\n標題：{entityToSave.Title}\n\n查看詳情與指派：\n{workOrderUrl}\n\n地址：{entityToSave.Address ?? "未提供"}\n地圖：{mapsUrl}"; foreach (var admin in admins) { _ = lineNotifyService.SendPushMessageAsync(admin.LineUserId, message);
                } } } catch (Exception ex) { _logger.LogError(ex, "發送 [新工單] 通知失敗");
                } }
                if (assignmentChanged && engineersToNotifyOnAssign.Any()) { try { foreach (var engineer in engineersToNotifyOnAssign) { if (engineer != null && !string.IsNullOrEmpty(engineer.LineUserId)) { var message = $"【新任務通知】\n您有一筆新的派工任務：\n『{entityToSave.Title}』\n\n查看詳情：\n{workOrderUrl}";
                _ = lineNotifyService.SendPushMessageAsync(engineer.LineUserId, message); } } } catch (Exception ex) { _logger.LogError(ex, "發送 [新任務] 通知失敗");
                } }
                if (contentChanged && !isNewWorkOrder && entityToSave.Status == "處理中" && engineersToNotifyOnChange.Any()) { try { foreach (var engineer in engineersToNotifyOnChange.Where(e => e.Id != currentUser.Id)) { if (engineer != null && !string.IsNullOrEmpty(engineer.LineUserId)) { var message = $"【工單內容更新通知】\n工單：『{entityToSave.Title}』\n內容已有更新，請點擊以下連結查看最新詳情：\n{workOrderUrl}";
                _ = lineNotifyService.SendPushMessageAsync(engineer.LineUserId, message); } } } catch (Exception ex) { _logger.LogError(ex, "發送 [工單更新] 通知失敗");
                } }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "儲存派工單時發生嚴重錯誤");
                errorMessage = $"儲存派工單時發生嚴重錯誤：{ex.Message}";
                if (ex.InnerException != null) { errorMessage += $" | InnerException: {ex.InnerException.Message}";
                }
                StateHasChanged();
                return;
            }

            if (isManager || (currentUser?.IsSupervisor ?? false)) { redirectUrl = "/manager/dashboard";
            }
            _navigationManager.NavigateTo(redirectUrl, forceLoad: true);
        }
    }
}