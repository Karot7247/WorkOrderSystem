    protected override async Task OnInitializedAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
        var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUser = await userManager.GetUserAsync(user);
        
        if (currentUser != null)
        {
            isManager = currentUser.IsManager;
            isSupervisor = currentUser.IsSupervisor;

            // ✨ 根據權限載入不同名單 ✨
            if (isManager || isSupervisor)
            {
                // 管理者或主管可以看到所有工程師
                engineers = await userManager.Users.Where(u => u.IsEngineer).OrderBy(u => u.FullName).ToListAsync();
            }
            else
            {
                // 一般使用者只能看到自己
                engineers = new List<AppUser> { currentUser };
            }
            selectedEngineers = engineers.ToDictionary(eng => eng.Id, eng => false);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoadingData = true;
        using var scope = ScopeFactory.CreateScope();
        var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

        if (WorkOrderId > 0) 
        {
            var dbWorkOrder = await context.WorkOrders
              .AsNoTracking()
              .Include(wo => wo.Assignments).ThenInclude(a => a.User) // 加入 User 關聯以便獲取已指派的工程師
              .FirstOrDefaultAsync(wo => wo.Id == WorkOrderId);
              
            if (dbWorkOrder == null) { _navigationManager.NavigateTo("/"); return; }

            // 若為一般使用者編輯已存在的工單，需將「原本就已經被指派」的工程師一併加入名單，避免編輯時將別人的指派洗掉
            if (!isManager && !isSupervisor)
            {
                foreach(var assignment in dbWorkOrder.Assignments)
                {
                    if (assignment.User != null && !engineers.Any(e => e.Id == assignment.UserId))
                    {
                        engineers.Add(assignment.User);
                        selectedEngineers[assignment.UserId] = false;
                    }
                }
            }

            workOrder = new WorkOrder
                {
                    Id = dbWorkOrder.Id,
                    Title = dbWorkOrder.Title,
                    CustomerName = dbWorkOrder.CustomerName,
                    Source = dbWorkOrder.Source,
                    Address = dbWorkOrder.Address,
                    ContactPerson = dbWorkOrder.ContactPerson,
                    ContactPhone = dbWorkOrder.ContactPhone,
                    WorkOrderType = dbWorkOrder.WorkOrderType,
                    Description = dbWorkOrder.Description,
                    RelatedQuotationFileName = dbWorkOrder.RelatedQuotationFileName,
                    RequesterId = dbWorkOrder.RequesterId,
                    CreatedAt = dbWorkOrder.CreatedAt,
                    Status = dbWorkOrder.Status,
                };

            // 載入目前已勾選的工程師狀態
            if (engineers.Any()) { selectedEngineers = engineers.ToDictionary(eng => eng.Id, eng => false); }
            foreach (var assignment in dbWorkOrder.Assignments) 
            { 
                if (selectedEngineers.ContainsKey(assignment.UserId)) 
                { 
                    selectedEngineers[assignment.UserId] = true;
                    if (assignment.IsPrimary) { primaryEngineerId = assignment.UserId; } 
                } 
            }
        }
        else 
        {
            workOrder = new WorkOrder() { Source = "原有客戶", WorkOrderType = "維修" };
            if (engineers.Any()) { selectedEngineers = engineers.ToDictionary(eng => eng.Id, eng => false); }
            primaryEngineerId = null;
            availableQuotations = new List<QuotationSelectItem>();
        }

        int currentY = DateTime.Now.Year;
        quotationYearOptions.Clear();
        for (int y = currentY + 1; y >= 2020; y--)
        {
            quotationYearOptions.Add(y);
        }

        if (WorkOrderId > 0)
        {
            selectedQuotationYear = workOrder.CreatedAt.Year;
        }
        else
        {
            selectedQuotationYear = currentY;
        }

        if (!quotationYearOptions.Contains(selectedQuotationYear))
        {
            quotationYearOptions.Add(selectedQuotationYear);
            quotationYearOptions = quotationYearOptions.OrderByDescending(x => x).ToList();
        }

        isLoadingData = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!string.IsNullOrWhiteSpace(workOrder.CustomerName))
            {
                _ = LoadQuotationOptionsAsync().ContinueWith(t => InvokeAsync(StateHasChanged));
            }

            if (WorkOrderId == 0)
            {
                _ = LoadImportQuotationsAsync().ContinueWith(t => InvokeAsync(StateHasChanged));
            }
        }
    }

    private async Task ConfirmRevokeAsync()
    {
        if (string.IsNullOrWhiteSpace(revokeReason))
        {
            revokeError = "請填寫撤銷原因。";
            return;
        }

        isRevoking = true;
        revokeError = null;
        StateHasChanged();
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var orderToUpdate = await context.WorkOrders.FindAsync(WorkOrderId);

            if (orderToUpdate != null)
            {
                orderToUpdate.Status = "已取消";
                orderToUpdate.UpdatedAt = DateTime.Now;

                context.WorkOrderLogs.Add(new WorkOrderLog
                    {
                        WorkOrderId = orderToUpdate.Id,
                        OperatorId = currentUser?.Id,
                        Action = "撤銷工單",
                        Comment = $"撤銷原因：{revokeReason}",
                        Timestamp = DateTime.Now
                    });
                await context.SaveChangesAsync();

                string redirectUrl = "/myrequests";
                if (isManager || (currentUser?.IsSupervisor ?? false)) { redirectUrl = "/manager/dashboard"; }
                _navigationManager.NavigateTo(redirectUrl, forceLoad: true);
            }
            else
            {
                revokeError = "找不到工單，無法撤銷。";
                isRevoking = false;
            }
        }
        catch (Exception ex)
        {
            revokeError = $"撤銷失敗：{ex.Message}";
            _logger.LogError(ex, "撤銷工單失敗");
            isRevoking = false;
        }
    }

    private async Task LoadQuotationOptionsAsync()
    {
        if (workOrder == null || (filterQuotationsByCustomer && string.IsNullOrWhiteSpace(workOrder.CustomerName)))
        {
            availableQuotations = new List<QuotationSelectItem>();
            historyContactItems.Clear();

            if (filterQuotationsByCustomer && string.IsNullOrWhiteSpace(workOrder.CustomerName) && WorkOrderId == 0)
            {
                quotationLoadError = "請填寫客戶名稱後點擊欄位外，即可載入報價單與歷史資料。";
            }
            else
            {
                quotationLoadError = null;
            }
            isLoadingQuotations = false;
            StateHasChanged();
            return;
        }

        isLoadingQuotations = true;
        quotationLoadError = null;
        availableQuotations = null;
        previewError = null;
        StateHasChanged();

        try
        {
            int? targetRocYear = selectedQuotationYear - 1911;

            availableQuotations = await QuotationFileSvc.ListQuotationsAsync(
                filterByCustomer: filterQuotationsByCustomer,
                customerName: filterQuotationsByCustomer ? workOrder.CustomerName : null,
                year: targetRocYear
            );
            using var scope = ScopeFactory.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var history = await context.WorkOrders
                .AsNoTracking()
                .Where(w => w.CustomerName == workOrder.CustomerName)
                .OrderByDescending(w => w.CreatedAt)
                .Select(w => new { w.ContactPerson, w.ContactPhone })
                .ToListAsync();

            if (history.Any())
            {
                historyContactItems = history
                    .Where(x => !string.IsNullOrWhiteSpace(x.ContactPerson))
                    .GroupBy(x => x.ContactPerson)
                    .Select(g => g.First())
                    .Select(x => new ContactHistoryItem { Name = x.ContactPerson, Phone = x.ContactPhone })
                    .ToList();
                if (string.IsNullOrWhiteSpace(workOrder.ContactPerson) || string.IsNullOrWhiteSpace(workOrder.ContactPhone))
                {
                    var latest = history.First();
                    if (string.IsNullOrWhiteSpace(workOrder.ContactPerson) && !string.IsNullOrWhiteSpace(latest.ContactPerson))
                    {
                        workOrder.ContactPerson = latest.ContactPerson;
                    }

                    if (string.IsNullOrWhiteSpace(workOrder.ContactPhone) && !string.IsNullOrWhiteSpace(latest.ContactPhone))
                    {
                        workOrder.ContactPhone = latest.ContactPhone;
                    }
                }
            }
        }
        catch (ApplicationException appEx) { quotationLoadError = $"讀取列表錯誤：{appEx.Message}"; _logger.LogError(appEx, "讀取列表 ApplicationException"); }
        catch (Exception ex) { quotationLoadError = $"讀取列表錯誤：{ex.Message}"; _logger.LogError(ex, "讀取列表 Exception"); }
        finally { isLoadingQuotations = false; StateHasChanged(); }
    }

    private async Task OnQuotationYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int y))
        {
            selectedQuotationYear = y;
            await LoadQuotationOptionsAsync();
        }
    }

    private async Task OnFilterCustomerChangedAsync(ChangeEventArgs e) { if (e.Value is bool value) { filterQuotationsByCustomer = value; await LoadQuotationOptionsAsync(); } }

    private void OnContactPersonChanged(string newValue)
    {
        workOrder.ContactPerson = newValue;
        var matchedHistory = historyContactItems.FirstOrDefault(x => x.Name == newValue);
        if (matchedHistory != null && !string.IsNullOrWhiteSpace(matchedHistory.Phone))
        {
            workOrder.ContactPhone = matchedHistory.Phone;
        }
    }

    private async Task OnQuotationSelectedAsync(string fileName)
    {
        workOrder.RelatedQuotationFileName = fileName;
        contactInfoMessage = null;

        if (string.IsNullOrWhiteSpace(fileName)) return;

        isReadingContactInfo = true;
        StateHasChanged();
        try
        {
            var info = await QuotationFileSvc.GetContactInfoFromExcelAsync(fileName);
            bool updated = false;
            var msgParts = new List<string>();

            if (!string.IsNullOrWhiteSpace(info.CustomerName))
            {
                workOrder.CustomerName = info.CustomerName;
                msgParts.Add($"客戶: {info.CustomerName}");
                updated = true;
            }

            if (!string.IsNullOrWhiteSpace(info.ContactPerson))
            {
                workOrder.ContactPerson = info.ContactPerson;
                msgParts.Add($"聯絡人: {info.ContactPerson}");
                updated = true;
            }

            if (!string.IsNullOrWhiteSpace(info.ContactPhone))
            {
                workOrder.ContactPhone = info.ContactPhone;
                msgParts.Add($"電話: {info.ContactPhone}");
                updated = true;
            }

            if (updated)
            {
                contactInfoMessage = "已從報價單自動帶入：" + string.Join(" / ", msgParts);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"讀取報價單資訊失敗: {ex.Message}");
        }
        finally
        {
            isReadingContactInfo = false;
            StateHasChanged();
        }
    }

