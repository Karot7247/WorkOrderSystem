@page "/drafts/manage"
@* 🔥 關鍵修正：加上這行，按鈕的 onclick 才會生效 *@
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using WorkOrderSystem.Data
@using WorkOrderSystem.Models
@using System.IO

@inject AuthenticationStateProvider _authenticationStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager _navigationManager
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration

@attribute [Authorize]

<PageTitle>我的暫存紀錄</PageTitle>

<div class="container mt-4 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="bi bi-archive-fill text-secondary"></i> 我的暫存紀錄</h3>
        <a href="/site-survey" class="btn btn-primary">
            <i class="bi bi-camera-fill me-1"></i> 新增拍照
        </a>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">載入資料中...</p>
        </div>
    }
    else if (drafts == null || !drafts.Any())
    {
        <div class="alert alert-secondary text-center p-5 rounded-3">
            <h4><i class="bi bi-inbox"></i> 目前沒有暫存紀錄</h4>
            <p class="text-muted">您在現場離線建立的資料會顯示在這裡。</p>
            <a href="/site-survey" class="btn btn-outline-primary mt-2">前往建立</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var draft in drafts)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 @(draft.ImportedWorkOrderId.HasValue ? "opacity-75" : "")">
                        @* 卡片標題 *@
                        <div class="card-header bg-white d-flex justify-content-between align-items-center border-bottom-0 pt-3">
                            <span class="badge @(draft.ImportedWorkOrderId.HasValue ? "bg-success" : "bg-warning text-dark")">
                                @(draft.ImportedWorkOrderId.HasValue ? "已歸檔" : "未歸檔")
                            </span>
                            <small class="text-muted">@draft.CreatedAt.ToString("MM/dd HH:mm")</small>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title text-truncate fw-bold mb-1" title="@draft.Title">
                                @(string.IsNullOrWhiteSpace(draft.Title) ? "(無標題)" : draft.Title)
                            </h5>

                            @* 備註文字預覽 *@
                            <p class="card-text text-muted small mb-3 text-truncate">
                                <i class="bi bi-chat-left-text me-1"></i>
                                @(string.IsNullOrWhiteSpace(draft.EngineerNotes) ? "無施工備註" : draft.EngineerNotes)
                            </p>

                            @* 🔥 照片縮圖預覽區 *@
                            <div class="d-flex gap-2 mb-3 overflow-hidden" style="height: 60px;">
                                @if (draft.Photos != null && draft.Photos.Any())
                                {
                                    @foreach (var photo in draft.Photos.Take(4))
                                    {
                                        <img src="@photo.FilePath"
                                             class="rounded border"
                                             style="width: 60px; height: 60px; object-fit: cover; cursor: pointer;"
                                             @onclick="() => OpenPreview(photo.FilePath)"
                                             title="@photo.Category" />
                                    }
                                    @if (draft.Photos.Count > 4)
                                    {
                                        <div class="d-flex align-items-center justify-content-center bg-light text-muted rounded border small"
                                             style="width: 60px; height: 60px; cursor: default;">
                                            +@(draft.Photos.Count - 4)
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small align-self-center">無照片</span>
                                }
                            </div>

                            @* 狀態連結 *@
                            @if (draft.ImportedWorkOrderId.HasValue)
                            {
                                <div class="alert alert-success py-1 px-2 small mb-0 d-flex align-items-center">
                                    <i class="bi bi-link-45deg me-1"></i>
                                    <span>已用於工單: </span>
                                    <a href="/workorders/details/@draft.ImportedWorkOrderId" class="ms-1 fw-bold text-success">
                                        #@draft.ImportedWorkOrderId
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning py-1 px-2 small mb-0 text-center">
                                    請至「工單詳情」頁面進行匯入
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-white border-top-0 d-flex justify-content-end pb-3">
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteDraftAsync(draft)">
                                <i class="bi bi-trash"></i> 刪除紀錄
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* --- 圖片預覽 Modal (簡單版) --- *@
@if (isPreviewOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.8);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body text-center p-0 position-relative">
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
                            style="z-index: 1050; background-color: white; padding: 10px;"
                            @onclick="ClosePreview"></button>
                    <img src="@previewImageUrl" class="img-fluid rounded shadow-lg" style="max-height: 85vh;" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<FieldRecordDraft> drafts = new();
    private bool isLoading = true;
    private AppUser? currentUser;

    // 預覽相關變數
    private bool isPreviewOpen = false;
    private string previewImageUrl = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDraftsAsync();
    }

    private async Task LoadDraftsAsync()
    {
        isLoading = true;
        try
        {
            var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                using var scope = ScopeFactory.CreateScope();
                var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
                var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();

                currentUser = await userManager.GetUserAsync(user);

                if (currentUser != null)
                {
                    drafts = await context.FieldRecordDrafts
                        .Include(d => d.Photos)
                        .Where(d => d.CreatorId == currentUser.Id)
                        .OrderByDescending(d => d.CreatedAt)
                        .ToListAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"載入暫存失敗: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenPreview(string url)
    {
        previewImageUrl = url;
        isPreviewOpen = true;
    }

    private void ClosePreview()
    {
        isPreviewOpen = false;
        previewImageUrl = "";
    }

    private async Task DeleteDraftAsync(FieldRecordDraft draft)
    {
        bool isConfirmed;
        if (draft.ImportedWorkOrderId.HasValue)
        {
            isConfirmed = await JSRuntime.InvokeAsync<bool>("confirm", "此紀錄已歸檔，刪除它不會影響正式工單的照片。\n確定要刪除這筆暫存嗎？");
        }
        else
        {
            isConfirmed = await JSRuntime.InvokeAsync<bool>("confirm", "⚠️ 警告：這筆資料【尚未匯入】任何工單！\n刪除後照片將永久遺失且無法復原。\n\n確定要刪除嗎？");
        }

        if (!isConfirmed) return;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            // 重新讀取確保併發安全
            var draftToDelete = await context.FieldRecordDrafts
                .Include(d => d.Photos)
                .FirstOrDefaultAsync(d => d.Id == draft.Id);

            if (draftToDelete != null)
            {
                // 1. 刪除實體照片
                var uploadsRoot = Configuration["FileStorageSettings:UploadsRootPath"];
                if (!string.IsNullOrEmpty(uploadsRoot))
                {
                    foreach (var photo in draftToDelete.Photos)
                    {
                        try
                        {
                            // 解析路徑: /uploads/drafts/... -> C:\...\drafts\...
                            string relativePath = photo.FilePath.Replace("/uploads", "", StringComparison.OrdinalIgnoreCase);
                            relativePath = relativePath.TrimStart('/', '\\');
                            string fullPath = Path.Combine(uploadsRoot, relativePath);

                            if (File.Exists(fullPath))
                            {
                                File.Delete(fullPath);
                            }
                        }
                        catch (Exception fileEx)
                        {
                            Console.WriteLine($"刪除檔案失敗: {fileEx.Message}");
                            // 即使檔案刪除失敗，也要繼續刪除 DB 記錄
                        }
                    }
                }

                // 2. 刪除資料庫記錄
                context.FieldRecordDrafts.Remove(draftToDelete);
                await context.SaveChangesAsync();

                // 3. 更新前端列表
                drafts.Remove(draft);
                StateHasChanged(); // 強制刷新 UI
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"刪除過程發生錯誤: {ex.Message}");
        }
    }
}