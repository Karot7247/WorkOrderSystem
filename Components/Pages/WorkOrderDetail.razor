    private async Task AssignWorkOrderAsync()
    {
        if (workOrder == null) return;
        var selectedIds = assignmentFormModel.SelectedEngineerIds;

        if (!selectedIds.Any()) { errorMessage = "請至少指派一位工程師。"; return; }
        if (string.IsNullOrEmpty(assignmentFormModel.PrimaryEngineerId)) { errorMessage = "請在被指派的工程師中，選擇一位作為主要負責人。"; return; }
        if (!selectedIds.Contains(assignmentFormModel.PrimaryEngineerId)) { errorMessage = "主要負責人必須是已被勾選指派的工程師之一。"; return; }

        errorMessage = null;
        try
        {
            using (var scope = ScopeFactory.CreateScope())
            {
                var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
                var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
                var lineNotifyService = scope.ServiceProvider.GetRequiredService<LineNotifyService>();

                var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
                var currentUser = await userManager.GetUserAsync(authState.User);
                if (currentUser == null)
                {
                    errorMessage = "無法驗證您的操作者身份。";
                    return;
                }

                var orderToUpdate = await context.WorkOrders
                    .Include(wo => wo.Assignments)
                    .Include(wo => wo.Requester)
                    .FirstOrDefaultAsync(wo => wo.Id == WorkOrderId);
                if (orderToUpdate == null)
                {
                    errorMessage = "在資料庫中找不到要更新的工單。";
                    return;
                }

                context.WorkOrderAssignees.RemoveRange(orderToUpdate.Assignments);
                foreach (var engineerId in selectedIds)
                {
                    orderToUpdate.Assignments.Add(new WorkOrderAssignee
                        {
                            UserId = engineerId,
                            IsPrimary = (engineerId == assignmentFormModel.PrimaryEngineerId)
                        });
                }

                orderToUpdate.Status = "處理中";
                orderToUpdate.AssignmentDate = DateTime.Now;

                await context.SaveChangesAsync();

                var assignedEngineers = await userManager.Users
                    .Where(u => selectedIds.Contains(u.Id))
                    .ToListAsync();
                foreach (var engineer in assignedEngineers)
                {
                    try
                    {
                        if (!string.IsNullOrEmpty(engineer.LineUserId))
                        {
                            var baseUrl = Configuration["ApplicationSettings:BaseUrl"];
                            var workOrderUrl = $"{baseUrl}/workorders/details/{orderToUpdate.Id}?openExternalBrowser=1";
                            var message = $"【新任務通知】\n您有一筆新的派工任務：\n『{orderToUpdate.Title}』\n\n請點擊以下連結查看詳情：\n{workOrderUrl}";
                            _ = lineNotifyService.SendPushMessageAsync(engineer.LineUserId, message);
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"發送 LINE 通知給工程師 {engineer.FullName} 失敗: {ex.Message}");
                    }
                }

                var requester = orderToUpdate.Requester;
                if (requester != null && requester.Id != currentUser.Id && !string.IsNullOrEmpty(requester.LineUserId))
                {
                    var primaryEngineer = assignedEngineers.FirstOrDefault(e => e.Id == assignmentFormModel.PrimaryEngineerId);
                    if (primaryEngineer != null)
                    {
                        try
                        {
                            var message = $"案件進度更新：\n您的工單申請『{orderToUpdate.Title}』已被指派，由工程師【{primaryEngineer.FullName}】主要負責。";
                            await lineNotifyService.SendPushMessageAsync(requester.LineUserId, message);
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"發送 [已指派] LINE 通知給申請人 {requester.FullName} 失敗: {ex.Message}");
                        }
                    }
                }
            }

            workOrder.Assignments.Clear();
            foreach (var engineerId in selectedIds)
            {
                var engineerUser = engineers.FirstOrDefault(e => e.Id == engineerId);
                if (engineerUser != null)
                {
                    workOrder.Assignments.Add(new WorkOrderAssignee
                        {
                            UserId = engineerId,
                            User = engineerUser,
                            IsPrimary = (engineerId == assignmentFormModel.PrimaryEngineerId)
                        });
                }
            }

            workOrder.Status = "處理中";
            isEditingAssignment = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"更新指派時發生錯誤：{ex.Message}";
            Console.WriteLine(ex.ToString());
            StateHasChanged();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        IReadOnlyList<IBrowserFile> selectedFiles;

        if (e.FileCount > MaxAllowedFiles)
        {
            errorMessage = $"您一次最多只能選取 {MaxAllowedFiles} 張照片。您選了 {e.FileCount} 張，系統將只處理前 {MaxAllowedFiles} 張。";
            selectedFiles = e.GetMultipleFiles(MaxAllowedFiles);
        }
        else
        {
            selectedFiles = e.GetMultipleFiles(MaxAllowedFiles);
        }

        isProcessingPhotos = true;
        totalFilesToProcess = selectedFiles.Count;
        filesProcessed = 0;
        StateHasChanged();
        try
        {
            foreach (var file in selectedFiles)
            {
                if (!AllowedImageTypes.Contains(file.ContentType))
                {
                    errorMessage = $"不支援的檔案格式：'{file.Name}'。請上傳 JPEG, PNG 或 WEBP 格式的圖片。";
                    filesProcessed++;
                    StateHasChanged();
                    continue;
                }

                try
                {
                    var resizedImageFile = await file.RequestImageFileAsync("image/jpeg", 1280, 1280);
                    using var memoryStream = new MemoryStream();
                    await resizedImageFile.OpenReadStream(5 * 1024 * 1024).CopyToAsync(memoryStream);
                    var buffer = memoryStream.ToArray();
                    var base64 = $"data:image/jpeg;base64,{Convert.ToBase64String(buffer)}";
                    previewPhotos.Add(new PreviewPhoto
                        {
                            FileName = file.Name,
                            Base64Data = base64
                        });
                }
                catch (Exception ex)
                {
                    errorMessage = $"處理檔案 '{file.Name}' 時發生錯誤: {ex.Message}";
                    _logger.LogError(ex, "處理檔案 '{FileName}' 時發生錯誤", file.Name);
                }
                finally
                {
                    filesProcessed++;
                    StateHasChanged();
                    await Task.Delay(1);
                }
            }
        }
        finally
        {
            isProcessingPhotos = false;
            StateHasChanged();
        }
    }

