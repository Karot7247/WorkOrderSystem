    private async Task ShowPdfPreviewAsync(string? fName)
    {
        if (string.IsNullOrWhiteSpace(fName)) 
        { 
            previewError = "請先選擇報價單。"; 
            return; 
        }
        isPreviewingQuotation = true; 
        previewError = null; 
        pdfPreviewBase64Data = null; 
        pdfPreviewFileName = null; 
        StateHasChanged();
        
        try
        {
            var response = await Http.GetAsync(_navigationManager.ToAbsoluteUri($"/api/download/preview/quotation.pdf?fileName={HttpUtility.UrlEncode(fName)}").ToString());
            if (response.IsSuccessStatusCode)
            {
                var pdfRes = await response.Content.ReadFromJsonAsync<PdfPreviewResponse?>();
                if (pdfRes != null && !string.IsNullOrEmpty(pdfRes.Base64Data)) 
                { 
                    pdfPreviewBase64Data = pdfRes.Base64Data; 
                    pdfPreviewFileName = pdfRes.FileName; 
                    isPdfModalVisible = true; 
                }
                else 
                {
                    previewError = "資料為空。";
                }
            }
            else 
            {
                previewError = "請求失敗。";
            }
        }
        catch (Exception ex) 
        { 
            previewError = $"預覽錯誤: {ex.Message}"; 
        }
        finally 
        { 
            isPreviewingQuotation = false; 
            StateHasChanged(); 
        }
    }

