    private void AssigneeSelectionChanged(ChangeEventArgs e, string id)
    {
        if (e.Value is bool c)
        {
            assignmentFormModel.SelectedEngineers[id] = c;
            if (!c && assignmentFormModel.PrimaryEngineerId == id) 
            {
                assignmentFormModel.PrimaryEngineerId = null;
            }
            var cnt = assignmentFormModel.SelectedEngineers.Count(k => k.Value);
            if (cnt == 1 && c) 
            {
                assignmentFormModel.PrimaryEngineerId = id;
            } 
            else if (cnt == 0) 
            {
                assignmentFormModel.PrimaryEngineerId = null;
            }
        }
    }

    private async Task AssignWorkOrderAsync()
    {
        if (workOrder == null) return; 
        var ids = assignmentFormModel.SelectedEngineerIds;
        if (!ids.Any() || string.IsNullOrEmpty(assignmentFormModel.PrimaryEngineerId) || !ids.Contains(assignmentFormModel.PrimaryEngineerId)) 
        { 
            errorMessage = "驗證失敗"; 
            return; 
        }
        errorMessage = null;
        try
        {
            using var scope = ScopeFactory.CreateScope(); 
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>(); 
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>(); 
            var line = scope.ServiceProvider.GetRequiredService<LineNotifyService>();
            var user = await userManager.GetUserAsync((await _authenticationStateProvider.GetAuthenticationStateAsync()).User);
            var order = await context.WorkOrders.Include(w => w.Assignments).Include(w => w.Requester).FirstOrDefaultAsync(w => w.Id == WorkOrderId);
            
            context.WorkOrderAssignees.RemoveRange(order.Assignments);
            foreach (var id in ids) 
            {
                order.Assignments.Add(new WorkOrderAssignee { UserId = id, IsPrimary = id == assignmentFormModel.PrimaryEngineerId });
            }
            order.Status = "處理中"; 
            order.AssignmentDate = DateTime.Now; 
            await context.SaveChangesAsync();
            
            var asngs = await userManager.Users.Where(u => ids.Contains(u.Id)).ToListAsync();
            foreach (var eng in asngs) 
            { 
                if (!string.IsNullOrEmpty(eng.LineUserId)) 
                { 
                    _ = line.SendPushMessageAsync(eng.LineUserId, $"新任務：{order.Title}"); 
                } 
            }
            
            workOrder.Assignments.Clear(); 
            foreach (var id in ids) 
            { 
                var u = engineers.FirstOrDefault(e => e.Id == id); 
                if(u != null) 
                {
                    workOrder.Assignments.Add(new WorkOrderAssignee { UserId = id, User = u, IsPrimary = id == assignmentFormModel.PrimaryEngineerId }); 
                }
            }
            workOrder.Status = "處理中"; 
            isEditingAssignment = false; 
            StateHasChanged();
        }
        catch (Exception ex) 
        { 
            errorMessage = ex.Message; 
            StateHasChanged(); 
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null; 
        var files = e.GetMultipleFiles(MaxAllowedFiles);
        isProcessingPhotos = true; 
        totalFilesToProcess = files.Count; 
        filesProcessed = 0; 
        StateHasChanged();
        try
        {
            foreach (var f in files)
            {
                if (!AllowedImageTypes.Contains(f.ContentType)) 
                { 
                    filesProcessed++; 
                    StateHasChanged(); 
                    continue; 
                }
                try
                {
                    var resized = await f.RequestImageFileAsync("image/jpeg", 1280, 1280);
                    using var ms = new MemoryStream(); 
                    await resized.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
                    previewPhotos.Add(new PreviewPhoto { FileName = f.Name, Base64Data = $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}" });
                }
                catch { } 
                finally 
                { 
                    filesProcessed++; 
                    StateHasChanged(); 
                    await Task.Delay(1); 
                }
            }
        }
        finally 
        { 
            isProcessingPhotos = false; 
            StateHasChanged(); 
        }
    }

    private void RemovePhoto(string id) 
    { 
        var p = previewPhotos.FirstOrDefault(x => x.Id == id); 
        if (p != null) 
        {
            previewPhotos.Remove(p); 
        }
    }

    private async Task HandleCompletionSubmitAsync()
    {
        if (workOrder is null) return; 
        errorMessage = null; 
        isUploading = true; 
        StateHasChanged();
        
        try
        {
            using var scope = ScopeFactory.CreateScope(); 
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>(); 
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var order = await context.WorkOrders.FindAsync(workOrder.Id);
            var user = await userManager.GetUserAsync((await _authenticationStateProvider.GetAuthenticationStateAsync()).User);
            
