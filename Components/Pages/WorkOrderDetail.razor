    private async Task SaveQuotationLinkAsync()
    {
        if (workOrder == null) return;
        isSavingQuotationLink = true; 
        quotationSaveMessage = null; 
        quotationSaveSuccess = false; 
        StateHasChanged();
        
        var val = string.IsNullOrWhiteSpace(selectedQuotationFileNameForEdit) ? null : selectedQuotationFileNameForEdit;
        try
        {
            using var scope = ScopeFactory.CreateScope(); 
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>(); 
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var user = await userManager.GetUserAsync((await _authenticationStateProvider.GetAuthenticationStateAsync()).User);
            var order = await context.WorkOrders.FindAsync(WorkOrderId);
            if (order == null) throw new Exception("找不到工單");
            
            bool changed = false; 
            var logs = new List<string>();
            if (order.RelatedQuotationFileName != val) 
            { 
                logs.Add($"綁定 '{val ?? "無"}'"); 
                order.RelatedQuotationFileName = val; 
                changed = true; 
            }
            if (order.CustomerName != workOrder.CustomerName) 
            { 
                logs.Add($"客戶更動"); 
                order.CustomerName = workOrder.CustomerName; 
                changed = true; 
            }
            if (order.ContactPerson != workOrder.ContactPerson) 
            { 
                order.ContactPerson = workOrder.ContactPerson; 
                changed = true; 
            }
            if (order.ContactPhone != workOrder.ContactPhone) 
            { 
                order.ContactPhone = workOrder.ContactPhone; 
                changed = true; 
            }

            if (changed) 
            { 
                order.UpdatedAt = DateTime.Now; 
                context.WorkOrderLogs.Add(new WorkOrderLog { WorkOrderId = order.Id, OperatorId = user?.Id, Action = "更新關聯", Comment = string.Join(";", logs) }); 
                await context.SaveChangesAsync(); 
                workOrder.RelatedQuotationFileName = val; 
                selectedQuotationFileNameForEdit = val; 
                quotationSaveMessage = "儲存成功！"; 
                quotationSaveSuccess = true; 
                contactInfoMessage = null; 
            }
            else 
            { 
                quotationSaveMessage = "無變更"; 
                quotationSaveSuccess = true; 
            }
        }
        catch (Exception ex) 
        { 
            quotationSaveMessage = $"錯誤: {ex.Message}"; 
            quotationSaveSuccess = false; 
        }
        finally 
        { 
            isSavingQuotationLink = false; 
            StateHasChanged(); 
            if (quotationSaveSuccess) 
            { 
                await Task.Delay(3000); 
                quotationSaveMessage = null; 
                StateHasChanged(); 
            } 
        }
    }

