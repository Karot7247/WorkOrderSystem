    protected override async Task OnInitializedAsync()
    {
        // 啟動計時器
        var sw = Stopwatch.StartNew();
        var stepSw = Stopwatch.StartNew();

        loadingStatus = "正在建立資料庫連線...";
        StateHasChanged();
        await Task.Delay(1); // ✨ 強制讓 UI 有機會刷新顯示文字

        using var scope = ScopeFactory.CreateScope();
        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
        var dbContextFactory = scope.ServiceProvider.GetRequiredService<IDbContextFactory<ApplicationDbContext>>();
        await using var context = await dbContextFactory.CreateDbContextAsync();

        // ---------------------------------------------------------
        // 步驟 1: 讀取工單主體 (不含關聯)
        // ---------------------------------------------------------
        loadingStatus = "正在查詢工單主檔...";
        StateHasChanged(); await Task.Delay(1);

        // 先只查 ID 確保存在 (極快)
        var exists = await context.WorkOrders.AnyAsync(w => w.Id == WorkOrderId);
        if (!exists)
        {
            loadingStatus = "找不到工單";
            return;
        }
        RecordTime(stepSw, "查詢主檔存在性");

        // ---------------------------------------------------------
        // 步驟 2: 讀取關聯資料 (這是最容易卡的地方)
        // ---------------------------------------------------------
        loadingStatus = "正在讀取關聯資料 (照片/日誌/指派)...";
        StateHasChanged(); await Task.Delay(1);

        workOrder = await context.WorkOrders
            .AsSplitQuery() // ✨ [效能優化] 關鍵修正：拆分查詢
            .AsNoTracking() // ✨ [效能優化] 唯讀模式
            .Include(wo => wo.Requester)
            .Include(wo => wo.Photos)
            .Include(wo => wo.Logs)
            .Include(wo => wo.Assignments)
                .ThenInclude(a => a.User)
            .Include(wo => wo.WorkLogs)
                .ThenInclude(wl => wl.Photos)
            .FirstOrDefaultAsync(wo => wo.Id == WorkOrderId);

        RecordTime(stepSw, "讀取所有關聯資料 (DB)");

        if (workOrder is null) return;

        // ---------------------------------------------------------
        // 步驟 3: 資料處理 (記憶體運算)
        // ---------------------------------------------------------
        loadingStatus = "正在處理照片分類...";
        StateHasChanged(); await Task.Delay(1);

        capturedSignatureData = workOrder.ClientSignature;

        // 整理照片分類
        requestPhotos = workOrder.Photos.Where(p => p.Category == "申請附件").OrderBy(p => p.Id).ToList();
        completionPhotos = workOrder.Photos.Where(p => p.Category == "施工後").OrderBy(p => p.Id).ToList();
        processPhotos = workOrder.Photos
            .Where(p => p.Category != "申請附件" && p.Category != "施工後")
            .OrderBy(p => p.Id)
            .ToList();

        RecordTime(stepSw, "照片分類處理");

        // ---------------------------------------------------------
        // 步驟 4: 處理日誌照片 (如果日誌很多，這裡會耗時)
        // ---------------------------------------------------------
        loadingStatus = "正在整理施工日誌...";
        StateHasChanged(); await Task.Delay(1);

        logDisplayPhotos = new List<WorkOrderPhoto>();
        if (workOrder.WorkLogs != null)
        {
            var sortedLogs = workOrder.WorkLogs.OrderBy(l => l.LogDate).ThenBy(l => l.CreatedAt).ToList();
            foreach (var log in sortedLogs)
            {
                if (log.Photos != null)
                {
                    foreach (var p in log.Photos)
                    {
                        logDisplayPhotos.Add(new WorkOrderPhoto
                            {
                                Id = -p.Id,
                                FilePath = p.FilePath,
                                Category = $"施工日誌 ({log.LogDate:MM/dd})",
                                CustomNote = !string.IsNullOrEmpty(log.Content) && log.Content.Length > 20
                                             ? log.Content.Substring(0, 20) + "..."
                                             : log.Content,
                                WorkOrderId = WorkOrderId
                            });
                    }
                }
            }
        }
        orderedPhotos = requestPhotos.Concat(logDisplayPhotos).Concat(processPhotos).Concat(completionPhotos).ToList();

        RecordTime(stepSw, "日誌照片整合");

        // ---------------------------------------------------------
        // 步驟 5: 產生 QR Code (圖片運算)
        // ---------------------------------------------------------
        loadingStatus = "正在產生 QR Code...";
        StateHasChanged(); await Task.Delay(1);

        await GenerateQrCodeAsync();

        RecordTime(stepSw, "QR Code 產生");

        // ---------------------------------------------------------
        // 步驟 6: 使用者權限檢查
        // ---------------------------------------------------------
        loadingStatus = "正在驗證使用者權限...";
        StateHasChanged(); await Task.Delay(1);

        var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;
        var appUser = await userManager.GetUserAsync(userPrincipal);
        if (appUser != null)
        {
            isManager = appUser.IsManager;
            isSupervisor = appUser.IsSupervisor;
            // ... (其他權限判斷邏輯保持不變)
            var canEditStatuses = new[] { "待指派", "處理中" };
            canEdit = (appUser.Id == workOrder.RequesterId || isManager || isSupervisor) && canEditStatuses.Contains(workOrder.Status);
            isPrimaryAssignee = workOrder.Assignments.Any(a => appUser.Id == a.UserId && a.IsPrimary);
            isPartOfAssignmentTeam = workOrder.Assignments.Any(a => appUser.Id == a.UserId);

            if (isManager)
            {
                engineers = await userManager.Users.Where(u => u.IsEngineer).OrderBy(u => u.FullName).ToListAsync();
                assignmentFormModel.SelectedEngineers = engineers.ToDictionary(eng => eng.Id, eng => false);
                foreach (var assignment in workOrder.Assignments)
                {
                    if (assignmentFormModel.SelectedEngineers.ContainsKey(assignment.UserId))
                    {
                        assignmentFormModel.SelectedEngineers[assignment.UserId] = true;
                        if (assignment.IsPrimary)
                        {
                            assignmentFormModel.PrimaryEngineerId = assignment.UserId;
                        }
                    }
                }
            }
        }

        RecordTime(stepSw, "權限驗證");

        // ---------------------------------------------------------
        // 步驟 7: 初始化其他變數
        // ---------------------------------------------------------
        loadingStatus = "初始化完成，準備顯示...";
        StateHasChanged(); await Task.Delay(1);

        selectedQuotationFileNameForEdit = workOrder.RelatedQuotationFileName;

        // 視角邏輯
        if (workOrder.Status == "待指派" || workOrder.Status == "已退回") { isEditingAssignment = true; isManagementView = true; }
        else if (isPartOfAssignmentTeam) { isManagementView = false; }
        else { isEditingAssignment = false; }

        if (!isManagementView) { await LoadMyDraftsAsync(); }

        // 年份邏輯
        int currentY = DateTime.Now.Year;
        for (int y = currentY + 1; y >= 2020; y--) { quotationYearOptions.Add(y); }
        selectedQuotationYear = workOrder.CreatedAt.Year;
        if (!quotationYearOptions.Contains(selectedQuotationYear)) { quotationYearOptions.Add(selectedQuotationYear); quotationYearOptions = quotationYearOptions.OrderByDescending(x => x).ToList(); }

        sw.Stop();
        detailedLog += $"🏁 總共耗時: {sw.ElapsedMilliseconds} ms";

        // 將詳細記錄輸出到 Console (按 F12 -> Console 查看)
        Console.WriteLine($"[效能診斷] 工單 {WorkOrderId} 開啟耗時分析:\n{detailedLog}");
    }

    // ✨ [效能優化] 改為 Lazy Loading，避免頁面開啟時卡住
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 只有當使用者有權限編輯時，才去讀取 NAS，節省效能
            if (canEdit)
            {
                // 不使用 await，讓它在背景跑，或者使用 await 但因為是在 AfterRender 所以不會卡住首屏
                _ = LoadQuotationOptionsAsync().ContinueWith(t => InvokeAsync(StateHasChanged));
            }

            try
            {
                signatureModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/signature.js");
                pdfModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/pdfUtils.js");

                
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "OnAfterRenderAsync: 載入 JS 模組時發生錯誤。");
                errorMessage = "頁面元件載入失敗，請重新整理頁面。";
                StateHasChanged();
            }
        }
    }

