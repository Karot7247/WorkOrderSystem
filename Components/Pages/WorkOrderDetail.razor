    private List<FieldRecordDraft> myDrafts = new();
    private int selectedDraftId; 
    private bool isImportingDraft = false;
    
    private async Task LoadMyDraftsAsync()
    {
        var auth = await _authenticationStateProvider.GetAuthenticationStateAsync(); 
        if (auth.User.Identity == null || !auth.User.Identity.IsAuthenticated) return;
        
        using var scope = ScopeFactory.CreateScope(); 
        var um = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>(); 
        var ctx = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
        
        var user = await um.GetUserAsync(auth.User); 
        if (user == null) return;
        
        myDrafts = await ctx.FieldRecordDrafts.Include(d => d.Photos).Where(d => d.CreatorId == user.Id).OrderByDescending(d => d.CreatedAt).ToListAsync();
    }
    
    private async Task ImportDraftAsync()
    {
        if (selectedDraftId == 0) return; 
        isImportingDraft = true; 
        errorMessage = null; 
        StateHasChanged();
        
        try
        {
            using var scope = ScopeFactory.CreateScope(); 
            var ctx = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var d = await ctx.FieldRecordDrafts.Include(x => x.Photos).FirstOrDefaultAsync(x => x.Id == selectedDraftId); 
            
            if (d == null) return;
            
            if (!string.IsNullOrWhiteSpace(d.EngineerNotes)) 
            {
                workOrder.EngineerNotes = string.IsNullOrWhiteSpace(workOrder.EngineerNotes) ? d.EngineerNotes : $"{workOrder.EngineerNotes}\n\n【匯入】\n{d.EngineerNotes}";
            }
            if (d.Photos != null && d.Photos.Any())
            {
                var root = Configuration["FileStorageSettings:UploadsRootPath"]; 
                int c = 0;
                foreach (var p in d.Photos)
                {
                    try 
                    { 
                        var rp = p.FilePath.Replace("/uploads", "", StringComparison.OrdinalIgnoreCase).TrimStart('/', '\\'); 
                        var fp = Path.Combine(root, rp); 
                        if (File.Exists(fp)) 
                        { 
                            previewPhotos.Add(new PreviewPhoto { FileName = Path.GetFileName(p.FilePath), Base64Data = $"data:image/jpeg;base64,{Convert.ToBase64String(await File.ReadAllBytesAsync(fp))}", Category = p.Category, CustomNote = p.CustomNote }); 
                            c++; 
                        } 
                    } 
                    catch { }
                }
                d.ImportedWorkOrderId = workOrder.Id; 
                await ctx.SaveChangesAsync();
            }
        }
        catch (Exception ex) 
        { 
            errorMessage = ex.Message; 
        } 
        finally 
        { 
            isImportingDraft = false; 
            selectedDraftId = 0; 
            StateHasChanged(); 
        }
    }
    
