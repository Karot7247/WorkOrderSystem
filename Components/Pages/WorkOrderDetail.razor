    protected override async Task OnInitializedAsync()
    {
        var sw = Stopwatch.StartNew(); 
        var stepSw = Stopwatch.StartNew();
        try
        {
            loadingStatus = "正在建立資料庫連線..."; 
            StateHasChanged(); 
            await Task.Delay(1);
            
            using var scope = ScopeFactory.CreateScope();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var dbContextFactory = scope.ServiceProvider.GetRequiredService<IDbContextFactory<ApplicationDbContext>>();
            await using var context = await dbContextFactory.CreateDbContextAsync();

            loadingStatus = "正在查詢工單主檔..."; 
            StateHasChanged(); 
            await Task.Delay(1);
            
            if (!await context.WorkOrders.AnyAsync(w => w.Id == WorkOrderId)) 
            { 
                loadingStatus = "找不到工單"; 
                return; 
            }
            RecordTime(stepSw, "查詢主檔存在性");

            loadingStatus = "正在讀取關聯資料..."; 
            StateHasChanged(); 
            await Task.Delay(1);
            
            workOrder = await context.WorkOrders.AsSplitQuery().AsNoTracking()
                .Include(wo => wo.Requester)
                .Include(wo => wo.Photos)
                .Include(wo => wo.Logs)
                .Include(wo => wo.Assignments).ThenInclude(a => a.User)
                .Include(wo => wo.WorkLogs).ThenInclude(wl => wl.Photos)
                .FirstOrDefaultAsync(wo => wo.Id == WorkOrderId);
                
            RecordTime(stepSw, "讀取所有關聯資料");

            if (workOrder is null) return;

            loadingStatus = "正在處理照片分類..."; 
            StateHasChanged(); 
            await Task.Delay(1);
            
            capturedSignatureData = workOrder.ClientSignature;
            requestPhotos = workOrder.Photos.Where(p => p.Category == "申請附件").OrderBy(p => p.Id).ToList();
            completionPhotos = workOrder.Photos.Where(p => p.Category == "施工後").OrderBy(p => p.Id).ToList();
            processPhotos = workOrder.Photos.Where(p => p.Category != "申請附件" && p.Category != "施工後").OrderBy(p => p.Id).ToList();
            RecordTime(stepSw, "照片分類處理");

            loadingStatus = "正在整理施工日誌..."; 
            StateHasChanged(); 
            await Task.Delay(1);
            
            logDisplayPhotos = new List<WorkOrderPhoto>();
            if (workOrder.WorkLogs != null)
            {
                foreach (var log in workOrder.WorkLogs.OrderBy(l => l.LogDate).ThenBy(l => l.CreatedAt))
                {
                    if (log.Photos != null)
                    {
                        foreach (var p in log.Photos)
                        {
                            logDisplayPhotos.Add(new WorkOrderPhoto 
                            { 
                                Id = -p.Id, 
                                FilePath = p.FilePath, 
                                Category = $"施工日誌 ({log.LogDate:MM/dd})", 
                                CustomNote = !string.IsNullOrEmpty(log.Content) && log.Content.Length > 20 ? log.Content.Substring(0, 20) + "..." : log.Content, 
                                WorkOrderId = WorkOrderId 
                            });
                        }
                    }
                }
            }
            orderedPhotos = requestPhotos.Concat(logDisplayPhotos).Concat(processPhotos).Concat(completionPhotos).ToList();
            RecordTime(stepSw, "日誌照片整合");

            loadingStatus = "正在產生 QR Code..."; 
            StateHasChanged(); 
            await Task.Delay(1);
            
            await GenerateQrCodeAsync();
            RecordTime(stepSw, "QR Code 產生");

            loadingStatus = "正在驗證權限..."; 
            StateHasChanged(); 
            await Task.Delay(1);
            
            var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity == null || !authState.User.Identity.IsAuthenticated) return;
            
            var appUser = await userManager.GetUserAsync(authState.User);
            if (appUser != null)
            {
                isManager = appUser.IsManager; 
                isSupervisor = appUser.IsSupervisor;
                canEdit = (appUser.Id == workOrder.RequesterId || isManager || isSupervisor) && new[] { "待指派", "處理中" }.Contains(workOrder.Status);
                isPrimaryAssignee = workOrder.Assignments.Any(a => appUser.Id == a.UserId && a.IsPrimary);
                isPartOfAssignmentTeam = workOrder.Assignments.Any(a => appUser.Id == a.UserId);
                
                if (isManager)
                {
                    engineers = await userManager.Users.Where(u => u.IsEngineer).OrderBy(u => u.FullName).ToListAsync();
                    assignmentFormModel.SelectedEngineers = engineers.ToDictionary(eng => eng.Id, eng => false);
                    foreach (var assignment in workOrder.Assignments)
                    {
                        if (assignmentFormModel.SelectedEngineers.ContainsKey(assignment.UserId))
                        {
                            assignmentFormModel.SelectedEngineers[assignment.UserId] = true;
                            if (assignment.IsPrimary) 
                            {
                                assignmentFormModel.PrimaryEngineerId = assignment.UserId;
                            }
                        }
                    }
                }
            }
            RecordTime(stepSw, "權限驗證");

            loadingStatus = "初始化完成..."; 
            StateHasChanged(); 
            await Task.Delay(1);
            
            selectedQuotationFileNameForEdit = workOrder.RelatedQuotationFileName;
            if (workOrder.Status == "待指派" || workOrder.Status == "已退回") 
            { 
                isEditingAssignment = true; 
                isManagementView = true; 
            }
            else if (isPartOfAssignmentTeam) 
            { 
                isManagementView = false; 
            } 
            else 
            { 
                isEditingAssignment = false; 
            }
            
            if (!isManagementView) 
            { 
                await LoadMyDraftsAsync(); 
            }

            int currentY = DateTime.Now.Year; 
            for (int y = currentY + 1; y >= 2020; y--) 
            { 
                quotationYearOptions.Add(y); 
            }
            
            selectedQuotationYear = workOrder.CreatedAt.Year;
            if (!quotationYearOptions.Contains(selectedQuotationYear)) 
            { 
                quotationYearOptions.Add(selectedQuotationYear); 
                quotationYearOptions = quotationYearOptions.OrderByDescending(x => x).ToList(); 
            }
        }
        catch (Exception ex)
        {
            loadingStatus = "載入失敗"; 
            errorMessage = $"[系統錯誤] {ex.GetType().Name}: {ex.Message}"; 
            Console.WriteLine(errorMessage);
        }
        finally 
        { 
            sw.Stop(); 
            detailedLog += $"🏁 總耗時: {sw.ElapsedMilliseconds} ms"; 
            StateHasChanged(); 
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
