    private string? RejectionReason
    {
        get
        {
            var rejectionLog = workOrder?.Logs
                .OrderByDescending(log => log.Timestamp)
                .FirstOrDefault(log => log.Action.Contains("退回"));
            if (rejectionLog != null && (workOrder?.Status == "處理中" || workOrder?.Status == "已退回"))
            {
                return rejectionLog.Comment;
            }

            return null;
        }
    }
