    private async Task UpdateWorkOrderStatusAsync(string newStatus, string logAction, string? logComment = null, Action<WorkOrder>? additionalAction = null)
    {
        if (workOrder is null) return;
        await using var scope = ServiceProvider.CreateAsyncScope();
        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
        var lineNotifyService = scope.ServiceProvider.GetRequiredService<LineNotifyService>();
        var dbContextFactory = scope.ServiceProvider.GetRequiredService<IDbContextFactory<ApplicationDbContext>>();
        await using var context = await dbContextFactory.CreateDbContextAsync();

        var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
        var currentUser = await userManager.GetUserAsync(authState.User);
        var orderToUpdate = await context.WorkOrders
            .Include(wo => wo.Assignments).ThenInclude(a => a.User)
            .FirstOrDefaultAsync(wo => wo.Id == workOrder.Id);
        if (orderToUpdate is null)
        {
            errorMessage = "錯誤：找不到要更新的工單。";
            StateHasChanged();
            return;
        }

        orderToUpdate.Status = newStatus;
        orderToUpdate.UpdatedAt = DateTime.Now;

        additionalAction?.Invoke(orderToUpdate);
        context.WorkOrderLogs.Add(new WorkOrderLog
            {
                WorkOrderId = orderToUpdate.Id,
                OperatorId = currentUser?.Id,
                Action = logAction,
                Comment = logComment
            });
        await context.SaveChangesAsync();

        try
        {
            var primaryAssignee = orderToUpdate.Assignments.FirstOrDefault(a => a.IsPrimary)?.User;
            var baseUrl = Configuration["ApplicationSettings:BaseUrl"];
            var workOrderUrl = $"{baseUrl}/workorders/details/{orderToUpdate.Id}?openExternalBrowser=1";
            string? message = null;
            switch (logAction)
            {
                case "主管審核通過":
                    if (primaryAssignee != null && !string.IsNullOrEmpty(primaryAssignee.LineUserId))
                    {
                        message = $"案件進度更新：\n您回報的工單『{orderToUpdate.Title}』已被主管審核通過，等待管理者最終核銷。\n\n查看詳情：\n{workOrderUrl}";
                        await lineNotifyService.SendPushMessageAsync(primaryAssignee.LineUserId, message);
                    }

                    var managers = await userManager.Users.Where(u => u.IsManager && !string.IsNullOrEmpty(u.LineUserId)).ToListAsync();
                    var managerMessage = $"【待核銷通知】\n工單：『{orderToUpdate.Title}』\n已由主管審核通過，請前往系統進行最終核銷。\n\n前往核銷：\n{workOrderUrl}";
                    foreach (var manager in managers)
                    {
                        _ = lineNotifyService.SendPushMessageAsync(manager.LineUserId, managerMessage);
                    }
                    break;

                case "主管審核退回":
                    if (primaryAssignee != null && !string.IsNullOrEmpty(primaryAssignee.LineUserId))
                    {
                        message = $"案件進度更新：\n您回報的工單『{orderToUpdate.Title}』已被主管退回。\n退回原因：{logComment}\n\n請登入系統修改後重新提交：\n{workOrderUrl}";
                        await lineNotifyService.SendPushMessageAsync(primaryAssignee.LineUserId, message);
                    }
                    break;

                case "管理者退回重審":
                    if (primaryAssignee != null && !string.IsNullOrEmpty(primaryAssignee.LineUserId))
                    {
                        message = $"案件狀態更新：\n您的工單『{orderToUpdate.Title}』已被管理者退回重審。\n退回原因：{logComment}\n\n請登入系統查看詳情：\n{workOrderUrl}";
                        await lineNotifyService.SendPushMessageAsync(primaryAssignee.LineUserId, message);
                    }
                    break;

                case "管理者完成核銷":
                    if (primaryAssignee != null && !string.IsNullOrEmpty(primaryAssignee.LineUserId))
                    {
                        message = $"案件結案通知：\n您負責的工單『{orderToUpdate.Title}』已被管理者完成核銷，案件已結案。";
                        await lineNotifyService.SendPushMessageAsync(primaryAssignee.LineUserId, message);
                    }
                    break;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"發送 [狀態變更] LINE 通知失敗: {ex.Message}");
        }

        await OnInitializedAsync();
        StateHasChanged();
    }

