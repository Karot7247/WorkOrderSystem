    // ✨ [詳情頁專用] 選擇報價單時，讀取資料並更新畫面模型 (尚未存入 DB) ✨
    private async Task OnQuotationSelectedAsync(string fileName)
    {
        // 1. 更新下拉選單綁定的變數
        selectedQuotationFileNameForEdit = fileName;

        // 清除訊息
        contactInfoMessage = null;
        quotationSaveMessage = null;

        if (string.IsNullOrWhiteSpace(fileName)) return;

        // 2. 顯示讀取中狀態
        isReadingContactInfo = true;
        StateHasChanged();

        try
        {
            // 3. 呼叫 Service 讀取 Excel (接收 3 個回傳值：客戶、聯絡人、電話)
            var info = await QuotationFileSvc.GetContactInfoFromExcelAsync(fileName);

            bool updated = false;
            var msgParts = new List<string>();

            // 4. 更新畫面上的 workOrder 物件 (暫存狀態，需按儲存才會寫入)

            // A. 客戶名稱 (A2)
            if (!string.IsNullOrWhiteSpace(info.CustomerName))
            {
                workOrder.CustomerName = info.CustomerName;
                msgParts.Add($"客戶: {info.CustomerName}");
                updated = true;
            }

            // B. 聯絡人 (A4)
            if (!string.IsNullOrWhiteSpace(info.ContactPerson))
            {
                workOrder.ContactPerson = info.ContactPerson;
                msgParts.Add($"聯絡人: {info.ContactPerson}");
                updated = true;
            }

            // C. 電話 (A5)
            if (!string.IsNullOrWhiteSpace(info.ContactPhone))
            {
                workOrder.ContactPhone = info.ContactPhone;
                msgParts.Add($"電話: {info.ContactPhone}");
                updated = true;
            }

            // 5. 提示使用者
            if (updated)
            {
                // 這裡的提示很重要，告訴使用者資料變了，但還沒存
                contactInfoMessage = $"已讀取：{string.Join(" / ", msgParts)}。請按下右側按鈕儲存變更！";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"讀取報價單資訊失敗: {ex.Message}");
        }
        finally
        {
            isReadingContactInfo = false;
            StateHasChanged();
        }
    }

    // ✨ [詳情頁專用] 儲存關聯與更新後的客戶資料 ✨
    private async Task SaveQuotationLinkAsync()
    {
        if (workOrder == null)
        {
            _logger.LogWarning("SaveQuotationLinkAsync: 嘗試在 workOrder 為 null 時儲存。");
            quotationSaveMessage = "錯誤：工單資料未載入，無法儲存。";
            quotationSaveSuccess = false;
            StateHasChanged();
            return;
        }

        isSavingQuotationLink = true;
        quotationSaveMessage = null;
        quotationSaveSuccess = false;
        StateHasChanged();

        var selectedValue = selectedQuotationFileNameForEdit;
        var valueToSave = string.IsNullOrWhiteSpace(selectedValue) ? null : selectedValue;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();

            var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
            var currentUser = await userManager.GetUserAsync(authState.User);
            if (currentUser == null)
            {
                _logger.LogError("SaveQuotationLinkAsync: 無法獲取當前使用者資訊。");
                throw new ApplicationException("無法驗證您的操作者身份。");
            }

            _logger.LogInformation("SaveQuotationLinkAsync: 嘗試使用 WorkOrderId: {Id} 從資料庫查找 WorkOrder 實體。", WorkOrderId);
            var orderToUpdate = await context.WorkOrders.FindAsync(WorkOrderId);

            if (orderToUpdate == null)
            {
                _logger.LogError("SaveQuotationLinkAsync: 在資料庫中找不到 WorkOrderId: {Id}。", WorkOrderId);
                throw new ApplicationException("在資料庫中找不到要更新的工單。");
            }
            _logger.LogInformation("SaveQuotationLinkAsync: 成功找到 WorkOrder，資料庫 ID: {FoundId}", orderToUpdate.Id);

            bool hasChanges = false;
            var changesLog = new List<string>();

            // 1. 檢查並更新關聯報價單檔名
            if (orderToUpdate.RelatedQuotationFileName != valueToSave)
            {
                changesLog.Add($"報價單: '{orderToUpdate.RelatedQuotationFileName ?? "無"}' -> '{valueToSave ?? "無"}'");
                orderToUpdate.RelatedQuotationFileName = valueToSave;
                hasChanges = true;
            }

            // 2. 檢查並更新客戶資料 (這些資料可能在 OnQuotationSelectedAsync 被修改過)
            if (orderToUpdate.CustomerName != workOrder.CustomerName)
            {
                changesLog.Add($"客戶: '{orderToUpdate.CustomerName}' -> '{workOrder.CustomerName}'");
                orderToUpdate.CustomerName = workOrder.CustomerName;
                hasChanges = true;
            }
            if (orderToUpdate.ContactPerson != workOrder.ContactPerson)
            {
                changesLog.Add($"聯絡人: '{orderToUpdate.ContactPerson ?? "無"}' -> '{workOrder.ContactPerson ?? "無"}'");
                orderToUpdate.ContactPerson = workOrder.ContactPerson;
                hasChanges = true;
            }
            if (orderToUpdate.ContactPhone != workOrder.ContactPhone)
            {
                changesLog.Add($"電話: '{orderToUpdate.ContactPhone ?? "無"}' -> '{workOrder.ContactPhone ?? "無"}'");
                orderToUpdate.ContactPhone = workOrder.ContactPhone;
                hasChanges = true;
            }

            if (hasChanges)
            {
                orderToUpdate.UpdatedAt = DateTime.Now;

                _logger.LogInformation("SaveQuotationLinkAsync: 準備新增 WorkOrderLog 記錄。WorkOrderId: {LogOrderId}, OperatorId: {OpId}", orderToUpdate.Id, currentUser?.Id);
                context.WorkOrderLogs.Add(new WorkOrderLog
                    {
                        WorkOrderId = orderToUpdate.Id,
                        OperatorId = currentUser?.Id,
                        Action = "更新關聯資料",
                        Timestamp = DateTime.Now,
                        Comment = string.Join("; ", changesLog)
                    });
                _logger.LogInformation("SaveQuotationLinkAsync: 準備呼叫 context.SaveChangesAsync...");
                await context.SaveChangesAsync();
                _logger.LogInformation("SaveQuotationLinkAsync: context.SaveChangesAsync 成功完成。");

                // 同步更新本地變數
                workOrder.RelatedQuotationFileName = valueToSave;
                selectedQuotationFileNameForEdit = valueToSave;

                quotationSaveMessage = "資料已成功更新並儲存！";
                quotationSaveSuccess = true;

                // 清除讀取提示
                contactInfoMessage = null;
            }
            else
            {
                _logger.LogInformation("SaveQuotationLinkAsync: 資料未發生變更。");
                quotationSaveMessage = "資料未變更。";
                quotationSaveSuccess = true;
            }
        }
        catch (Exception ex)
        {
            string fullErrorMessage = $"儲存關聯時發生錯誤: {ex.Message}";
            if (ex.InnerException != null)
            {
                fullErrorMessage += $" | InnerException: {ex.InnerException.Message}";
                _logger.LogError(ex.InnerException, "SaveQuotationLinkAsync: Inner Exception details.");
            }
            quotationSaveMessage = fullErrorMessage;
            quotationSaveSuccess = false;

            _logger.LogError(ex, "SaveQuotationLinkAsync: 儲存關聯報價單時發生完整錯誤");
        }
        finally
        {
            isSavingQuotationLink = false;
            StateHasChanged();

            if (quotationSaveSuccess && quotationSaveMessage == "資料已成功更新並儲存！")
            {
                await Task.Delay(3000);
                quotationSaveMessage = null;
                StateHasChanged();
            }
        }
    }

