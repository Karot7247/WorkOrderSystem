@page "/workorders/details/{WorkOrderId:int}"
@rendermode InteractiveServer

@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using WorkOrderSystem.Data
@using WorkOrderSystem.Models
@using WorkOrderSystem.ViewModels.Reports
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@using System.Web
@using WorkOrderSystem.Components.Shared
@using WorkOrderSystem.Services
@using QRCoder
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.AspNetCore.Hosting
@using System.Threading.Tasks
@using System.Diagnostics

@attribute [Authorize]
@implements IAsyncDisposable
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider _authenticationStateProvider
@inject NavigationManager _navigationManager
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject IServiceProvider ServiceProvider
@inject IQuotationFileService QuotationFileSvc
@inject ILogger<WorkOrderDetail> _logger
@inject IWebHostEnvironment WebHostEnvironment
@inject HttpClient Http

<PageTitle>工單詳情</PageTitle>

@if (workOrder == null)
{
    @* ✨ [診斷] 載入中顯示狀態 ✨ *@
    <div class="d-flex flex-column align-items-center justify-content-center" style="height: 50vh;">
        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h4 class="text-secondary">@loadingStatus</h4>

        @* 如果是開發模式，顯示詳細數據方便除錯 *@
        @if (isDebugMode && !string.IsNullOrEmpty(detailedLog))
        {
            <div class="mt-3 p-2 bg-light border rounded text-start" style="font-family: monospace; white-space: pre-wrap; font-size: 0.8rem; max-width: 600px;">
                @detailedLog
            </div>
        }
    </div>
}
else
{
    @* ✨ [新增] 返回列表按鈕 (放置於最頂部) ✨ *@
    <div class="mb-3">
        <button class="btn btn-outline-secondary shadow-sm" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> 返回工單列表
        </button>
    </div>

    @* --- 頂部操作列 (優化版：強調客戶名稱) --- *@
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            @* 上層小字：顯示功能名稱與工單編號 *@
            <div class="text-muted small mb-1">
                工單詳情 <span class="badge bg-light text-dark border ms-2">#@workOrder.Id.ToString("D6")</span>
            </div>

            @* 下層大字：客戶名稱 | 標題 *@
            <h2 class="mb-0 fw-bold">
                @* 客戶名稱：使用主色調高亮 *@
                <span class="text-primary">@workOrder.CustomerName</span>

                @* 分隔線 *@
                <span class="text-secondary mx-2 fw-light">|</span>

                @* 工單標題 *@
                <span class="text-dark">@workOrder.Title</span>
            </h2>
        </div>

        @* --- 視角切換按鈕 --- *@
        @if (isManager || isSupervisor)
        {
            <div class="mb-1">
                @* 微調按鈕位置對齊 *@
                <button class="btn @(isManagementView ? "btn-outline-primary" : "btn-outline-success")" @onclick="ToggleUserView">
                    <i class="bi bi-person-circle me-1"></i>
                    @if (isManagementView)
                    {
                        <span>切換至：工程師視角</span>
                    }
                    else
                    {
                        <span>切換至：主管/管理員視角</span>
                    }
                </button>
            </div>
        }
    </div>

    @* --- 頂部通用按鈕區 --- *@
    <div class="mb-3 d-flex gap-2 flex-wrap">
        <button class="btn btn-outline-danger" @onclick="ExportToPdfAsync" disabled="@isGeneratingPdf">
            @if (isGeneratingPdf)
            {
                <span class="spinner-border spinner-border-sm"></span> <span> 產生中...</span>
            }
            else
            {
                <i class="bi bi-file-earmark-pdf-fill"></i> <span> 匯出 PDF</span>
            }
        </button>
        @if (canEdit)
        {
            <a href="@($"/workorders/edit/{WorkOrderId}")" class="btn btn-outline-secondary"><i class="bi bi-pencil-fill"></i> 編輯工單</a>
        }
        <a href="@($"/workorders/{WorkOrderId}/logs")" class="btn btn-outline-primary"><i class="bi bi-journal-text"></i> 查看工作日誌</a>

        @if (isManager || isSupervisor)
        {
            <button class="btn btn-outline-success" @onclick="OpenScheduleModal" disabled="@(workOrder == null)">
                <i class="bi bi-calendar-event"></i> 計劃施工排程
            </button>
        }
    </div>

    @* --- START: 核心內容區 (雙欄佈局) --- *@
    <div class="row">

        @* --- 左側欄 (col-md-7): 基本資料與內容 --- *@
        <div class="col-md-7 mb-4">
            <div class="card">
                <div class="card-body p-4" id="workOrderSheet">
                    @* ID 留給 PDF 匯出用 *@

                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
                        <h4 class="mb-0">觸發科技派工維修服務單</h4>
                        <p class="text-muted mb-0">工單編號: @workOrder.Id.ToString("D6")</p>
                    </div>

                    @* --- 分頁導航 --- *@
                    <ul class="nav nav-tabs mb-4" id="workOrderTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#tab-info" type="button" role="tab" aria-controls="tab-info" aria-selected="true">
                                <i class="bi bi-info-circle"></i> 基本資料/指派
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="report-tab" data-bs-toggle="tab" data-bs-target="#tab-report" type="button" role="tab" aria-controls="tab-report" aria-selected="false">
                                <i class="bi bi-tools"></i> 施工回報/附件
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="log-tab" data-bs-toggle="tab" data-bs-target="#tab-log" type="button" role="tab" aria-controls="tab-log" aria-selected="false">
                                <i class="bi bi-file-earmark-bar-graph"></i> 歷程/報價
                            </button>
                        </li>
                    </ul>

                    @* --- 分頁內容 --- *@
                    <div class="tab-content" id="workOrderTabsContent">

                        @* === TAB 1: 基本資料/指派 === *@
                        <div class="tab-pane fade show active" id="tab-info" role="tabpanel" aria-labelledby="info-tab">

                            @* 基本資訊欄位 *@
                            <h5 class="mb-3">基本資料</h5>
                            <div class="row mb-3 fs-6">
                                <div class="col-md-6 mb-2"><strong>客戶名稱:</strong> @workOrder.CustomerName</div>
                                <div class="col-md-6 mb-2"><strong>案件類型:</strong> @workOrder.WorkOrderType</div>
                                <div class="col-md-6 mb-2"><strong>聯絡人:</strong> @(workOrder.ContactPerson ?? "N/A")</div>
                                <div class="col-md-6 mb-2"><strong>聯絡電話:</strong> @(workOrder.ContactPhone ?? "N/A")</div>
                                <div class="col-md-6 mb-2"><strong>申請人:</strong> @RequesterDisplayName</div>
                                <div class="col-md-6 mb-2"><strong>申請時間:</strong> @workOrder.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                                <div class="col-md-12 mb-2">
                                    <strong>施工排程:</strong>
                                    @if (workOrder.ScheduledStartDate.HasValue && workOrder.ScheduledEndDate.HasValue)
                                    {
                                        var startDateStr = workOrder.ScheduledStartDate.Value.ToString("yyyy-MM-dd");
                                        var endDateStr = workOrder.ScheduledEndDate.Value.ToString("yyyy-MM-dd");

                                        <span class="fw-bold text-success ms-2" style="font-size: 1.1rem;">
                                            <i class="bi bi-calendar-check-fill"></i>
                                            @if (startDateStr == endDateStr)
                                            {
                                                @startDateStr
                                            }
                                            else
                                            {
                                                @($"{startDateStr} 至 {endDateStr}")
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted ms-2">尚未排程</span>
                                    }
                                </div>
                                <div class="col-md-12 mb-2">
                                    <strong>地址:</strong>
                                    @if (string.IsNullOrWhiteSpace(workOrder.Address))
                                    {
                                        <span> N/A</span>
                                    }
                                    else
                                    {
                                        <a href="@($"https://www.google.com/maps/search/?api=1&query={WebUtility.UrlEncode(workOrder.Address)}")" target="_blank" title="在地圖開啟"> @workOrder.Address <i class="bi bi-box-arrow-up-right ms-1"></i> </a>
                                        {
                                            <div class="text-muted mt-1 small">
                                                <i class="bi bi-geo-alt"></i> 場堪定位：@workOrder.SurveyAddress
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            @* 案件描述 *@
                            <fieldset class="border border-secondary p-3 mb-3">
                                <legend class="float-none w-auto px-2 fs-6"><strong>案件描述</strong></legend>
                                <p style="white-space: pre-wrap; min-height: 60px;">@workOrder.Description</p>
                            </fieldset>

                            @* 退回原因警告 *@
                            @if (!string.IsNullOrEmpty(RejectionReason))
                            {
                                <div class="alert alert-danger" role="alert">
                                    <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> 此工單已被退回</h5>
                                    <p><strong>退回原因：</strong></p>
                                    <p class="mb-0" style="white-space: pre-wrap;">@RejectionReason</p>
                                </div>
                            }

                            @* 指派工程師 (非管理視角時，這裡顯示一個簡單的已指派工程師列表) *@
                            @if (!isManagementView)
                            {
                                <p class="form-label fw-bold mt-4">已指派工程師：</p>
                                <ul class="list-group list-group-flush mb-3">
                                    @foreach (var assignment in workOrder.Assignments.OrderByDescending(a => a.IsPrimary))
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @assignment.User.FullName
                                            @if (assignment.IsPrimary)
                                            {
                                                <span class="badge bg-primary rounded-pill">主要</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }

                        </div>

                        @* === TAB 2: 施工回報/附件 === *@
                        <div class="tab-pane fade" id="tab-report" role="tabpanel" aria-labelledby="report-tab">

                            @* 施工回報備註 *@
                            <fieldset class="border border-secondary p-3 mb-4">
                                <legend class="float-none w-auto px-2 fs-6"><strong>施工回報</strong></legend>

                                @* 施工回報內容顯示：自動偵測「位置:」並轉為地圖連結 *@
                                <div style="min-height: 80px; font-size: 1rem; line-height: 1.6;">
                                    @if (string.IsNullOrEmpty(workOrder.EngineerNotes))
                                    {
                                        <span class="text-muted">無回報內容</span>
                                    }
                                    else
                                    {
                                        @foreach (var line in workOrder.EngineerNotes.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None))
                                        {
                                            if (!string.IsNullOrWhiteSpace(line) && (line.Trim().StartsWith("位置:") || line.Contains(" 位置: ")))
                                            {
                                                var address = line.Replace("位置:", "").Replace("位置 :", "").Trim();
                                                <div class="mb-1">
                                                    <strong class="text-secondary">位置: </strong>
                                                    <a href="@($"https://www.google.com/maps/search/?api=1&query={System.Net.WebUtility.UrlEncode(address)}")"
                                                       target="_blank"
                                                       rel="noopener noreferrer"
                                                       @onclick:stopPropagation="true"
                                                       class="text-decoration-none fw-bold text-primary">
                                                        @address <i class="bi bi-geo-alt-fill text-danger ms-1"></i>
                                                    </a>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="min-height: 1.5rem;">@line</div>
                                            }
                                        }
                                    }
                                </div>

                                <div class="row border-top border-secondary pt-2 mt-3">
                                    <div class="col-6"><strong>主要負責人:</strong> @(workOrder.Assignments?.FirstOrDefault(a => a.IsPrimary)?.User?.FullName ?? "未指派")</div>
                                    <div class="col-6"><strong>完工時間:</strong> @(workOrder.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</div>
                                    @{
                                        var assistingEngineers = workOrder.Assignments?.Where(a => !a.IsPrimary).Select(a => a.User?.FullName);
                                    }
                                    @if (assistingEngineers != null && assistingEngineers.Any())
                                    {
                                        <div class="col-12 mt-2"><strong>協同人員:</strong> @string.Join(", ", assistingEngineers)</div>
                                    }
                                </div>
                            </fieldset>

                            @* 客戶簽名 *@
                            <h5 class="mt-4 border-bottom border-secondary pb-2">客戶簽收確認</h5>
                            <div class="row mt-3">
                                <div class="col-md-6 border-top border-secondary pt-2">
                                    <div class="text-center" style="min-height: 80px;">
                                        @if (!string.IsNullOrEmpty(workOrder.ClientSignature))
                                        {
                                            <img src="@workOrder.ClientSignature" style="max-height: 80px;" alt="客戶簽名" />
                                        }
                                    </div>
                                    <p class="text-center mb-0"><strong>客戶簽收確認</strong></p>
                                </div>
                            </div>

                            @* ✨ 附件照片 (分區塊顯示) ✨ *@
                            <div class="no-print">
                                <h5 class="mt-4 border-bottom border-secondary pb-2">附件照片</h5>

                                @if (!orderedPhotos.Any())
                                {
                                    <p class="text-muted">無附件照片</p>
                                }
                                else
                                {
                                    @* 1. 原始申請附件 *@
                                    @if (requestPhotos.Any())
                                    {
                                        <div class="mb-4">
                                            <h6 class="text-secondary border-bottom pb-1"><i class="bi bi-paperclip"></i> 原始申請附件</h6>
                                            <div class="row g-3 mt-1">
                                                @foreach (var photo in requestPhotos)
                                                {
                                                    <div class="col-md-4 col-sm-6">
                                                        <div class="position-relative">
                                                            <button type="button" class="photo-thumbnail-btn" @onclick="@(() => OpenGallery(photo))">
                                                                <img src="@photo.FilePath" class="img-fluid img-thumbnail" style="aspect-ratio: 4 / 3; object-fit: cover;" alt="@photo.Category" />
                                                            </button>
                                                            @if (isPartOfAssignmentTeam && workOrder.Status != "已完成")
                                                            {
                                                                <button class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1" @onclick="() => DeletePhotoAsync(photo.Id)">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                        <p class="text-center small mb-0 mt-1 text-muted">@photo.Category</p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @* ✨ 2. 施工日誌紀錄 (依日期排序，從 WorkLogs 讀取) ✨ *@
                                    @if (logDisplayPhotos.Any())
                                    {
                                        <div class="mb-4">
                                            <h6 class="text-primary border-bottom pb-1"><i class="bi bi-journal-text"></i> 施工日誌紀錄 (依日期)</h6>
                                            <div class="row g-3 mt-1">
                                                @foreach (var photo in logDisplayPhotos)
                                                {
                                                    <div class="col-md-4 col-sm-6">
                                                        <div class="position-relative">
                                                            <button type="button" class="photo-thumbnail-btn" @onclick="@(() => OpenGallery(photo))">
                                                                <img src="@photo.FilePath" class="img-fluid img-thumbnail" style="aspect-ratio: 4 / 3; object-fit: cover;" alt="@photo.Category" />
                                                            </button>
                                                            @* 故意不顯示刪除按鈕，因為這是來自日誌的連動資料 *@
                                                        </div>
                                                        <p class="text-center small mb-0 mt-1">
                                                            <span class="badge bg-light text-dark border">@photo.Category</span>
                                                            @if (!string.IsNullOrEmpty(photo.CustomNote))
                                                            {
                                                                <br />
                                                                <span class="text-muted small">@photo.CustomNote</span>
                                                            }
                                                        </p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @* 3. 施工過程 (直接上傳至工單的) *@
                                    @if (processPhotos.Any())
                                    {
                                        <div class="mb-4">
                                            <h6 class="text-info border-bottom pb-1"><i class="bi bi-camera-fill"></i> 施工過程 (直接上傳)</h6>
                                            <div class="row g-3 mt-1">
                                                @foreach (var photo in processPhotos)
                                                {
                                                    <div class="col-md-4 col-sm-6">
                                                        <div class="position-relative">
                                                            <button type="button" class="photo-thumbnail-btn" @onclick="@(() => OpenGallery(photo))">
                                                                <img src="@photo.FilePath" class="img-fluid img-thumbnail" style="aspect-ratio: 4 / 3; object-fit: cover;" alt="@photo.Category" />
                                                            </button>
                                                            @if (isPartOfAssignmentTeam && workOrder.Status != "已完成")
                                                            {
                                                                <button class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1" @onclick="() => DeletePhotoAsync(photo.Id)">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                        <p class="text-center small mb-0 mt-1">
                                                            <strong>@photo.Category</strong>
                                                            @if (!string.IsNullOrEmpty(photo.CustomNote))
                                                            {
                                                                <br />
                                                                <span class="text-muted">@photo.CustomNote</span>
                                                            }
                                                        </p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @* 4. 完工成果 (施工後) *@
                                    @if (completionPhotos.Any())
                                    {
                                        <div class="mb-4">
                                            <h6 class="text-success border-bottom pb-1"><i class="bi bi-check-circle-fill"></i> 完工成果</h6>
                                            <div class="row g-3 mt-1">
                                                @foreach (var photo in completionPhotos)
                                                {
                                                    <div class="col-md-4 col-sm-6">
                                                        <div class="position-relative">
                                                            <button type="button" class="photo-thumbnail-btn" @onclick="@(() => OpenGallery(photo))">
                                                                <img src="@photo.FilePath" class="img-fluid img-thumbnail" style="aspect-ratio: 4 / 3; object-fit: cover;" alt="@photo.Category" />
                                                            </button>
                                                            @if (isPartOfAssignmentTeam && workOrder.Status != "已完成")
                                                            {
                                                                <button class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1" @onclick="() => DeletePhotoAsync(photo.Id)">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                        <p class="text-center small mb-0 mt-1">
                                                            <strong>@photo.Category</strong>
                                                            @if (!string.IsNullOrEmpty(photo.CustomNote))
                                                            {
                                                                <br />
                                                                <span class="text-muted">@photo.CustomNote</span>
                                                            }
                                                        </p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            @* QR Code (只在列印時顯示) *@
                            <div class="row mt-5 pt-5 only-print">
                                <div class="col-7">
                                    @if (!string.IsNullOrEmpty(qrCodeAsBase64))
                                    {
                                        <img src="@qrCodeAsBase64" style="width: 120px; height: 120px;" alt="QR Code" />
                                        <p class="small text-muted mt-1">掃描此 QR Code 以下載<br />確認單與所有附件照片</p>
                                    }
                                </div>
                            </div>

                        </div> @* end of tab-report *@

                        @* === TAB 3: 歷程與報價 === *@
                        <div class="tab-pane fade" id="tab-log" role="tabpanel" aria-labelledby="log-tab">

                            @* 關聯報價單區塊 *@
                            <h5 class="mb-3">關聯報價單</h5>
                            <div class="row mb-3 fs-6">
                                <div class="col-md-6 mb-2">
                                    <strong>目前關聯:</strong>
                                    @if (!string.IsNullOrWhiteSpace(workOrder.RelatedQuotationFileName))
                                    {
                                        <span>@workOrder.RelatedQuotationFileName</span>
                                        <button class="btn btn-outline-info btn-sm ms-2"
                                                @onclick="PreviewAssociatedQuotationAsync"
                                                disabled="@isPreviewingQuotation"
                                                title="預覽關聯的報價單 (PDF)">
                                            @if (isPreviewingQuotation)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-eye"></i>
                                            }
                                        </button>
                                        @if (!string.IsNullOrEmpty(previewError) && !isPreviewingQuotation)
                                        {
                                            <small class="text-danger ms-2">@previewError</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">無</span>
                                    }
                                </div>

                                @if (canEdit)
                                {
                                    <div class="col-md-6 mb-2">
                                        @* ✨ [修改] 新增年度選擇器 ✨ *@
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="form-check mb-0">
                                                <input class="form-check-input" type="checkbox" id="filterCustomerCheck"
                                                       checked="@filterQuotationsByCustomer"
                                                       @onchange="OnFilterCustomerChangedAsync"
                                                       disabled="@isLoadingQuotations" />
                                                <label class="form-check-label" for="filterCustomerCheck">
                                                    僅顯示客戶 '@workOrder.CustomerName'
                                                </label>
                                            </div>

                                            <div class="input-group input-group-sm w-auto">
                                                <span class="input-group-text bg-white border-end-0">年度</span>
                                                <select class="form-select border-start-0" value="@selectedQuotationYear" @onchange="OnQuotationYearChanged" disabled="@isLoadingQuotations">
                                                    @foreach (var y in quotationYearOptions)
                                                    {
                                                        <option value="@y">@y (@(y - 1911))</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        <label for="quotationSelect" class="form-label visually-hidden">選擇報價單</label>

                                        @* 啟用手動觸發讀取邏輯 *@
                                        <div class="input-group">
                                            <InputSelect id="quotationSelect" class="form-select"
                                                         Value="@selectedQuotationFileNameForEdit"
                                                         ValueChanged="@((string s) => OnQuotationSelectedAsync(s))"
                                                         ValueExpression="@(() => selectedQuotationFileNameForEdit)"
                                                         disabled="@(isLoadingQuotations || isSavingQuotationLink)">
                                                <option value="">-- 無 --</option>
                                                @if (isLoadingQuotations)
                                                {
                                                    <option disabled>讀取中...</option>
                                                }
                                                else if (availableQuotations != null)
                                                {
                                                    @foreach (var quote in availableQuotations)
                                                    {
                                                        <option value="@quote.Value">@quote.DisplayText</option>
                                                    }
                                                }
                                            </InputSelect>

                                            <button class="btn btn-outline-secondary" type="button"
                                                    @onclick="PreviewSelectedQuotationAsync"
                                                    disabled="@(isLoadingQuotations || isPreviewingQuotation || string.IsNullOrWhiteSpace(selectedQuotationFileNameForEdit))"
                                                    title="預覽目前選中的報價單 (PDF)">
                                                @if (isPreviewingQuotation && !isSavingQuotationLink)
                                                {
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-eye"></i>
                                                }
                                            </button>

                                            <button class="btn btn-outline-primary" type="button" @onclick="SaveQuotationLinkAsync" disabled="@(isLoadingQuotations || isSavingQuotationLink)">
                                                @if (isSavingQuotationLink)
                                                {
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-link-45deg"></i>
                                                }
                                            </button>
                                        </div>

                                        @* 讀取狀態提示 *@
                                        @if (isReadingContactInfo)
                                        {
                                            <div class="text-info small mt-1 ms-1">
                                                <span class="spinner-border spinner-border-sm"></span> 正在讀取報價單資訊...
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(contactInfoMessage))
                                        {
                                            <div class="text-primary small mt-1 ms-1">
                                                <i class="bi bi-info-circle"></i> @contactInfoMessage
                                            </div>
                                        }

                                        @if (isLoadingQuotations)
                                        {
                                            <div class="spinner-border spinner-border-sm text-secondary ms-2"></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(quotationLoadError))
                                        {
                                            <div class="text-danger mt-1"><small>@quotationLoadError</small></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(quotationSaveMessage))
                                        {
                                            <div class="mt-1 @(quotationSaveSuccess ? "text-success" : "text-danger")"><small>@quotationSaveMessage</small></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(previewError) && isPreviewingQuotation)
                                        {
                                            <small class="text-danger mt-1">@previewError</small>
                                        }
                                    </div>
                                }
                            </div>

                            <p class="mt-4 text-muted">點擊頂部 **「查看工作日誌」** 按鈕可查看工單詳細操作歷程。</p>

                        </div> @* end of tab-log *@

                    </div> @* end of tab-content *@

                </div> @* card-body 結束 *@
            </div> @* card 結束 *@
        </div> @* col-md-7 結束 *@

        @* --- 右側欄 (col-md-5): 操作區塊 (依視角切換) --- *@
        <div class="col-md-5">
            @* 1. 主管/管理員視角：顯示指派、審核、核銷 *@
            @if (isManagementView)
            {
                @* 1.1 指派工程師 *@
                @if (isManager && (workOrder.Status == "待指派" || workOrder.Status == "已退回" || workOrder.Status == "處理中"))
                {
                    <div class="card mb-3">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <span>管理者操作：指派工程師</span>
                            @if (isEditingAssignment && workOrder.Assignments.Any())
                            {
                                <button class="btn btn-sm btn-outline-light" @onclick="ToggleAssignmentEdit">取消</button>
                            }
                        </div>
                        <div class="card-body">
                            @if (isEditingAssignment)
                            {
                                <EditForm Model="assignmentFormModel" OnValidSubmit="AssignWorkOrderAsync" FormName="AssignForm">
                                    <DataAnnotationsValidator />
                                    <div class="mb-3" style="max-height: 250px; overflow-y: auto; border: 1px solid #dee2e6; padding: 10px;">
                                        <p class="form-label fw-bold">選擇工程師 (可複選)</p>
                                        <InputRadioGroup @bind-Value="assignmentFormModel.PrimaryEngineerId">
                                            @foreach (var engineer in engineers)
                                            {
                                                var isSelected = assignmentFormModel.SelectedEngineers.GetValueOrDefault(engineer.Id);
                                                <div class="d-flex align-items-center mb-2">
                                                    <div class="form-check flex-grow-1">
                                                        <input type="checkbox" class="form-check-input" id="@($"assign-{engineer.Id}")" checked="@isSelected" @onchange="@((ChangeEventArgs __e) => AssigneeSelectionChanged(__e, engineer.Id))" />
                                                        <label for="@($"assign-{engineer.Id}")" class="form-check-label">@engineer.FullName</label>
                                                    </div>
                                                    <div class="form-check ms-3">
                                                        <InputRadio id="@($"primary-{engineer.Id}")" Value="@engineer.Id" class="form-check-input" disabled="@(!isSelected)" />
                                                        <label for="@($"primary-{engineer.Id}")" class="form-check-label"><small>設為主要</small></label>
                                                    </div>
                                                </div>
                                            }
                                        </InputRadioGroup>
                                    </div>
                                    <ValidationSummary />
                                    @if (!string.IsNullOrEmpty(errorMessage))
                                    {
                                        <div class="alert alert-danger">@errorMessage</div>
                                    }
                                    <button type="submit" class="btn btn-primary w-100">確認指派</button>
                                </EditForm>
                            }
                            else
                            {
                                <p class="form-label fw-bold">已指派工程師：</p>
                                <ul class="list-group list-group-flush mb-3">
                                    @foreach (var assignment in workOrder.Assignments.OrderByDescending(a => a.IsPrimary))
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @assignment.User.FullName
                                            @if (assignment.IsPrimary)
                                            {
                                                <span class="badge bg-primary rounded-pill">主要</span>
                                            }
                                        </li>
                                    }
                                </ul>
                                <button class="btn btn-outline-secondary w-100" @onclick="ToggleAssignmentEdit">修改指派</button>
                            }
                        </div>
                    </div>
                }

                @* 1.2 主管審核 *@
                @if (isSupervisor && workOrder.Status == "待主管審核")
                {
                    <div class="card mb-3">
                        <div class="card-header bg-warning text-dark">主管操作：審核</div>
                        <div class="card-body">
                            <p>請審核工程師的回報內容。</p>
                            <div class="d-grid gap-2">
                                <button class="btn btn-success" @onclick="HandleApprovalAsync">審核通過</button>
                            </div>
                            <hr />
                            <EditForm Model="actionModel" OnValidSubmit="HandleRejectionAsync" FormName="RejectionForm">
                                <DataAnnotationsValidator />
                                <div class="mb-3">
                                    <label for="rejectionNotes" class="form-label">退回原因 (必填)</label>
                                    <InputTextArea id="rejectionNotes" class="form-control" @bind-Value="actionModel.Notes" rows="3" />
                                    <ValidationMessage For="@(() => actionModel.Notes)" />
                                </div>
                                <button type="submit" class="btn btn-danger w-100">審核退回</button>
                            </EditForm>
                        </div>
                    </div>
                }

                @* 1.3 管理者核銷 *@
                @if (isManager && workOrder.Status == "待管理者核銷")
                {
                    <div class="card mb-3">
                        <div class="card-header bg-info text-dark">管理者操作：核銷</div>
                        <div class="card-body">
                            <p>此工單已由主管審核通過，請做最終確認。</p>
                            <div class="d-grid gap-2">
                                <button class="btn btn-success" @onclick="HandleWriteOffAsync">完成核銷</button>
                            </div>
                            <hr />
                            <EditForm Model="actionModel" OnValidSubmit="HandleManagerRejectionAsync" FormName="ManagerRejectionForm">
                                <DataAnnotationsValidator />
                                <div class="mb-3">
                                    <label for="rejectionNotes" class="form-label">退回原因 (必填)</label>
                                    <InputTextArea id="rejectionNotes" class="form-control" @bind-Value="actionModel.Notes" rows="3" />
                                    <ValidationMessage For="@(() => actionModel.Notes)" />
                                </div>
                                <button type="submit" class="btn btn-danger w-100">退回重審</button>
                            </EditForm>
                        </div>
                    </div>
                }
            } @* end of isManagementView *@

            @* 2. 工程師視角：顯示回報施工 *@
            @if (!isManagementView)
            {
                @if (isPartOfAssignmentTeam && (workOrder.Status == "處理中" || workOrder.Status == "待主管審核"))
                {
                    <div class="card mb-3">
                        <div class="card-header bg-success text-white">工程師操作：回報施工完成</div>
                        <div class="card-body">

                            <EditForm Model="workOrder" OnValidSubmit="HandleCompletionSubmitAsync" FormName="CompletionForm">
                                <DataAnnotationsValidator />
                                @* --- 匯入預建紀錄區塊 --- *@
                                @if (myDrafts != null && myDrafts.Any())
                                {
                                    <div class="alert alert-secondary d-flex flex-column gap-2 mb-3">
                                        <div>
                                            <i class="bi bi-box-arrow-in-down-right"></i> <strong>匯入預建紀錄</strong>
                                            <small class="text-muted d-block">選擇您之前儲存的暫存紀錄，快速填入資料。</small>
                                        </div>

                                        <div class="input-group">
                                            <select class="form-select" @bind="selectedDraftId" disabled="@isImportingDraft">
                                                <option value="0">-- 請選擇一筆紀錄 --</option>
                                                @foreach (var draft in myDrafts)
                                                {
                                                    <option value="@draft.Id">@draft.CreatedAt.ToString("MM/dd HH:mm") - @draft.Title</option>
                                                }
                                            </select>
                                            <button class="btn btn-primary" type="button" @onclick="ImportDraftAsync" disabled="@(selectedDraftId == 0 || isImportingDraft)">
                                                @if (isImportingDraft)
                                                {
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                }
                                                else
                                                {
                                                    <span>匯入</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                }
                                @* --- [NEW END] --- *@
                                <div class="mb-3">
                                    <label class="form-label">客戶簽名</label>
                                    @if (string.IsNullOrEmpty(capturedSignatureData))
                                    {
                                        <button type="button" class="btn btn-outline-primary w-100" @onclick="OpenSignatureModal">擷取客戶簽名</button>
                                    }
                                    else
                                    {
                                        <div class="text-center border p-2">
                                            <img src="@capturedSignatureData" style="max-width: 150px;" alt="已擷取簽名" />
                                            <button type="button" class="btn btn-sm btn-link" @onclick="OpenSignatureModal">重新簽名</button>
                                        </div>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label for="completionNotes" class="form-label">施工備註 (可選)</label>
                                    <InputTextArea id="completionNotes" class="form-control" @bind-Value="workOrder.EngineerNotes" rows="4" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">上傳完工照片 (可選)</label>
                                    <div>
                                        <InputFile OnChange="HandleFileSelected" capture="environment" class="d-none" id="cameraInput" accept="image/*" disabled="@isProcessingPhotos" />
                                        <InputFile OnChange="HandleFileSelected" multiple class="d-none" id="galleryInput" accept="image/jpeg, image/png, image/webp" disabled="@isProcessingPhotos" />

                                        <button type="button" class="btn btn-secondary me-2" onclick="document.getElementById('cameraInput').click()" disabled="@isProcessingPhotos">
                                            <i class="bi bi-camera-fill"></i> 拍照上傳
                                        </button>
                                        <button type="button" class="btn btn-secondary" onclick="document.getElementById('galleryInput').click()" disabled="@isProcessingPhotos">
                                            <i class="bi bi-images"></i> 從相簿選取
                                        </button>

                                        @if (isProcessingPhotos)
                                        {
                                            <div class="d-inline-block ms-2" style="vertical-align: middle;">
                                                <div class="spinner-border spinner-border-sm text-secondary" role="status">
                                                    <span class="visually-hidden">處理中...</span>
                                                </div>
                                                <span class="text-muted ms-1">照片處理中... (@filesProcessed / @totalFilesToProcess)</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (previewPhotos.Any())
                                {
                                    <div class="mt-3 d-flex flex-wrap" style="gap: 10px;">
                                        @foreach (var photo in previewPhotos)
                                        {
                                            <div class="border p-2">
                                                <div class="position-relative">
                                                    <img src="@photo.Base64Data" class="img-thumbnail" style="width: 150px; height: 150px; object-fit: cover;" />
                                                    <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1"
                                                            aria-label="移除照片" @onclick="() => RemovePhoto(photo.Id)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>

                                                <div class="mt-2">
                                                    <InputSelect @bind-Value="photo.Category" class="form-select form-select-sm">
                                                        <option value="">-- 請選擇分類 --</option>
                                                        <option value="施工前">施工前</option>
                                                        <option value="施工中">施工中</option>
                                                        <option value="施工後">施工後</option>
                                                        <option value="自行備註">自行備註</option>
                                                    </InputSelect>
                                                </div>
                                                @if (photo.Category == "自行備註")
                                                {
                                                    <div class="mt-1">
                                                        <InputText @bind-Value="photo.CustomNote" class="form-control form-control-sm" placeholder="請輸入備註..."></InputText>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(errorMessage))
                                {
                                    <div class="alert alert-danger">@errorMessage</div>
                                }
                                @if (isUploading)
                                {
                                    <div class="mb-3">
                                        @if (totalFilesToUpload > 0)
                                        {
                                            <p class="text-center mb-1">正在上傳照片... (@filesUploaded / @totalFilesToUpload)</p>
                                            <div class="progress">
                                                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar"
                                                     style="width: @((double)filesUploaded / totalFilesToUpload * 100)%"
                                                     aria-valuenow="@filesUploaded" aria-valuemin="0" aria-valuemax="@totalFilesToProcess">
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-center mb-1">正在處理...</p>
                                        }
                                    </div>
                                }

                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-secondary w-100" @onclick="SaveChangesAsync" disabled="@isUploading">
                                        @if (isUploading && !isPrimaryAssignee)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span> <span> 儲存中...</span>
                                        }
                                        else
                                        {
                                            <span>儲存進度 (僅備註/照片)</span>
                                        }
                                    </button>

                                    <button type="submit" class="btn btn-success w-100" disabled="@(isUploading || !isPrimaryAssignee)">
                                        @if (isUploading && isPrimaryAssignee)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span> <span> 處理中...</span>
                                        }
                                        else
                                        {
                                            <span>@(workOrder.Status == "處理中" ? "回報完成" : "更新回報內容")</span>
                                        }
                                    </button>
                                </div>

                                @if (!isPrimaryAssignee)
                                {
                                    <small class="d-block text-center text-muted mt-2">只有主要負責人可以提交完工回報。</small>
                                }

                            </EditForm>
                        </div>
                    </div>
                }
                @if (!isManagementView && !isPartOfAssignmentTeam && !IsAnyActionAvailable())
                {
                    <div class="card">
                        <div class="card-header bg-secondary text-white">工單狀態</div>
                        <div class="card-body">
                            <h5 class="card-title">@workOrder.Status</h5>
                            <p class="card-text">您目前不屬於此工單指派團隊，無法進行操作。</p>
                        </div>
                    </div>
                }
            } @* end of !isManagementView *@

            @if (!IsAnyActionAvailable() && isManagementView)
            {
                <div class="card">
                    <div class="card-header bg-secondary text-white">工單狀態</div>
                    <div class="card-body">
                        <h5 class="card-title">@workOrder.Status</h5>
                        <p class="card-text">目前沒有可對此工單執行的操作。</p>
                    </div>
                </div>
            }

        </div> @* col-md-5 結束 *@
    </div> @* row 結束 *@
    @* --- END: 核心內容區 --- *@

    @* --- MODALS (簽名板 - 保持原結構，JS 控制全螢幕) --- *@
    <div class="modal fade signature-modal" id="signatureModal" tabindex="-1" aria-labelledby="signatureModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-body">
                    @* 簽名板模組應包含 確認/取消 按鈕 (由 SignaturePad 元件提供) *@
                    <SignaturePad @ref="signaturePadComponent" Module="signatureModule" OnConfirm="ConfirmSignature" OnCancel="CancelSignature" />
                </div>
            </div>
        </div>
    </div>

    @* --- MODALS (施工排程) --- *@
    <div class="modal fade" id="scheduleModal" tabindex="-1" aria-labelledby="scheduleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="scheduleModalLabel">計劃施工排程：@workOrder.Title</h5>
                    <button type="button" class="btn-close" @onclick="CancelScheduleModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <EditForm Model="scheduleFormModel" FormName="ScheduleForm">
                        <DataAnnotationsValidator />
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="schedStartDate" class="form-label">排程開始日期</label>
                                @* ✨ 加上 @bind-Value:after，確保值寫入 C# 後才執行檢查 ✨ *@
                                <InputDate id="schedStartDate" class="form-control" @bind-Value="scheduleFormModel.StartDate" @bind-Value:after="CheckConflictsAsync" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="schedEndDate" class="form-label">排程結束日期</label>
                                <InputDate id="schedEndDate" class="form-control" @bind-Value="scheduleFormModel.EndDate" @bind-Value:after="CheckConflictsAsync" />
                            </div>
                        </div>
                        <ValidationMessage For="@(() => scheduleFormModel.StartDate)" />
                        <ValidationMessage For="@(() => scheduleFormModel.EndDate)" />
                    </EditForm>

                    <hr class="my-3" />

                    @* 衝突檢查區塊 *@
                    <div>
                        @if (isLoadingConflicts)
                        {
                            <p class="mt-3 text-muted"><span class="spinner-border spinner-border-sm me-2"></span> 正在查詢時段內的其他工單...</p>
                        }
                        else if (conflictingOrders != null)
                        {
                            @if (conflictingOrders.Any())
                            {
                                <div class="alert alert-warning mt-3">
                                    <h5 class="alert-heading">行程衝突警告</h5>
                                    <p>在您選擇的時段內，已有 <strong>@conflictingOrders.Count</strong> 張工單：</p>
                                    <ul>
                                        @foreach (var conflict in conflictingOrders)
                                        {
                                            <li>
                                                <a href="/workorders/details/@conflict.Id" target="_blank" title="在新分頁開啟工單">
                                                    (@conflict.Id.ToString("D6")) @conflict.Title
                                                </a>
                                                (@conflict.ScheduledStartDate?.ToString("MM/dd") - @conflict.ScheduledEndDate?.ToString("MM/dd"))

                                                @if (conflict.Assignments.Any())
                                                {
                                                    <span class="text-muted d-block ms-3" style="font-size: 0.9rem;">
                                                        └─ 分派給: @(string.Join(", ", conflict.Assignments.Select(a => a.User?.FullName ?? "N/A")))
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted d-block ms-3" style="font-size: 0.9rem;">
                                                        └─ 尚未分派
                                                    </span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success mt-3">
                                    <p class="mb-0"><i class="bi bi-check-circle-fill"></i> 恭喜！該時段目前沒有其他排程。</p>
                                </div>
                            }
                        }

                        @if (!string.IsNullOrEmpty(scheduleErrorMessage))
                        {
                            <div class="alert alert-danger mt-3">@scheduleErrorMessage</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelScheduleModal">取消</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveScheduleAsync" disabled="@isSavingSchedule">
                        @if (isSavingSchedule)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> 儲存中...</span>
                        }
                        else
                        {
                            <span>儲存排程</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

}


<PdfPreviewModal IsVisible="isPdfModalVisible"
                 Base64Data="@pdfPreviewBase64Data"
                 FileName="@pdfPreviewFileName"
                 OnClose="() => isPdfModalVisible = false" />

@if (isGalleryVisible)
{
    <PhotoGallery Photos="orderedPhotos"
                  StartIndex="galleryStartIndex"
                  IsVisible="isGalleryVisible"
                  OnClose="() => isGalleryVisible = false" />
}

@* --- 額外 CSS 樣式 (保留) --- *@
<style>
    .photo-thumbnail-btn {
        padding: 0;
        border: none;
        background: none;
        width: 100%;
        display: block;
        cursor: pointer;
    }

        .photo-thumbnail-btn img:hover {
            opacity: 0.8;
            box-shadow: 0 0 10px rgba(0,123,255,0.5);
        }
</style>


@code {
    [Parameter]
    public int WorkOrderId { get; set; }
    private const int MaxAllowedFiles = 100;

    // WorkOrder Data
    private WorkOrder? workOrder;
    private List<AppUser> engineers = new();

    // User Permissions
    private bool canEdit = false;
    private bool isManager = false;
    private bool isSupervisor = false;
    private bool isPrimaryAssignee = false;
    private bool isPartOfAssignmentTeam = false;
    // UX States
    private string? errorMessage;
