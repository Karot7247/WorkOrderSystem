@page "/workorders/details/{WorkOrderId:int}"
@rendermode InteractiveServer

@using System.Globalization
@using System.Linq
@using System.Collections.Generic
@using Microsoft.EntityFrameworkCore
@using WorkOrderSystem.Data
@using WorkOrderSystem.Models
@using WorkOrderSystem.ViewModels.Reports
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@using System.Web
@using WorkOrderSystem.Components.Shared
@using WorkOrderSystem.Services
@using QRCoder
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.AspNetCore.Hosting
@using System.Threading.Tasks
@using System.Diagnostics

@attribute [Authorize]
@implements IAsyncDisposable
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider _authenticationStateProvider
@inject NavigationManager _navigationManager
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject IServiceProvider ServiceProvider
@inject IQuotationFileService QuotationFileSvc
@inject ILogger<WorkOrderDetail> _logger
@inject IWebHostEnvironment WebHostEnvironment
@inject HttpClient Http

<PageTitle>工單詳情</PageTitle>

@if (workOrder == null)
{
    <div class="d-flex flex-column align-items-center justify-content-center bg-light" style="height: 100vh; margin: -1rem;">
        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
        <h5 class="text-secondary fw-bold">@loadingStatus</h5>

        @if (isDebugMode && !string.IsNullOrEmpty(detailedLog))
        {
            <div class="mt-4 p-3 bg-dark text-light rounded-3 text-start shadow" style="font-family: monospace; white-space: pre-wrap; font-size: 0.85rem; max-width: 90%; width: 600px;">
                <div class="text-warning mb-2 fw-bold"><i class="bi bi-terminal"></i> 系統診斷日誌</div>
                @detailedLog
            </div>
        }
    </div>
}
else
{
    @* --- 📱 專屬 APP 頂部導覽列 (僅手機版顯示) --- *@
    <div class="d-lg-none sticky-top bg-white border-bottom shadow-sm d-flex align-items-center justify-content-between px-2" style="height: 60px; z-index: 1030; margin-top: -1rem; margin-left: -1rem; margin-right: -1rem;">
        <button type="button" class="btn btn-link text-dark p-2" @onclick="GoBack"><i class="bi bi-arrow-left fs-4"></i></button>
        <div class="text-center overflow-hidden flex-grow-1 px-2">
            <div class="fw-bold text-truncate text-primary fs-6" style="line-height: 1.2;">@workOrder.CustomerName</div>
            <div class="text-muted small text-truncate" style="font-size: 0.75rem;">#@workOrder.Id.ToString("D6") | @workOrder.Title</div>
        </div>
        <div class="dropdown">
            <button class="btn btn-link text-dark p-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-three-dots-vertical fs-4"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                @if (isManager || isSupervisor)
                {
                    <li><button type="button" class="dropdown-item py-2 fw-bold" @onclick="ToggleUserView"><i class="bi @(isManagementView ? "bi-person-gear text-primary" : "bi-tools text-success") me-2"></i>切換視角</button></li>
                    <li><button type="button" class="dropdown-item py-2 fw-bold" @onclick="OpenScheduleModal"><i class="bi bi-calendar-event text-success me-2"></i>施工排程</button></li>
                }
                <li><button type="button" class="dropdown-item py-2 fw-bold" @onclick='() => _navigationManager.NavigateTo($"/workorders/{WorkOrderId}/logs", true)'><i class="bi bi-journal-text text-info me-2"></i>工作日誌</button></li>
                @if (canEdit)
                {
                    <li><button type="button" class="dropdown-item py-2 fw-bold" @onclick='() => _navigationManager.NavigateTo($"/workorders/edit/{WorkOrderId}", true)'><i class="bi bi-pencil-fill text-secondary me-2"></i>編輯工單</button></li>
                }
                <li><hr class="dropdown-divider"></li>
                <li><button type="button" class="dropdown-item py-2 fw-bold text-danger" @onclick="ExportToPdfAsync" disabled="@isGeneratingPdf"><i class="bi bi-file-pdf-fill me-2"></i>匯出 PDF</button></li>
            </ul>
        </div>
    </div>

    @* --- 💻 PC 版頂部操作列 (僅大螢幕顯示) --- *@
    <div class="d-none d-lg-flex justify-content-between align-items-center mb-4 sticky-top bg-light py-3 border-bottom shadow-sm rounded-bottom-4 px-4" style="z-index: 1020; margin-top: -1rem; margin-left: -1.5rem; margin-right: -1.5rem;">
        <div class="d-flex flex-column">
            <div class="d-flex align-items-center gap-2 mb-1">
                <button type="button" class="btn btn-sm btn-white border shadow-sm rounded-pill px-3 fw-bold" @onclick="GoBack"><i class="bi bi-arrow-left"></i> 返回列表</button>
                <span class="badge bg-secondary rounded-pill px-3 py-2 fs-6 shadow-sm">工單 #@workOrder.Id.ToString("D6")</span>
                <span class="badge @GetStatusBadgeClass(workOrder.Status) rounded-pill px-3 py-2 fs-6 shadow-sm">@workOrder.Status</span>
            </div>
            <h3 class="mb-0 fw-bold mt-2 text-dark">
                <span class="text-primary">@workOrder.CustomerName</span><span class="text-secondary mx-2 opacity-50">|</span>@workOrder.Title
            </h3>
        </div>
        <div class="d-flex gap-2">
            @if (isManager || isSupervisor)
            {
                <button type="button" class="btn @(isManagementView ? "btn-outline-primary" : "btn-outline-success") shadow-sm fw-bold rounded-pill px-3" @onclick="ToggleUserView">
                    <i class="bi @(isManagementView ? "bi-person-gear" : "bi-tools") me-1"></i>@(isManagementView ? "切換: 工程師" : "切換: 管理者")
                </button>
                <button type="button" class="btn btn-success shadow-sm fw-bold rounded-pill px-3" @onclick="OpenScheduleModal"><i class="bi bi-calendar-event"></i> 排程</button>
            }
            <button type="button" class="btn btn-info shadow-sm fw-bold text-dark rounded-pill px-3" @onclick='() => _navigationManager.NavigateTo($"/workorders/{WorkOrderId}/logs", true)'><i class="bi bi-journal-text"></i> 日誌</button>
            @if (canEdit) 
            { 
                <button type="button" class="btn btn-secondary shadow-sm fw-bold rounded-pill px-3" @onclick='() => _navigationManager.NavigateTo($"/workorders/edit/{WorkOrderId}", true)'><i class="bi bi-pencil-fill"></i> 編輯</button> 
            }
            <button type="button" class="btn btn-danger shadow-sm fw-bold rounded-pill px-4" @onclick="ExportToPdfAsync" disabled="@isGeneratingPdf">
                @if (isGeneratingPdf) 
                { 
                    <span class="spinner-border spinner-border-sm me-1"></span> <span>處理中...</span> 
                } 
                else 
                { 
                    <i class="bi bi-file-pdf-fill me-1"></i> <span>PDF</span> 
                }
            </button>
        </div>
    </div>

    @* --- 🌟 主內容區 --- *@
    <div class="row g-4 app-content-padding">
        
        @* 📂 左側/上方 (基本資料與照片，PDF 匯出範圍) *@
        <div class="col-lg-8">
            <div id="workOrderSheet" class="d-flex flex-column gap-3 gap-lg-4">
                
                @* 📌 基本資訊卡片 *@
                <div class="card border-0 shadow-sm edge-to-edge-mobile">
                    <div class="card-header bg-white border-bottom-0 pt-3 pt-lg-4 px-3 px-lg-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-info-square-fill me-2"></i>案件資訊</h5>
                            <span class="badge @GetStatusBadgeClass(workOrder.Status) d-lg-none rounded-pill px-3 py-2">@workOrder.Status</span>
                        </div>
                    </div>
                    <div class="card-body px-3 px-lg-4 pb-4">
                        <div class="row g-3 fs-6">
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-3 border h-100">
                                    <small class="text-muted d-block fw-bold mb-1"><i class="bi bi-calendar-check me-1"></i>施工排程</small>
                                    @if (workOrder.ScheduledStartDate.HasValue && workOrder.ScheduledEndDate.HasValue)
                                    {
                                        var start = workOrder.ScheduledStartDate.Value.ToString("yyyy-MM-dd");
                                        var end = workOrder.ScheduledEndDate.Value.ToString("yyyy-MM-dd");
                                        <span class="fw-bold text-success fs-5">@(start == end ? start : $"{start} ~ {end}")</span>
                                    }
                                    else 
                                    { 
                                        <span class="text-muted">尚未排程</span> 
                                    }
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-3 border h-100">
                                    <small class="text-muted d-block fw-bold mb-1"><i class="bi bi-person-lines-fill me-1"></i>聯絡資訊</small>
                                    <div class="fw-bold">@(workOrder.ContactPerson ?? "N/A")</div>
                                    <a href="tel:@workOrder.ContactPhone" class="text-primary fw-bold text-decoration-none d-block mt-1"><i class="bi bi-telephone-fill me-1"></i>@(workOrder.ContactPhone ?? "N/A")</a>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="p-3 bg-light rounded-3 border">
                                    <small class="text-muted d-block fw-bold mb-1"><i class="bi bi-geo-alt-fill me-1"></i>施工地址</small>
                                    @if (string.IsNullOrWhiteSpace(workOrder.Address)) 
                                    { 
                                        <span class="text-muted">N/A</span> 
                                    }
                                    else
                                    {
                                        <a href="@($"https://www.google.com/maps/search/?api=1&query={WebUtility.UrlEncode(workOrder.Address)}")" target="_blank" class="fw-bold text-dark text-decoration-none d-block">
                                            @workOrder.Address <i class="bi bi-box-arrow-up-right text-primary ms-1"></i>
                                        </a>
                                        @if (!string.IsNullOrEmpty(workOrder.SurveyAddress)) 
                                        { 
                                            <div class="text-muted mt-2 pt-2 border-top small"><i class="bi bi-geo"></i> 座標：@workOrder.SurveyAddress</div> 
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-card-text me-1"></i>案件描述</h6>
                            <div class="p-3 bg-white border rounded-3 text-dark" style="white-space: pre-wrap; font-size: 1.05rem; line-height: 1.6;">@workOrder.Description</div>
                        </div>

                        @if (!string.IsNullOrEmpty(RejectionReason))
                        {
                            <div class="alert alert-danger mt-4 border-0 rounded-3 shadow-sm">
                                <h6 class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>退回原因</h6>
                                <div class="bg-white bg-opacity-50 p-2 rounded text-dark" style="white-space: pre-wrap;">@RejectionReason</div>
                            </div>
                        }

                        @if (!isManagementView)
                        {
                            <div class="mt-4">
                                <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-people-fill me-1"></i>團隊成員</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var a in workOrder.Assignments.OrderByDescending(a => a.IsPrimary))
                                    {
                                        <div class="badge @(a.IsPrimary ? "bg-primary" : "bg-secondary") rounded-pill px-3 py-2 fs-6 shadow-sm">
                                            <i class="bi @(a.IsPrimary ? "bi-star-fill text-warning" : "bi-person-fill") me-1"></i> @a.User.FullName
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* 📌 施工回報與照片畫廊 *@
                <div class="card border-0 shadow-sm edge-to-edge-mobile">
                    <div class="card-header bg-white border-bottom-0 pt-3 pt-lg-4 px-3 px-lg-4">
                        <h5 class="fw-bold text-success mb-0"><i class="bi bi-tools me-2"></i>回報與照片庫</h5>
                    </div>
                    <div class="card-body px-3 px-lg-4 pb-4">
                        
                        <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 mb-4" style="font-size: 1.05rem; line-height: 1.6;">
                            @if (string.IsNullOrEmpty(workOrder.EngineerNotes)) 
                            { 
                                <span class="text-muted">尚未填寫回報內容</span> 
                            }
                            else
                            {
                                @foreach (var line in workOrder.EngineerNotes.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None))
                                {
                                    if (!string.IsNullOrWhiteSpace(line) && (line.Trim().StartsWith("位置:") || line.Contains(" 位置: ")))
                                    {
                                        var address = line.Replace("位置:", "").Replace("位置 :", "").Trim();
                                        <div class="mb-1 p-2 bg-white rounded shadow-sm border border-primary border-opacity-25 d-inline-block">
                                            <strong class="text-secondary"><i class="bi bi-geo-alt-fill text-danger me-1"></i>位置: </strong>
                                            <a href="@($"https://www.google.com/maps/search/?api=1&query={System.Net.WebUtility.UrlEncode(address)}")" target="_blank" @onclick:stopPropagation="true" class="text-decoration-none fw-bold text-primary">@address</a>
                                        </div>
                                    }
                                    else 
                                    { 
                                        <div style="min-height: 1.5rem;">@line</div> 
                                    }
                                }
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(workOrder.ClientSignature))
                        {
                            <div class="mb-4 text-center p-3 bg-light rounded-3 border">
                                <h6 class="text-secondary fw-bold mb-2">客戶簽收確認</h6>
                                <img src="@workOrder.ClientSignature" class="img-fluid bg-white p-2 rounded shadow-sm" style="max-height: 100px;" alt="客戶簽名" />
                            </div>
                        }

                        <hr class="my-4 text-secondary opacity-25" />

                        @* 📷 APP 風格照片庫 *@
                        <div class="no-print">
                            @if (!orderedPhotos.Any())
                            {
                                <div class="text-center p-4 bg-light rounded-3 border border-dashed text-muted"><i class="bi bi-images fs-2 d-block mb-2"></i>無照片</div>
                            }
                            else
                            {
                                @* 1. 申請附件區塊 *@
                                @if (requestPhotos.Any())
                                {
                                    <div class="mb-4 bg-light p-3 rounded-4 border border-secondary border-opacity-25">
                                        <h6 class="fw-bold text-secondary mb-3 border-bottom border-secondary border-opacity-25 pb-2">
                                            <i class="bi bi-paperclip me-2"></i>申請附件 <span class="badge bg-secondary rounded-pill ms-2">@requestPhotos.Count</span>
                                        </h6>
                                        <div class="row g-2 row-cols-2 row-cols-md-3 row-cols-lg-4">
                                            @foreach (var photo in requestPhotos)
                                            {
                                                <div class="col" @key="photo.Id">
                                                    <div class="card h-100 border-0 shadow-sm overflow-hidden rounded-3 position-relative">
                                                        @if (IsVideoFile(photo.FilePath))
                                                        {
                                                            <div class="bg-dark d-flex flex-column justify-content-center align-items-center w-100" style="aspect-ratio: 1/1;">
                                                                <video src="@photo.FilePath" class="w-100 h-100 object-fit-contain" controls preload="metadata"></video>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="photo-thumbnail-btn w-100 h-100 p-0 m-0" @onclick="@(() => OpenGallery(photo))">
                                                                <img src="@photo.FilePath" class="img-fluid w-100 h-100 object-fit-cover" style="aspect-ratio: 1/1;" alt="@photo.Category" />
                                                            </button>
                                                        }
                                                        
                                                        @if (isPartOfAssignmentTeam && workOrder.Status != "已完成")
                                                        {
                                                            <button type="button" class="btn btn-danger position-absolute top-0 end-0 m-1 shadow-sm d-flex align-items-center justify-content-center" 
                                                                    @onclick="() => DeletePhotoAsync(photo.Id)" 
                                                                    @onclick:stopPropagation="true" 
                                                                    @onclick:preventDefault="true"
                                                                    style="z-index: 10; width: 36px; height: 36px; border-radius: 50%; padding: 0; opacity: 0.9;">
                                                                <i class="bi bi-trash-fill fs-6"></i>
                                                            </button>
                                                        }
                                                        
                                                        <div class="position-absolute bottom-0 start-0 w-100 p-1 bg-dark bg-opacity-75 text-white text-center small pointer-events-none" style="font-size: 0.75rem;">
                                                            @photo.Category
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(photo.CustomNote))
                                                    {
                                                        <div class="mt-1 text-center small text-muted text-truncate px-1" title="@photo.CustomNote">@photo.CustomNote</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @* 2. 施工過程區塊 *@
                                @if (processPhotos.Any())
                                {
                                    <div class="mb-4 bg-light p-3 rounded-4 border border-info border-opacity-25">
                                        <h6 class="fw-bold text-info mb-3 border-bottom border-info border-opacity-25 pb-2">
                                            <i class="bi bi-camera-fill me-2"></i>施工過程 <span class="badge bg-info rounded-pill ms-2">@processPhotos.Count</span>
                                        </h6>
                                        <div class="row g-2 row-cols-2 row-cols-md-3 row-cols-lg-4">
                                            @foreach (var photo in processPhotos)
                                            {
                                                <div class="col" @key="photo.Id">
                                                    <div class="card h-100 border-0 shadow-sm overflow-hidden rounded-3 position-relative">
                                                        @if (IsVideoFile(photo.FilePath))
                                                        {
                                                            <div class="bg-dark d-flex flex-column justify-content-center align-items-center w-100" style="aspect-ratio: 1/1;">
                                                                <video src="@photo.FilePath" class="w-100 h-100 object-fit-contain" controls preload="metadata"></video>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="photo-thumbnail-btn w-100 h-100 p-0 m-0" @onclick="@(() => OpenGallery(photo))">
                                                                <img src="@photo.FilePath" class="img-fluid w-100 h-100 object-fit-cover" style="aspect-ratio: 1/1;" alt="@photo.Category" />
                                                            </button>
                                                        }
                                                        
                                                        @if (isPartOfAssignmentTeam && workOrder.Status != "已完成")
                                                        {
                                                            <button type="button" class="btn btn-danger position-absolute top-0 end-0 m-1 shadow-sm d-flex align-items-center justify-content-center" 
                                                                    @onclick="() => DeletePhotoAsync(photo.Id)" 
                                                                    @onclick:stopPropagation="true" 
                                                                    @onclick:preventDefault="true"
                                                                    style="z-index: 10; width: 36px; height: 36px; border-radius: 50%; padding: 0; opacity: 0.9;">
                                                                <i class="bi bi-trash-fill fs-6"></i>
                                                            </button>
                                                        }
                                                        
                                                        <div class="position-absolute bottom-0 start-0 w-100 p-1 bg-dark bg-opacity-75 text-white text-center small pointer-events-none" style="font-size: 0.75rem;">
                                                            @photo.Category
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(photo.CustomNote))
                                                    {
                                                        <div class="mt-1 text-center small text-muted text-truncate px-1" title="@photo.CustomNote">@photo.CustomNote</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @* 3. 完工成果區塊 *@
                                @if (completionPhotos.Any())
                                {
                                    <div class="mb-4 bg-light p-3 rounded-4 border border-success border-opacity-25">
                                        <h6 class="fw-bold text-success mb-3 border-bottom border-success border-opacity-25 pb-2">
                                            <i class="bi bi-check-circle-fill me-2"></i>完工成果 <span class="badge bg-success rounded-pill ms-2">@completionPhotos.Count</span>
                                        </h6>
                                        <div class="row g-2 row-cols-2 row-cols-md-3 row-cols-lg-4">
                                            @foreach (var photo in completionPhotos)
                                            {
                                                <div class="col" @key="photo.Id">
                                                    <div class="card h-100 border-0 shadow-sm overflow-hidden rounded-3 position-relative">
                                                        @if (IsVideoFile(photo.FilePath))
                                                        {
                                                            <div class="bg-dark d-flex flex-column justify-content-center align-items-center w-100" style="aspect-ratio: 1/1;">
                                                                <video src="@photo.FilePath" class="w-100 h-100 object-fit-contain" controls preload="metadata"></video>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="photo-thumbnail-btn w-100 h-100 p-0 m-0" @onclick="@(() => OpenGallery(photo))">
                                                                <img src="@photo.FilePath" class="img-fluid w-100 h-100 object-fit-cover" style="aspect-ratio: 1/1;" alt="@photo.Category" />
                                                            </button>
                                                        }
                                                        
                                                        @if (isPartOfAssignmentTeam && workOrder.Status != "已完成")
                                                        {
                                                            <button type="button" class="btn btn-danger position-absolute top-0 end-0 m-1 shadow-sm d-flex align-items-center justify-content-center" 
                                                                    @onclick="() => DeletePhotoAsync(photo.Id)" 
                                                                    @onclick:stopPropagation="true" 
                                                                    @onclick:preventDefault="true"
                                                                    style="z-index: 10; width: 36px; height: 36px; border-radius: 50%; padding: 0; opacity: 0.9;">
                                                                <i class="bi bi-trash-fill fs-6"></i>
                                                            </button>
                                                        }
                                                        
                                                        <div class="position-absolute bottom-0 start-0 w-100 p-1 bg-dark bg-opacity-75 text-white text-center small pointer-events-none" style="font-size: 0.75rem;">
                                                            @photo.Category
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(photo.CustomNote))
                                                    {
                                                        <div class="mt-1 text-center small text-muted text-truncate px-1" title="@photo.CustomNote">@photo.CustomNote</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @* 4. 施工日誌紀錄區塊 (不顯示刪除按鈕) *@
                                @if (logDisplayPhotos.Any())
                                {
                                    <div class="mb-4 bg-light p-3 rounded-4 border border-primary border-opacity-25">
                                        <h6 class="fw-bold text-primary mb-3 border-bottom border-primary border-opacity-25 pb-2">
                                            <i class="bi bi-journal-text me-2"></i>日誌紀錄 <span class="badge bg-primary rounded-pill ms-2">@logDisplayPhotos.Count</span>
                                        </h6>
                                        <div class="row g-2 row-cols-2 row-cols-md-3 row-cols-lg-4">
                                            @foreach (var photo in logDisplayPhotos)
                                            {
                                                <div class="col" @key="photo.Id">
                                                    <div class="card h-100 border-0 shadow-sm overflow-hidden rounded-3 position-relative">
                                                        @if (IsVideoFile(photo.FilePath))
                                                        {
                                                            <div class="bg-dark d-flex flex-column justify-content-center align-items-center w-100" style="aspect-ratio: 1/1;">
                                                                <video src="@photo.FilePath" class="w-100 h-100 object-fit-contain" controls preload="metadata"></video>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="photo-thumbnail-btn w-100 h-100 p-0 m-0" @onclick="@(() => OpenGallery(photo))">
                                                                <img src="@photo.FilePath" class="img-fluid w-100 h-100 object-fit-cover" style="aspect-ratio: 1/1;" alt="@photo.Category" />
                                                            </button>
                                                        }
                                                        
                                                        <div class="position-absolute bottom-0 start-0 w-100 p-1 bg-dark bg-opacity-75 text-white text-center small pointer-events-none" style="font-size: 0.75rem;">
                                                            @photo.Category
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(photo.CustomNote))
                                                    {
                                                        <div class="mt-1 text-center small text-muted text-truncate px-1" title="@photo.CustomNote">@photo.CustomNote</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="only-print text-center mt-4">
                            @if (!string.IsNullOrEmpty(qrCodeAsBase64))
                            {
                                <img src="@qrCodeAsBase64" style="width: 150px; height: 150px;" alt="QR Code" />
                                <p class="mt-2 fw-bold fs-6">掃描 QR Code 下載附件</p>
                            }
                        </div>
                    </div>
                </div>
            </div> @* end of #workOrderSheet *@

            @* 📌 關聯報價單 (獨立在 PDF 之外) *@
            <div class="card border-0 shadow-sm edge-to-edge-mobile mt-4">
                <div class="card-header bg-white border-bottom-0 pt-3 pt-lg-4 px-3 px-lg-4">
                    <h5 class="fw-bold text-info text-darken mb-0"><i class="bi bi-file-earmark-spreadsheet-fill me-2"></i>關聯報價單</h5>
                </div>
                <div class="card-body px-3 px-lg-4 pb-4">
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <span class="text-muted fw-bold small mb-1 d-block">目前綁定檔案</span>
                        @if (!string.IsNullOrWhiteSpace(workOrder.RelatedQuotationFileName))
                        {
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="fw-bold text-primary text-break me-2">@workOrder.RelatedQuotationFileName</span>
                                <button type="button" class="btn btn-info btn-sm shadow-sm rounded-circle flex-shrink-0" @onclick="PreviewAssociatedQuotationAsync" disabled="@isPreviewingQuotation" title="預覽">
                                    @if (isPreviewingQuotation) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-eye-fill text-white"></i> }
                                </button>
                            </div>
                        }
                        else { <span class="text-muted">尚未綁定</span> }
                    </div>

                    @if (canEdit)
                    {
                        <div class="bg-white p-3 rounded-3 border shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="filterCustomerCheck" checked="@filterQuotationsByCustomer" @onchange="OnFilterCustomerChangedAsync" disabled="@isLoadingQuotations" />
                                    <label class="form-check-label fw-bold text-secondary small" for="filterCustomerCheck">僅限本客戶</label>
                                </div>
                                <select class="form-select form-select-sm w-auto bg-light" value="@selectedQuotationYear" @onchange="OnQuotationYearChanged" disabled="@isLoadingQuotations">
                                    @foreach (var y in quotationYearOptions) { <option value="@y">@y</option> }
                                </select>
                            </div>

                            <div class="input-group shadow-sm">
                                <InputSelect id="quotationSelect" class="form-select bg-light" Value="@selectedQuotationFileNameForEdit" ValueChanged="@((string s) => OnQuotationSelectedAsync(s))" ValueExpression="@(() => selectedQuotationFileNameForEdit)" disabled="@(isLoadingQuotations || isSavingQuotationLink)">
                                    <option value="">-- 請選擇報價單 --</option>
                                    @if (isLoadingQuotations) { <option disabled>讀取中...</option> }
                                    else if (availableQuotations != null) { foreach (var quote in availableQuotations) { <option value="@quote.Value">@quote.DisplayText</option> } }
                                </InputSelect>
                                <button class="btn btn-dark px-3" type="button" @onclick="PreviewSelectedQuotationAsync" disabled="@(isLoadingQuotations || isPreviewingQuotation || string.IsNullOrWhiteSpace(selectedQuotationFileNameForEdit))"><i class="bi bi-eye"></i></button>
                                <button class="btn btn-primary px-3 fw-bold" type="button" @onclick="SaveQuotationLinkAsync" disabled="@(isLoadingQuotations || isSavingQuotationLink)">
                                    @if (isSavingQuotationLink) { <span class="spinner-border spinner-border-sm"></span> } else { <span>綁定</span> }
                                </button>
                            </div>
                            @if (isReadingContactInfo) { <div class="text-info small mt-2"><span class="spinner-border spinner-border-sm me-1"></span>讀取表頭中...</div> }
                            @if (!string.IsNullOrEmpty(contactInfoMessage)) { <div class="text-primary small fw-bold mt-2">@contactInfoMessage</div> }
                            @if (!string.IsNullOrWhiteSpace(quotationSaveMessage)) { <div class="small fw-bold mt-2 @(quotationSaveSuccess ? "text-success" : "text-danger")">@quotationSaveMessage</div> }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* 📂 右側/下方 (操作專區 Action Center) *@
        <div class="col-lg-4" id="action-center">
            <div class="position-sticky" style="top: 100px; z-index: 10;">
                
                @if (isManagementView)
                {
                    @if (isManager && (workOrder.Status == "待指派" || workOrder.Status == "已退回" || workOrder.Status == "處理中"))
                    {
                        <div class="card border-0 shadow-sm edge-to-edge-mobile mb-4 border-top border-4 border-primary">
                            <div class="card-header bg-white border-bottom pt-3 pb-2 px-3 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-person-plus-fill me-2"></i>指派工程師</h6>
                                @if (isEditingAssignment && workOrder.Assignments.Any()) { <button type="button" class="btn btn-sm btn-light rounded-pill" @onclick="ToggleAssignmentEdit">取消</button> }
                            </div>
                            <div class="card-body p-3 bg-light bg-opacity-50">
                                @if (isEditingAssignment)
                                {
                                    <EditForm Model="assignmentFormModel" OnValidSubmit="AssignWorkOrderAsync" FormName="AssignForm">
                                        <DataAnnotationsValidator />
                                        <div class="bg-white border rounded-3 p-2 mb-3 shadow-sm" style="max-height: 300px; overflow-y: auto;">
                                            <InputRadioGroup @bind-Value="assignmentFormModel.PrimaryEngineerId">
                                                @foreach (var engineer in engineers)
                                                {
                                                    var isSelected = assignmentFormModel.SelectedEngineers.GetValueOrDefault(engineer.Id);
                                                    <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
                                                        <div class="form-check mb-0">
                                                            <input type="checkbox" class="form-check-input" id="@($"assign-{engineer.Id}")" checked="@isSelected" @onchange="@((ChangeEventArgs e) => AssigneeSelectionChanged(e, engineer.Id))" />
                                                            <label for="@($"assign-{engineer.Id}")" class="form-check-label ms-1 fw-bold">@engineer.FullName</label>
                                                        </div>
                                                        <div class="form-check mb-0">
                                                            <InputRadio id="@($"primary-{engineer.Id}")" Value="@engineer.Id" class="form-check-input" disabled="@(!isSelected)" />
                                                            <label for="@($"primary-{engineer.Id}")" class="form-check-label small text-muted">主要</label>
                                                        </div>
                                                    </div>
                                                }
                                            </InputRadioGroup>
                                        </div>
                                        <ValidationSummary class="text-danger small" />
                                        @if (!string.IsNullOrEmpty(errorMessage)) { <div class="alert alert-danger py-2 px-3 small">@errorMessage</div> }
                                        <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm rounded-pill py-2">確認指派</button>
                                    </EditForm>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-2 mb-3">
                                        @foreach (var a in workOrder.Assignments.OrderByDescending(a => a.IsPrimary))
                                        {
                                            <div class="d-flex justify-content-between align-items-center bg-white p-2 px-3 border rounded-pill shadow-sm">
                                                <span class="fw-bold">@a.User.FullName</span>
                                                @if (a.IsPrimary) { <span class="badge bg-primary rounded-pill">主要</span> }
                                            </div>
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline-primary w-100 fw-bold rounded-pill" @onclick="ToggleAssignmentEdit"><i class="bi bi-pencil me-1"></i>重新指派</button>
                                }
                            </div>
                        </div>
                    }

                    @if (isSupervisor && workOrder.Status == "待主管審核")
                    {
                        <div class="card border-0 shadow-sm edge-to-edge-mobile mb-4 border-top border-4 border-warning">
                            <div class="card-body p-4">
                                <button type="button" class="btn btn-success w-100 fw-bold rounded-pill shadow mb-4 py-3 fs-5" @onclick="HandleApprovalAsync"><i class="bi bi-check-circle-fill me-2"></i>審核通過</button>
                                <EditForm Model="actionModel" OnValidSubmit="HandleRejectionAsync" FormName="RejectionForm">
                                    <DataAnnotationsValidator />
                                    <InputTextArea class="form-control mb-3 bg-light" rows="3" @bind-Value="actionModel.Notes" placeholder="必須填寫退回原因" />
                                    <ValidationMessage For="@(() => actionModel.Notes)" class="text-danger small mb-2" />
                                    <button type="submit" class="btn btn-outline-danger w-100 fw-bold rounded-pill shadow-sm">退回給工程師</button>
                                </EditForm>
                            </div>
                        </div>
                    }

                    @if (isManager && workOrder.Status == "待管理者核銷")
                    {
                        <div class="card border-0 shadow-sm edge-to-edge-mobile mb-4 border-top border-4 border-info">
                            <div class="card-body p-4">
                                <button type="button" class="btn btn-info w-100 fw-bold text-dark rounded-pill shadow mb-4 py-3 fs-5" @onclick="HandleWriteOffAsync"><i class="bi bi-check-all me-2"></i>確認核銷結案</button>
                                <EditForm Model="actionModel" OnValidSubmit="HandleManagerRejectionAsync" FormName="ManagerRejectionForm">
                                    <DataAnnotationsValidator />
                                    <InputTextArea class="form-control mb-3 bg-light" rows="3" @bind-Value="actionModel.Notes" placeholder="必須填寫退回原因" />
                                    <ValidationMessage For="@(() => actionModel.Notes)" class="text-danger small mb-2" />
                                    <button type="submit" class="btn btn-outline-danger w-100 fw-bold rounded-pill shadow-sm">退回給主管重審</button>
                                </EditForm>
                            </div>
                        </div>
                    }
                }

                @if (!isManagementView)
                {
                    @if (isPartOfAssignmentTeam && (workOrder.Status == "處理中" || workOrder.Status == "待主管審核"))
                    {
                        <div class="card border-0 shadow-sm edge-to-edge-mobile mb-4 border-top border-4 border-success pb-5 pb-lg-0">
                            <div class="card-header bg-white pt-3 pb-2 px-3"><h5 class="fw-bold text-success mb-0"><i class="bi bi-send-check-fill me-2"></i>回報專區</h5></div>
                            <div class="card-body p-3 bg-light">

                                <EditForm Model="workOrder" OnValidSubmit="HandleCompletionSubmitAsync" FormName="CompletionForm">
                                    <DataAnnotationsValidator />
                                    
                                    @if (myDrafts != null && myDrafts.Any())
                                    {
                                        <div class="bg-white p-3 rounded-3 shadow-sm border mb-4">
                                            <div class="input-group input-group-sm">
                                                <select class="form-select bg-light" @bind="selectedDraftId" disabled="@isImportingDraft">
                                                    <option value="0">-- 匯入暫存草稿 --</option>
                                                    @foreach (var draft in myDrafts) { <option value="@draft.Id">@draft.CreatedAt.ToString("MM/dd") - @draft.Title</option> }
                                                </select>
                                                <button class="btn btn-secondary fw-bold px-3" type="button" @onclick="ImportDraftAsync" disabled="@(selectedDraftId == 0 || isImportingDraft)">
                                                    @if (isImportingDraft) { <span class="spinner-border spinner-border-sm"></span> } else { <span>匯入</span> }
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    <div class="mb-4">
                                        <small class="fw-bold text-secondary d-block mb-2">客戶簽名</small>
                                        @if (string.IsNullOrEmpty(capturedSignatureData))
                                        {
                                            <button type="button" class="btn btn-white w-100 shadow-sm border-dashed py-3 rounded-4 fw-bold text-primary" @onclick="OpenSignatureModal">
                                                <i class="bi bi-pencil-square fs-3 d-block mb-1"></i> 點擊簽名
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="text-center border p-2 bg-white rounded-4 shadow-sm position-relative">
                                                <img src="@capturedSignatureData" class="img-fluid" style="max-height: 80px;" alt="簽名" />
                                                <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 rounded-circle" @onclick="() => capturedSignatureData = null"><i class="bi bi-x"></i></button>
                                            </div>
                                        }
                                    </div>

                                    <div class="mb-4">
                                        <small class="fw-bold text-secondary d-block mb-2">施工備註內容</small>
                                        <InputTextArea class="form-control bg-white shadow-sm border-0 rounded-4" @bind-Value="workOrder.EngineerNotes" rows="5" placeholder="輸入維修狀況、使用料件..." />
                                    </div>

                                    <div class="mb-4">
                                        <small class="fw-bold text-secondary d-block mb-2">上傳照片</small>
                                        <div class="d-flex gap-2">
                                            <InputFile OnChange="HandleFileSelected" capture="environment" class="d-none" id="cameraInput" accept="image/*" disabled="@isProcessingPhotos" />
                                            <InputFile OnChange="HandleFileSelected" multiple class="d-none" id="galleryInput" accept="image/jpeg, image/png, image/webp" disabled="@isProcessingPhotos" />

                                            <button type="button" class="btn btn-dark flex-grow-1 shadow-sm fw-bold rounded-4 py-3" onclick="document.getElementById('cameraInput').click()" disabled="@isProcessingPhotos">
                                                <i class="bi bi-camera fs-4 d-block"></i> 拍照
                                            </button>
                                            <button type="button" class="btn btn-secondary flex-grow-1 shadow-sm fw-bold rounded-4 py-3" onclick="document.getElementById('galleryInput').click()" disabled="@isProcessingPhotos">
                                                <i class="bi bi-images fs-4 d-block"></i> 相簿
                                            </button>
                                        </div>
                                        @if (isProcessingPhotos) { <div class="mt-2 text-center small text-primary fw-bold">處理中... (@filesProcessed / @totalFilesToProcess)</div> }
                                    </div>

                                    @if (previewPhotos.Any())
                                    {
                                        <div class="bg-white p-3 rounded-4 shadow-sm border mb-4">
                                            <small class="fw-bold text-primary d-block mb-3">待上傳 (@previewPhotos.Count)</small>
                                            <div class="d-flex flex-column gap-3">
                                                @foreach (var photo in previewPhotos)
                                                {
                                                    <div class="d-flex gap-3 align-items-center bg-light p-2 rounded-3 border" @key="photo.Id">
                                                        <div class="position-relative flex-shrink-0" style="width: 70px; height: 70px;">
                                                            <img src="@photo.Base64Data" class="w-100 h-100 object-fit-cover rounded shadow-sm" />
                                                            <button type="button" class="btn btn-danger btn-sm position-absolute top-0 start-0 translate-middle rounded-circle shadow" style="width:22px; height:22px; padding:0; z-index:5;" @onclick="() => RemovePhoto(photo.Id)"><i class="bi bi-x"></i></button>
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <InputSelect @bind-Value="photo.Category" class="form-select form-select-sm border-0 shadow-sm fw-bold text-primary mb-1">
                                                                <option value="施工中">施工中</option>
                                                                <option value="施工前">施工前</option>
                                                                <option value="施工後">施工後</option>
                                                                <option value="自行備註">自訂</option>
                                                            </InputSelect>
                                                            @if (photo.Category == "自行備註") { <InputText @bind-Value="photo.CustomNote" class="form-control form-control-sm border-0 shadow-sm" placeholder="輸入備註..."></InputText> }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(errorMessage)) { <div class="alert alert-danger py-2 px-3 small shadow-sm">@errorMessage</div> }
                                    
                                    @if (isUploading)
                                    {
                                        <div class="mb-4">
                                            <p class="text-center mb-1 fw-bold text-primary small">上傳中... (@filesUploaded / @totalFilesToUpload)</p>
                                            <div class="progress" style="height: 8px;"><div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @((double)filesUploaded / totalFilesToUpload * 100)%"></div></div>
                                        </div>
                                    }

                                    <div class="d-flex flex-column gap-2 mt-4">
                                        <button type="submit" class="btn btn-success w-100 fw-bold rounded-pill shadow py-3 fs-5" disabled="@(isUploading || !isPrimaryAssignee)">
                                            @if (isUploading && isPrimaryAssignee) { <span class="spinner-border spinner-border-sm me-2"></span><span>處理中...</span> }
                                            else { <i class="bi bi-send-fill me-2"></i><span>@(workOrder.Status == "處理中" ? "回報完成 送審" : "更新回報內容")</span> }
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary w-100 fw-bold rounded-pill py-2" @onclick="SaveChangesAsync" disabled="@isUploading">
                                            <i class="bi bi-save me-1"></i> 僅暫存進度
                                        </button>
                                    </div>

                                    @if (!isPrimaryAssignee) { <div class="text-center text-muted small mt-3">僅主要負責人可提交審核</div> }

                                </EditForm>
                            </div>
                        </div>
                    }
                    else if (!IsAnyActionAvailable())
                    {
                        <div class="card border-0 shadow-sm edge-to-edge-mobile border-top border-4 border-secondary text-center p-5">
                            <i class="bi bi-lock-fill display-1 text-secondary opacity-25"></i>
                            <h5 class="fw-bold mt-3">無法操作</h5>
                            <p class="text-muted small">您非負責團隊，僅能檢視。</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* --- 📱 手機版底部懸浮按鈕 (Sticky Bottom Action Bar) --- *@
    @if (IsAnyActionAvailable())
    {
        <div class="d-lg-none position-fixed bottom-0 start-0 w-100 bg-white border-top shadow-lg p-3 d-flex justify-content-between align-items-center" style="z-index: 1040;">
            <div class="fw-bold text-dark small text-truncate pe-2">下一步動作</div>
            <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow flex-shrink-0" onclick="document.getElementById('action-center').scrollIntoView({behavior: 'smooth'})">
                <i class="bi bi-lightning-charge-fill me-1"></i> 處理工單
            </button>
        </div>
    }

    @* --- MODALS (簽名板) --- *@
    <div class="modal fade signature-modal" id="signatureModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-body p-0">
                    <SignaturePad @ref="signaturePadComponent" Module="signatureModule" OnConfirm="ConfirmSignature" OnCancel="CancelSignature" />
                </div>
            </div>
        </div>
    </div>

    @* --- MODALS (施工排程) --- *@
    <div class="modal fade" id="scheduleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header bg-success text-white px-4 pt-3 pb-2 border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-calendar-event me-2"></i>設定施工排程</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelScheduleModal"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <EditForm Model="scheduleFormModel" FormName="ScheduleForm">
                        <DataAnnotationsValidator />
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small">開始日期</label>
                                <InputDate class="form-control shadow-sm border-0" @bind-Value="scheduleFormModel.StartDate" @bind-Value:after="CheckConflictsAsync" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small">結束日期</label>
                                <InputDate class="form-control shadow-sm border-0" @bind-Value="scheduleFormModel.EndDate" @bind-Value:after="CheckConflictsAsync" />
                            </div>
                        </div>
                    </EditForm>

                    @if (isLoadingConflicts) { <div class="text-center text-primary small py-3"><span class="spinner-border spinner-border-sm me-2"></span>分析檔期衝突中...</div> }
                    else if (conflictingOrders != null)
                    {
                        if (conflictingOrders.Any())
                        {
                            <div class="alert alert-warning border-0 shadow-sm rounded-3 mt-3 p-3">
                                <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>該時段已有 @conflictingOrders.Count 張工單</h6>
                                <ul class="mb-0 ps-3 small">
                                    @foreach (var conflict in conflictingOrders) { <li>(@conflict.Id) @conflict.Title</li> }
                                </ul>
                            </div>
                        }
                        else { <div class="alert alert-success border-0 shadow-sm rounded-3 mt-3 fw-bold small text-center"><i class="bi bi-check-circle-fill me-2"></i>無衝突，完美空檔！</div> }
                    }
                </div>
                <div class="modal-footer border-top-0 bg-white rounded-bottom-4 px-4 pb-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CancelScheduleModal">取消</button>
                    <button type="button" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm" @onclick="SaveScheduleAsync" disabled="@isSavingSchedule">儲存</button>
                </div>
            </div>
        </div>
    </div>

    <PdfPreviewModal IsVisible="isPdfModalVisible" Base64Data="@pdfPreviewBase64Data" FileName="@pdfPreviewFileName" OnClose="() => isPdfModalVisible = false" />
    
    @if (isGalleryVisible) 
    { 
        <PhotoGallery Photos="orderedPhotos" StartIndex="galleryStartIndex" IsVisible="isGalleryVisible" OnClose="() => isGalleryVisible = false" /> 
    }
}

<style>
    /* 📱 APP 風格行動版優化 */
    @@media (max-width: 991.98px) {
        .edge-to-edge-mobile {
            margin-left: -0.5rem;
            margin-right: -0.5rem;
            border-radius: 0 !important;
            border-left: 0;
            border-right: 0;
        }
        .app-content-padding {
            padding-bottom: 90px; /* 避免內容被底部 Sticky Bar 擋住 */
        }
    }
    
    .border-dashed { border: 2px dashed #dee2e6 !important; }
    .pointer-events-none { pointer-events: none; }
    .photo-thumbnail-btn { padding: 0; border: none; background: none; transition: transform 0.2s; border-radius: 0.5rem; overflow: hidden; }
    .photo-thumbnail-btn:hover { transform: scale(1.03); z-index: 2; box-shadow: 0 5px 15px rgba(0,0,0,0.2); }
</style>

@code {
    [Parameter] 
    public int WorkOrderId { get; set; }
    
    private const int MaxAllowedFiles = 100;

    private WorkOrder? workOrder;
    private List<AppUser> engineers = new();

    private bool canEdit = false;
    private bool isManager = false;
    private bool isSupervisor = false;
    private bool isPrimaryAssignee = false;
    private bool isPartOfAssignmentTeam = false;
    
    private string? errorMessage;
