    private async Task UpdateWorkOrderStatusAsync(string s, string act, string? note = null, Action<WorkOrder>? addAct = null)
    {
        if (workOrder is null) return;
        await using var scope = ServiceProvider.CreateAsyncScope(); 
        var um = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>(); 
        var ln = scope.ServiceProvider.GetRequiredService<LineNotifyService>(); 
        var ctx = await scope.ServiceProvider.GetRequiredService<IDbContextFactory<ApplicationDbContext>>().CreateDbContextAsync();
        var u = await um.GetUserAsync((await _authenticationStateProvider.GetAuthenticationStateAsync()).User);
        var o = await ctx.WorkOrders.Include(w => w.Assignments).ThenInclude(a => a.User).FirstOrDefaultAsync(w => w.Id == workOrder.Id);
        
        if (o is null) return;
        
        o.Status = s; 
        o.UpdatedAt = DateTime.Now; 
        addAct?.Invoke(o);
        ctx.WorkOrderLogs.Add(new WorkOrderLog { WorkOrderId = o.Id, OperatorId = u?.Id, Action = act, Comment = note }); 
        await ctx.SaveChangesAsync();
        
        try
        {
            var p = o.Assignments.FirstOrDefault(a => a.IsPrimary)?.User; 
            var url = $"{Configuration["ApplicationSettings:BaseUrl"]}/workorders/details/{o.Id}?openExternalBrowser=1";
            if (act == "主管審核通過") 
            { 
                if (p != null && !string.IsNullOrEmpty(p.LineUserId)) await ln.SendPushMessageAsync(p.LineUserId, $"案件進度：主管審核通過。\n{url}"); 
                foreach (var m in await um.Users.Where(x => x.IsManager && !string.IsNullOrEmpty(x.LineUserId)).ToListAsync()) _ = ln.SendPushMessageAsync(m.LineUserId, $"待核銷：{o.Title}\n{url}"); 
            }
            else if (act == "主管審核退回") 
            { 
                if (p != null && !string.IsNullOrEmpty(p.LineUserId)) await ln.SendPushMessageAsync(p.LineUserId, $"被退回：{note}\n{url}"); 
            }
            else if (act == "管理者退回重審") 
            { 
                if (p != null && !string.IsNullOrEmpty(p.LineUserId)) await ln.SendPushMessageAsync(p.LineUserId, $"退回重審：{note}\n{url}"); 
            }
            else if (act == "管理者完成核銷") 
            { 
                if (p != null && !string.IsNullOrEmpty(p.LineUserId)) await ln.SendPushMessageAsync(p.LineUserId, $"已結案：{o.Title}"); 
            }
        }
        catch { }
        
        if (act.Contains("主管審核通過") || act.Contains("管理者完成核銷")) 
        { 
            await InvokeAsync(() => _navigationManager.NavigateTo("/supervisor/dashboard", true)); 
            return; 
        }
        
        await OnInitializedAsync(); 
        await InvokeAsync(StateHasChanged);
    }

    private string GetStatusBadgeClass(string s) 
    { 
        return s switch { "待指派" => "bg-secondary", "處理中" => "bg-primary", "待主管審核" => "bg-warning text-dark", "待管理者核銷" => "bg-info text-dark", "已完成" => "bg-success", "已退回" => "bg-danger", _ => "bg-dark" }; 
    }

