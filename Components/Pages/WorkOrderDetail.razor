    private async Task HandleCompletionSubmitAsync()
    {
        if (workOrder is null) return;
        errorMessage = null;
        isUploading = true;
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var webHostEnvironment = scope.ServiceProvider.GetRequiredService<IWebHostEnvironment>();

            var orderToUpdate = await context.WorkOrders.FindAsync(workOrder.Id);
            if (orderToUpdate is null)
            {
                errorMessage = "找不到工單，無法回報。";
                isUploading = false;
                StateHasChanged();
                return;
            }

            var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
            var currentUser = await userManager.GetUserAsync(authState.User);

            await SaveNotesAndPhotosAsync(orderToUpdate, context, currentUser);

            var isFirstSubmission = orderToUpdate.Status == "處理中";
            orderToUpdate.ClientSignature = capturedSignatureData;
            orderToUpdate.Status = "待主管審核";
            orderToUpdate.UpdatedAt = DateTime.Now;

            if (isFirstSubmission)
            {
                orderToUpdate.CompletedAt = DateTime.Now;
            }

            var logAction = isFirstSubmission ? "工程師回報完成" : "工程師更新回報";
            context.WorkOrderLogs.Add(new WorkOrderLog
                {
                    WorkOrderId = orderToUpdate.Id,
                    OperatorId = currentUser?.Id,
                    Action = logAction,
                    Comment = workOrder.EngineerNotes
                });
            await context.SaveChangesAsync();

            await JSRuntime.InvokeVoidAsync("window.location.replace", "/mytasks");
        }
        catch (Exception ex)
        {
            errorMessage = $"回報完成時發生錯誤: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

