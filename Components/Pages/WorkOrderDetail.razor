    private bool IsVideoFile(string? path) 
    { 
        if (string.IsNullOrWhiteSpace(path)) return false; 
        return new[] { ".mp4", ".mov", ".avi", ".webm" }.Contains(Path.GetExtension(path).ToLower()); 
    }
    
    private bool IsImageFile(string? path) 
    { 
        if (string.IsNullOrWhiteSpace(path)) return false; 
        return new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp" }.Contains(Path.GetExtension(path).ToLower()); 
    }
