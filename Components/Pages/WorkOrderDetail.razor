    // (關鍵修改) 在 Modal 開啟時，嘗試讓瀏覽器進入全螢幕
    private async Task OpenSignatureModal()
    {
        if (signatureModule is not null && signaturePadComponent is not null)
        {
            // 1. 呼叫 JS 進入全螢幕 (隱藏瀏覽器 UI，目標是 document.documentElement)
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (document.documentElement.requestFullscreen) {
                    document.documentElement.requestFullscreen();
                }
            ");
            // 2. 顯示 Modal
            await signatureModule.InvokeVoidAsync("showModal", "signatureModal");
            await Task.Delay(300);
            // 3. 初始化簽名板
            await signaturePadComponent.InitializeAsync();
        }
    }

    private async Task ConfirmSignature(string? signatureData)
    {
        try
        {
            errorMessage = null;
            capturedSignatureData = signatureData;

            // 退出全螢幕
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            ");
            // 隱藏 Modal
            if (signatureModule is not null)
            {
                await signatureModule.InvokeVoidAsync("hideModal", "signatureModal");
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"儲存簽名時發生錯誤: {ex.Message}";
            StateHasChanged();
        }
    }

