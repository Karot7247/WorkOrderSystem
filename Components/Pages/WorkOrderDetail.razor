    private async Task SaveNotesAndPhotosAsync(WorkOrder orderToUpdate, ApplicationDbContext context, AppUser? currentUser)
    {
        orderToUpdate.EngineerNotes = workOrder.EngineerNotes;
        if (previewPhotos.Any())
        {
            var uploadsRoot = Configuration["FileStorageSettings:UploadsRootPath"];
            if (string.IsNullOrEmpty(uploadsRoot))
            {
                _logger.LogError("[SaveNotesAndPhotosAsync] FileStorageSettings:UploadsRootPath 未在 appsettings.json 中設定。");
                errorMessage = (errorMessage ?? "") + "\n嚴重錯誤：檔案儲存路徑(NAS)設定遺失，無法上傳照片。";
                return;
            }

            var customerFolderName = SanitizeFolderName(orderToUpdate.CustomerName);
            var titleFolderName = SanitizeFolderName(orderToUpdate.Title);
            var typeFolderName = SanitizeFolderName(orderToUpdate.WorkOrderType);
            var targetDirectory = Path.Combine(uploadsRoot, customerFolderName, titleFolderName, typeFolderName);
            Directory.CreateDirectory(targetDirectory);
            var photosToAdd = new List<WorkOrderPhoto>();

            foreach (var photo in previewPhotos)
            {
                var uniqueFileName = $"{Guid.NewGuid()}.jpg";
                var savePath = Path.Combine(targetDirectory, uniqueFileName);

                try
                {
                    byte[] photoBytes;
                    try
                    {
                        var base64Data = photo.Base64Data.Split(',')[1];
                        photoBytes = Convert.FromBase64String(base64Data);
                    }
                    catch (Exception ex)
                    {
                        _logger.LogError(ex, "Base64 轉換失敗 for photo {FileName}", photo.FileName);
                        continue;
                    }

                    await File.WriteAllBytesAsync(savePath, photoBytes);
                    var dbPath = $"/uploads/{customerFolderName}/{titleFolderName}/{typeFolderName}/{uniqueFileName}".Replace('\\', '/');

                    photosToAdd.Add(new WorkOrderPhoto
                        {
                            FilePath = dbPath,
                            WorkOrderId = orderToUpdate.Id,
                            Category = string.IsNullOrEmpty(photo.Category) ? "未分類" : photo.Category,
                            CustomNote = photo.CustomNote
                        });
                }
                catch (Exception ex)
                {
                    _logger.LogError(ex, "[SaveNotesAndPhotosAsync] 儲存施工照片 '{FileName}' 至 NAS 失敗", photo.FileName);
                    errorMessage = (errorMessage ?? "") + $"\n儲存照片 '{photo.FileName}' 失敗: {ex.Message}";
                }
            }

            if (photosToAdd.Any())
            {
                context.WorkOrderPhotos.AddRange(photosToAdd);
            }
            previewPhotos.Clear();
        }
    }

    private static string SanitizeFolderName(string folderName)
    {
        if (string.IsNullOrWhiteSpace(folderName))
            return "Uncategorized";
        var invalidChars = Path.GetInvalidFileNameChars().Concat(Path.GetInvalidPathChars()).ToArray();
        return string.Join("_", folderName.Split(invalidChars, StringSplitOptions.RemoveEmptyEntries)).Trim();
    }

    private async Task DeletePhotoAsync(int photoId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "確定要永久刪除這張照片嗎？");
        if (!confirmed) return;

        string? fullNasPath = null;
        using (var scope = ScopeFactory.CreateScope())
        {
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var photoToDelete = await context.WorkOrderPhotos.FindAsync(photoId);

            if (photoToDelete != null)
            {
                try
                {
                    var uploadsRoot = Configuration["FileStorageSettings:UploadsRootPath"];
                    if (string.IsNullOrEmpty(uploadsRoot))
                    {
                        _logger.LogError("[DeletePhoto] FileStorageSettings:UploadsRootPath 未設定。無法刪除檔案 {FilePath}", photoToDelete.FilePath);
                        errorMessage = "錯誤：無法確定檔案儲存路徑，刪除檔案失敗。";
                        StateHasChanged();
                        return;
                    }

                    var relativePath = photoToDelete.FilePath.TrimStart('/');
                    relativePath = relativePath.Replace('/', Path.DirectorySeparatorChar);
                    fullNasPath = Path.Combine(uploadsRoot, relativePath);

                    _logger.LogInformation("[DeletePhoto] Attempting to delete file at: {Path}", fullNasPath);
                    if (File.Exists(fullNasPath))
                    {
                        File.Delete(fullNasPath);
                        _logger.LogInformation("[DeletePhoto] Successfully deleted file: {Path}", fullNasPath);
                    }
                    else
                    {
                        _logger.LogWarning("[DeletePhoto] File not found at path: {Path}. Skipping file deletion.", fullNasPath);
                    }
                }
                catch (UnauthorizedAccessException uaEx)
                {
                    _logger.LogError(uaEx, "[DeletePhoto] 權限錯誤：無法刪除檔案 {FilePath} (位於 {FullPath})", photoToDelete.FilePath, fullNasPath);
                    errorMessage = $"權限錯誤：無法刪除照片檔案。請檢查應用程式對 NAS 的權限。";
                    StateHasChanged();
                    return;
                }
                catch (Exception ex)
                {
                    _logger.LogError(ex, "[DeletePhoto] 刪除實體檔案失敗 ({FilePath}, 位於 {FullPath})", photoToDelete.FilePath, fullNasPath);
                    errorMessage = $"刪除照片檔案時發生錯誤 (但資料庫記錄將被移除): {ex.Message}";
                }

                context.WorkOrderPhotos.Remove(photoToDelete);
                await context.SaveChangesAsync();

                orderedPhotos.RemoveAll(p => p.Id == photoId);
                StateHasChanged();
            }
            else
            {
                _logger.LogWarning("[DeletePhoto] Photo with ID {PhotoId} not found in database.", photoId);
            }
        }
    }

    private async Task ExportToPdfAsync()
    {
        if (pdfModule == null || workOrder == null) return;
        isGeneratingPdf = true;
        StateHasChanged();

        try
        {
            var fileName = $"{SanitizeFolderName(workOrder.CustomerName)}-{SanitizeFolderName(workOrder.Title)}-{workOrder.Id}.pdf";
            var pdfBase64 = await pdfModule.InvokeAsync<string>("generatePdfAsBase64", "workOrderSheet");

            if (!string.IsNullOrEmpty(pdfBase64))
            {
                await SavePdfToServerAsync(pdfBase64, fileName);
                var baseUri = new Uri(Configuration["ApplicationSettings:BaseUrl"] ?? _navigationManager.BaseUri);
                var publicUri = new Uri(baseUri, $"public/view/{workOrder.PublicAccessToken}");

                await JSRuntime.InvokeVoidAsync("window.open", publicUri.ToString(), "_blank");
            }
            else
            {
                errorMessage = "產生PDF失敗，回傳資料為空。";
            }
        }
        finally
        {
            isGeneratingPdf = false;
            StateHasChanged();
        }
    }

    private async Task SavePdfToServerAsync(string base64Pdf, string fileName)
    {
        try
        {
            var pdfBytes = Convert.FromBase64String(base64Pdf.Split(',')[1]);
            var pdfsFolder = Path.Combine(WebHostEnvironment.WebRootPath, "uploads", "pdfs");
            Directory.CreateDirectory(pdfsFolder);
            var savePath = Path.Combine(pdfsFolder, fileName);

            await File.WriteAllBytesAsync(savePath, pdfBytes);

            workOrder.GeneratedPdfPath = $"/uploads/pdfs/{fileName}";
            using var scope = ScopeFactory.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            context.WorkOrders.Attach(workOrder);
            context.Entry(workOrder).Property(x => x.GeneratedPdfPath).IsModified = true;
            await context.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"儲存PDF至伺服器失敗: {ex.Message}";
        }
    }

    private async Task GenerateQrCodeAsync()
    {
        if (workOrder is null) return;
        if (!workOrder.PublicAccessToken.HasValue)
        {
            workOrder.PublicAccessToken = Guid.NewGuid();
            using var scope = ScopeFactory.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            context.WorkOrders.Attach(workOrder);
            context.Entry(workOrder).Property(x => x.PublicAccessToken).IsModified = true;
            await context.SaveChangesAsync();
        }

        var baseUri = new Uri(Configuration["ApplicationSettings:BaseUrl"] ?? _navigationManager.BaseUri);
        var relativePath = $"public/view/{workOrder.PublicAccessToken}";
        var publicUri = new Uri(baseUri, relativePath);
        var publicUrl = publicUri.ToString();

        using var qrGenerator = new QRCodeGenerator();
        using var qrCodeData = qrGenerator.CreateQrCode(publicUrl, QRCodeGenerator.ECCLevel.Q);
        using var qrCode = new PngByteQRCode(qrCodeData);
        var qrCodeBytes = qrCode.GetGraphic(20);
        qrCodeAsBase64 = $"data:image/png;base64,{Convert.ToBase64String(qrCodeBytes)}";
    }

