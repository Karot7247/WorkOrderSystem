    // --- [NEW] 預建紀錄 (Draft) 相關變數 ---
    private List<FieldRecordDraft> myDrafts = new();
    private int selectedDraftId; // 綁定下拉選單的 ID
    private bool isImportingDraft = false;
    // 載入該工程師的預建紀錄
    private async Task LoadMyDraftsAsync()
    {
        try
        {
            var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
            var userPrincipal = authState.User;

            // 如果沒登入，就不用撈了
            if (!userPrincipal.Identity.IsAuthenticated) return;
            using var scope = ScopeFactory.CreateScope();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var currentUser = await userManager.GetUserAsync(userPrincipal);
            if (currentUser == null) return;

            // [關鍵邏輯] 只撈取 CreatorId == currentUser.Id 的資料
            // 並且只撈出尚未被刪除的 (這裡假設草稿匯入後暫不刪除，由你自己決定是否匯入後刪除)
            myDrafts = await context.FieldRecordDrafts
                .Include(d => d.Photos)
                .Where(d => d.CreatorId == currentUser.Id)
                .OrderByDescending(d => d.CreatedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "載入預建紀錄失敗");
        }
    }

    // 處理匯入動作
    private async Task ImportDraftAsync()
    {
        if (selectedDraftId == 0) return;
        isImportingDraft = true;
        errorMessage = null; // 清除之前的錯誤
        StateHasChanged();
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            // 1. 確保有 Include Photos，不然這裡會是空的
            var draft = await context.FieldRecordDrafts
                .Include(d => d.Photos)
                .FirstOrDefaultAsync(d => d.Id == selectedDraftId);
            if (draft == null)
            {
                errorMessage = "找不到選取的暫存紀錄。";
                return;
            }

            // --- 匯入文字邏輯 ---
            if (!string.IsNullOrWhiteSpace(draft.EngineerNotes))
            {
                if (string.IsNullOrWhiteSpace(workOrder.EngineerNotes))
                    workOrder.EngineerNotes = draft.EngineerNotes;
                else
                    workOrder.EngineerNotes += $"\n\n【匯入紀錄 {DateTime.Now:MM/dd}】：\n{draft.EngineerNotes}";
            }

            // --- 匯入照片邏輯 (關鍵修正) ---
            if (draft.Photos != null && draft.Photos.Any())
            {
                var uploadsRoot = Configuration["FileStorageSettings:UploadsRootPath"];
                int successCount = 0;

                foreach (var draftPhoto in draft.Photos)
                {
                    try
                    {
                        // [關鍵修正]：移除路徑開頭的 "/uploads" 或 "uploads"，避免重複疊加
                        // 原始 DB 路徑可能長這樣: "/uploads/drafts/user/date/xxx.jpg"
                        string relativePath = draftPhoto.FilePath.Replace("/uploads", "", StringComparison.OrdinalIgnoreCase);
                        relativePath = relativePath.TrimStart('/', '\\');

                        // 修正後的 relativePath 應該是: "drafts/user/date/xxx.jpg"
                        // 組合完整路徑
                        string fullPath = Path.Combine(uploadsRoot, relativePath);
                        if (File.Exists(fullPath))
                        {
                            byte[] imageBytes = await File.ReadAllBytesAsync(fullPath);
                            string base64String = $"data:image/jpeg;base64,{Convert.ToBase64String(imageBytes)}";

                            previewPhotos.Add(new PreviewPhoto
                                {
                                    FileName = Path.GetFileName(draftPhoto.FilePath),
                                    Base64Data = base64String,
                                    Category = draftPhoto.Category,
                                    CustomNote = draftPhoto.CustomNote
                                });
                            successCount++;
                        }
                        else
                        {
                            // 如果找不到檔案，記錄下來方便除錯 (F12 Console 可見)
                            Console.WriteLine($"[匯入失敗] 找不到實體檔案: {fullPath}");
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[匯入例外] {ex.Message}");
                    }
                }
                draft.ImportedWorkOrderId = workOrder.Id;
                if (successCount > 0)
                {
                    // 提示成功，這裡不使用 alert 干擾，改用狀態文字顯示
                    quotationSaveMessage = $"已匯入 {successCount} 張照片。";
                    quotationSaveSuccess = true;
                }
                // 儲存變更 (這行會同時儲存工單的更新與暫存檔的狀態更新)
                await context.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"匯入發生錯誤: {ex.Message}";
            _logger.LogError(ex, "ImportDraftAsync error");
        }
        finally
        {
            isImportingDraft = false;
            selectedDraftId = 0; // 重置選單
            StateHasChanged();
        }
    }

