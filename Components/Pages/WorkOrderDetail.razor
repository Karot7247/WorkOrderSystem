    private async Task SaveNotesAndPhotosAsync(WorkOrder o, ApplicationDbContext ctx, AppUser u)
    {
        o.EngineerNotes = workOrder.EngineerNotes;
        if (previewPhotos.Any())
        {
            var root = Configuration["FileStorageSettings:UploadsRootPath"];
            var cFolder = SanitizeFolderName(o.CustomerName); 
            var tFolder = SanitizeFolderName(o.Title); 
            var tyFolder = SanitizeFolderName(o.WorkOrderType);
            var dir = Path.Combine(root, cFolder, tFolder, tyFolder); 
            Directory.CreateDirectory(dir);
            var toAdd = new List<WorkOrderPhoto>();
            
            foreach (var p in previewPhotos)
            {
                var n = $"{Guid.NewGuid()}.jpg"; 
                var path = Path.Combine(dir, n);
                try 
                { 
                    await File.WriteAllBytesAsync(path, Convert.FromBase64String(p.Base64Data.Split(',')[1])); 
                    toAdd.Add(new WorkOrderPhoto { FilePath = $"/uploads/{cFolder}/{tFolder}/{tyFolder}/{n}".Replace('\\', '/'), WorkOrderId = o.Id, Category = string.IsNullOrEmpty(p.Category) ? "未分類" : p.Category, CustomNote = p.CustomNote }); 
                } 
                catch { }
            }
            if (toAdd.Any()) 
            {
                ctx.WorkOrderPhotos.AddRange(toAdd); 
            }
            previewPhotos.Clear();
        }
    }

    private static string SanitizeFolderName(string n) 
    { 
        if (string.IsNullOrWhiteSpace(n)) return "Uncategorized"; 
        return string.Join("_", n.Split(Path.GetInvalidFileNameChars().Concat(Path.GetInvalidPathChars()).ToArray(), StringSplitOptions.RemoveEmptyEntries)).Trim(); 
    }

    private async Task DeletePhotoAsync(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "確定要永久刪除這張照片嗎？");
        if (!confirmed) return;
        
        using var scope = ScopeFactory.CreateScope(); 
        var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
        var p = await context.WorkOrderPhotos.FindAsync(id);
        
        if (p != null)
        {
            try 
            { 
                var root = Configuration["FileStorageSettings:UploadsRootPath"]; 
                var path = Path.Combine(root, p.FilePath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar)); 
                if (File.Exists(path)) File.Delete(path); 
            } 
            catch { }
            
            context.WorkOrderPhotos.Remove(p); 
            await context.SaveChangesAsync();
            
            orderedPhotos.RemoveAll(x => x.Id == id); 
            requestPhotos.RemoveAll(x => x.Id == id); 
            processPhotos.RemoveAll(x => x.Id == id); 
            completionPhotos.RemoveAll(x => x.Id == id); 
            logDisplayPhotos.RemoveAll(x => x.Id == id);
            
            StateHasChanged();
        }
    }

    private async Task ExportToPdfAsync()
    {
        if (pdfModule == null || workOrder == null) return;
        isGeneratingPdf = true; 
        StateHasChanged();
        
        try
        {
            await Task.Delay(100); 
            var fn = $"{SanitizeFolderName(workOrder.CustomerName)}-{SanitizeFolderName(workOrder.Title)}-{workOrder.Id}.pdf";
            var b64 = await pdfModule.InvokeAsync<string>("generatePdfAsBase64", "workOrderSheet");
            
            if (!string.IsNullOrEmpty(b64))
            {
                var pdfBytes = Convert.FromBase64String(b64.Split(',')[1]);
                var dir = Path.Combine(WebHostEnvironment.WebRootPath, "uploads", "pdfs"); 
                Directory.CreateDirectory(dir);
                await File.WriteAllBytesAsync(Path.Combine(dir, fn), pdfBytes);
                workOrder.GeneratedPdfPath = $"/uploads/pdfs/{fn}";
                
                using var scope = ScopeFactory.CreateScope(); 
                var ctx = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
                ctx.WorkOrders.Attach(workOrder); 
                ctx.Entry(workOrder).Property(x => x.GeneratedPdfPath).IsModified = true; 
                await ctx.SaveChangesAsync();
                
                await JSRuntime.InvokeVoidAsync("window.open", new Uri(new Uri(Configuration["ApplicationSettings:BaseUrl"] ?? _navigationManager.BaseUri), $"public/view/{workOrder.PublicAccessToken}").ToString(), "_blank");
            }
        }
        finally 
        { 
            isGeneratingPdf = false; 
            StateHasChanged(); 
        }
    }

    private async Task GenerateQrCodeAsync()
    {
        if (workOrder is null) return;
        if (!workOrder.PublicAccessToken.HasValue) 
        { 
            workOrder.PublicAccessToken = Guid.NewGuid(); 
            using var s = ScopeFactory.CreateScope(); 
            var c = s.ServiceProvider.GetRequiredService<ApplicationDbContext>(); 
            c.WorkOrders.Attach(workOrder); 
            c.Entry(workOrder).Property(x => x.PublicAccessToken).IsModified = true; 
            await c.SaveChangesAsync(); 
        }
        var url = new Uri(new Uri(Configuration["ApplicationSettings:BaseUrl"] ?? _navigationManager.BaseUri), $"public/view/{workOrder.PublicAccessToken}").ToString();
        using var gen = new QRCodeGenerator(); 
        using var data = gen.CreateQrCode(url, QRCodeGenerator.ECCLevel.Q); 
        using var qr = new PngByteQRCode(data);
        qrCodeAsBase64 = $"data:image/png;base64,{Convert.ToBase64String(qr.GetGraphic(20))}";
    }

