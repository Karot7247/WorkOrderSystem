    private async Task OpenScheduleModal()
    {
        if (workOrder == null) return;
        scheduleFormModel.StartDate = workOrder.ScheduledStartDate ?? DateTime.Today; 
        scheduleFormModel.EndDate = workOrder.ScheduledEndDate ?? DateTime.Today;
        scheduleErrorMessage = null; 
        conflictingOrders = null; 
        isLoadingConflicts = true;
        if (signatureModule != null) 
        {
            await signatureModule.InvokeVoidAsync("showModal", "scheduleModal");
        }
        await CheckConflictsAsync();
    }

    private async Task CheckConflictsAsync()
    {
        if (workOrder == null) return;
        isLoadingConflicts = true; 
        scheduleErrorMessage = null; 
        conflictingOrders = null; 
        await InvokeAsync(StateHasChanged);
        
        try
        {
            var start = scheduleFormModel.StartDate.Date; 
            var end = scheduleFormModel.EndDate.Date;
            if (end < start) 
            { 
                scheduleErrorMessage = "結束日期不能早於開始日期。"; 
                return; 
            }
            using var scope = ScopeFactory.CreateScope(); 
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            conflictingOrders = await context.WorkOrders
                .Include(wo => wo.Assignments)
                .ThenInclude(a => a.User)
                .Where(wo => wo.Id != workOrder.Id && wo.ScheduledStartDate.HasValue && wo.ScheduledEndDate.HasValue && wo.ScheduledStartDate.Value.Date <= end && wo.ScheduledEndDate.Value.Date >= start)
                .OrderBy(wo => wo.ScheduledStartDate)
                .ToListAsync();
        }
        catch (Exception ex) 
        { 
            scheduleErrorMessage = "檢查衝突失敗：" + ex.Message; 
        }
        finally 
        { 
            isLoadingConflicts = false; 
            await InvokeAsync(StateHasChanged); 
        }
    }

    private async Task SaveScheduleAsync()
    {
        isSavingSchedule = true; 
        await InvokeAsync(StateHasChanged);
        try
        {
            var start = scheduleFormModel.StartDate.Date; 
            var end = scheduleFormModel.EndDate.Date;
            if (end < start) 
            { 
                scheduleErrorMessage = "結束日期必須晚於開始日期。"; 
                return; 
            }
            using var scope = ScopeFactory.CreateScope(); 
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>(); 
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();
            var currentUser = await userManager.GetUserAsync((await _authenticationStateProvider.GetAuthenticationStateAsync()).User);
            var order = await context.WorkOrders.FindAsync(WorkOrderId);
            if (order == null) return;
            
            order.ScheduledStartDate = start; 
            order.ScheduledEndDate = end; 
            order.UpdatedAt = DateTime.Now;
            context.WorkOrderLogs.Add(new WorkOrderLog { WorkOrderId = order.Id, OperatorId = currentUser?.Id, Action = "更新施工排程", Comment = $"排程設定：{start:yyyy-MM-dd} 至 {end:yyyy-MM-dd}" });
            await context.SaveChangesAsync(); 
            workOrder.ScheduledStartDate = start; 
            workOrder.ScheduledEndDate = end;
            
            if (signatureModule != null) 
            {
                await signatureModule.InvokeVoidAsync("hideModal", "scheduleModal");
            }
        }
        catch (Exception ex) 
        { 
            scheduleErrorMessage = $"儲存失敗：{ex.Message}"; 
        }
        finally 
        { 
            isSavingSchedule = false; 
            await OnInitializedAsync(); 
            await InvokeAsync(StateHasChanged); 
        }
    }

