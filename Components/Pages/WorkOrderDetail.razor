    private async Task OpenScheduleModal()
    {
        if (workOrder == null) return;

        scheduleFormModel.StartDate = workOrder.ScheduledStartDate ?? DateTime.Today;
        scheduleFormModel.EndDate = workOrder.ScheduledEndDate ?? DateTime.Today;

        _lastCheckedStartDate = scheduleFormModel.StartDate;
        _lastCheckedEndDate = scheduleFormModel.EndDate;

        scheduleErrorMessage = null;
        conflictingOrders = null;
        isLoadingConflicts = true;

        if (signatureModule != null)
        {
            await signatureModule.InvokeVoidAsync("showModal", "scheduleModal");
        }

        await CheckConflictsAsync();
    }

    private async Task CheckConflictsAsync()
    {
        if (workOrder == null) return;
        isLoadingConflicts = true;
        scheduleErrorMessage = null;
        conflictingOrders = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var startDate = scheduleFormModel.StartDate.Date;
            var endDate = scheduleFormModel.EndDate.Date;

            if (endDate < startDate)
            {
                scheduleErrorMessage = "結束日期不能早於開始日期。";
                isLoadingConflicts = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            using var scope = ScopeFactory.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            conflictingOrders = await context.WorkOrders
                .Include(wo => wo.Assignments)
                .ThenInclude(a => a.User)
                .Where(wo =>
                    wo.Id != workOrder.Id &&
                    wo.ScheduledStartDate.HasValue &&
                    wo.ScheduledEndDate.HasValue &&
                    wo.ScheduledStartDate.Value.Date <= endDate &&
                    wo.ScheduledEndDate.Value.Date >= startDate
                )
                .OrderBy(wo => wo.ScheduledStartDate)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "檢查衝突時發生錯誤");
            scheduleErrorMessage = "檢查衝突時發生錯誤：" + ex.Message;
        }
        finally
        {
            isLoadingConflicts = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveScheduleAsync()
    {
        scheduleErrorMessage = null;
        isSavingSchedule = true;
        await InvokeAsync(StateHasChanged);

        DateTime startDate = scheduleFormModel.StartDate.Date;
        DateTime endDate = scheduleFormModel.EndDate.Date;
        if (endDate < startDate)
        {
            scheduleErrorMessage = "結束日期必須晚於或等於開始日期。";
            isSavingSchedule = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<AppUser>>();

            var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
            var currentUser = await userManager.GetUserAsync(authState.User);
            var orderToUpdate = await context.WorkOrders.FindAsync(WorkOrderId);
            if (orderToUpdate == null)
            {
                scheduleErrorMessage = "找不到工單，無法儲存。";
                return;
            }

            orderToUpdate.ScheduledStartDate = startDate;
            orderToUpdate.ScheduledEndDate = endDate;
            orderToUpdate.UpdatedAt = DateTime.Now;

            context.WorkOrderLogs.Add(new WorkOrderLog
                {
                    WorkOrderId = orderToUpdate.Id,
                    OperatorId = currentUser?.Id,
                    Action = "更新施工排程",
                    Comment = $"排程設定為：{orderToUpdate.ScheduledStartDate.Value:yyyy-MM-dd} 至 {orderToUpdate.ScheduledEndDate.Value:yyyy-MM-dd}"
                });
            await context.SaveChangesAsync();

            workOrder.ScheduledStartDate = startDate;
            workOrder.ScheduledEndDate = endDate;

            if (signatureModule != null)
            {
                await signatureModule.InvokeVoidAsync("hideModal", "scheduleModal");
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "儲存施工排程時發生錯誤");
            scheduleErrorMessage = $"儲存失敗：{ex.Message}";
        }
        finally
        {
            isSavingSchedule = false;
            await OnInitializedAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

