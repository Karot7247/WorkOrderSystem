    private bool IsAnyActionAvailable()
    {
        if (workOrder is null) return false;
        bool managerAction = isManager && (workOrder.Status == "待指派" || workOrder.Status == "已退回" || workOrder.Status == "處理中" || workOrder.Status == "待管理者核銷");
        bool engineerAction = isPartOfAssignmentTeam && (workOrder.Status == "處理中" || workOrder.Status == "待主管審核");
        bool supervisorAction = isSupervisor && workOrder.Status == "待主管審核";
        return managerAction || engineerAction || supervisorAction;
    }

