                order.CompletedAt = DateTime.Now;
            }
            context.WorkOrderLogs.Add(new WorkOrderLog { WorkOrderId = order.Id, OperatorId = user?.Id, Action = isFirst ? "工程師回報完成" : "更新回報", Comment = workOrder.EngineerNotes });
            await context.SaveChangesAsync(); 
            await JSRuntime.InvokeVoidAsync("window.location.replace", "/mytasks");
        }
        catch (Exception ex) 
        { 
            errorMessage = ex.Message; 
        } 
        finally 
        { 
            isUploading = false; 
            StateHasChanged(); 
        }
    }

    private async Task SaveChangesAsync()
    {
        if (workOrder is null) return; 
        errorMessage = null; 
        isUploading = true; 
        StateHasChanged();
        try
        {
            using var scope = ScopeFactory.CreateScope(); 
            var context = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>(); 
